{
 "cases": [
  {"name": "any is the empty schema", "env": "{x: any}", "source": "x", "expect": {"schema": {}}},
  {"name": "never is false", "env": "{x: never}", "source": "x", "expect": {"schema": false}},
  {"name": "null", "env": "{x: null}", "source": "x", "expect": {"schema": {"type": "null"}}},
  {"name": "bool", "env": "{x: bool}", "source": "x", "expect": {"schema": {"type": "boolean"}}},
  {"name": "int is integer, with no bounds", "env": "{x: int}", "source": "x", "expect": {"schema": {"type": "integer"}}},
  {"name": "float is number", "env": "{x: float}", "source": "x", "expect": {"schema": {"type": "number"}}},
  {"name": "string", "env": "{x: string}", "source": "x", "expect": {"schema": {"type": "string"}}},
  {"name": "a literal set of one string is const", "env": "{x: \"on\"}", "source": "x", "expect": {"schema": {"const": "on", "type": "string"}}},
  {"name": "a literal set of several strings is enum, in code point order", "env": "{x: \"off\" | \"on\" | \"Auto\"}", "source": "x", "expect": {"schema": {"enum": ["Auto", "off", "on"], "type": "string"}}},
  {"name": "a literal with escapes keeps its value", "env": "{x: \"a\\\"b\"}", "source": "x", "expect": {"schema": {"const": "a\"b", "type": "string"}}},
  {"name": "a list", "env": "{x: int[]}", "source": "x", "expect": {"schema": {"type": "array", "items": {"type": "integer"}}}},
  {"name": "the empty list's type has items false", "source": "[]", "expect": {"schema": {"type": "array", "items": false}}},
  {"name": "a list of any has items {}", "env": "{x: any[]}", "source": "x", "expect": {"schema": {"type": "array", "items": {}}}},
  {"name": "a list of lists", "env": "{x: string[][]}", "source": "x", "expect": {"schema": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}}},
  {"name": "an exact record", "env": "{x: {id: int, note?: string}}", "source": "x", "expect": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}}, "required": ["id"], "additionalProperties": false}}},
  {"name": "an open record has no additionalProperties", "env": "{x: {id: int, ...}}", "source": "x", "expect": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}}, "required": ["id"]}}},
  {"name": "a typed rest is additionalProperties", "env": "{x: {id: int, ...string}}", "source": "x", "expect": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}}, "required": ["id"], "additionalProperties": {"type": "string"}}}},
  {"name": "a record with no required field has no required", "env": "{x: {a?: int, b?: bool}}", "source": "x", "expect": {"schema": {"type": "object", "properties": {"a": {"type": "integer"}, "b": {"type": "boolean"}}, "additionalProperties": false}}},
  {"name": "map<int>", "env": "{x: map<int>}", "source": "x", "expect": {"schema": {"type": "object", "additionalProperties": {"type": "integer"}}}},
  {"name": "map<any> is an object", "env": "{x: map<any>}", "source": "x", "expect": {"schema": {"type": "object"}}},
  {"name": "the empty record", "env": "{x: {}}", "source": "x", "expect": {"schema": {"type": "object", "additionalProperties": false}}},
  {"name": "a field of type never is false", "env": "{x: {a?: never, b: int}}", "source": "x", "expect": {"schema": {"type": "object", "properties": {"a": false, "b": {"type": "integer"}}, "required": ["b"], "additionalProperties": false}}},
  {"name": "a key that is not a word", "env": "{x: {\"first name\": string}}", "source": "x", "expect": {"schema": {"type": "object", "properties": {"first name": {"type": "string"}}, "required": ["first name"], "additionalProperties": false}}},
  {"name": "a nested record", "env": "{x: {user: {name: string, tags: string[]}}}", "source": "x", "expect": {"schema": {"type": "object", "properties": {"user": {"type": "object", "properties": {"name": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["name", "tags"], "additionalProperties": false}}, "required": ["user"], "additionalProperties": false}}},
  {"name": "alternatives are anyOf, null last", "env": "{x: int | string | null}", "source": "x", "expect": {"schema": {"anyOf": [{"type": "integer"}, {"type": "string"}, {"type": "null"}]}}},
  {"name": "alternatives in the order of printing", "env": "{x: {a: int} | null | int[] | bool | float | \"k\"}", "source": "x", "expect": {"schema": {"anyOf": [{"type": "boolean"}, {"type": "number"}, {"const": "k", "type": "string"}, {"type": "array", "items": {"type": "integer"}}, {"type": "object", "properties": {"a": {"type": "integer"}}, "required": ["a"], "additionalProperties": false}, {"type": "null"}]}}},
  {"name": "a literal set that may be null", "env": "{x: \"a\" | \"b\" | null}", "source": "x", "expect": {"schema": {"anyOf": [{"enum": ["a", "b"], "type": "string"}, {"type": "null"}]}}},
  {"name": "a tagged union gives one schema for each variant", "env": "{x: {kind: \"rect\", w: float, h: float} | {kind: \"circle\", r: float}}", "source": "x", "expect": {"schema": {"anyOf": [{"type": "object", "properties": {"kind": {"const": "circle", "type": "string"}, "r": {"type": "number"}}, "required": ["kind", "r"], "additionalProperties": false}, {"type": "object", "properties": {"h": {"type": "number"}, "kind": {"const": "rect", "type": "string"}, "w": {"type": "number"}}, "required": ["h", "kind", "w"], "additionalProperties": false}]}}},
  {"name": "a tagged union beside other alternatives", "env": "{x: {kind: \"a\", n: int} | {kind: \"b\" | \"c\"} | string | null}", "source": "x", "expect": {"schema": {"anyOf": [{"type": "string"}, {"type": "object", "properties": {"kind": {"const": "a", "type": "string"}, "n": {"type": "integer"}}, "required": ["kind", "n"], "additionalProperties": false}, {"type": "object", "properties": {"kind": {"enum": ["b", "c"], "type": "string"}}, "required": ["kind"], "additionalProperties": false}, {"type": "null"}]}}},
  {"name": "the type of a map literal", "source": "{id: 1, name: \"ana\", ok: true}", "expect": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "name": {"const": "ana", "type": "string"}, "ok": {"type": "boolean"}}, "required": ["id", "name", "ok"], "additionalProperties": false}}},
  {"name": "the type of an annotated const line", "source": "type Line = {sku: string, qty: int}; const l: Line[] = []; l", "expect": {"schema": {"type": "array", "items": {"type": "object", "properties": {"qty": {"type": "integer"}, "sku": {"type": "string"}}, "required": ["qty", "sku"], "additionalProperties": false}}}},
  {"name": "an opaque type has no schema", "env": "{x: Token}", "source": "x", "opaque": ["Token"], "expect": {"schema": null}},
  {"name": "an opaque type at any depth has no schema", "env": "{x: {t: Token[] | null}}", "source": "x", "opaque": ["Token"], "expect": {"schema": null}},
  {"name": "a recursive type is written once under $defs, the root a $ref", "source": "type Tree = {name: string, kids: Tree[]}; const t: Tree = {name: \"a\", kids: []}; t", "expect": {"schema": {"$defs": {"Tree": {"type": "object", "properties": {"kids": {"type": "array", "items": {"$ref": "#/$defs/Tree"}}, "name": {"type": "string"}}, "required": ["kids", "name"], "additionalProperties": false}}, "$ref": "#/$defs/Tree"}}},
  {"name": "a recursive type inside a record", "source": "type Tree = {name: string, kids: Tree[]}; const t: {root: Tree | null} = {root: null}; t", "expect": {"schema": {"$defs": {"Tree": {"type": "object", "properties": {"kids": {"type": "array", "items": {"$ref": "#/$defs/Tree"}}, "name": {"type": "string"}}, "required": ["kids", "name"], "additionalProperties": false}}, "additionalProperties": false, "properties": {"root": {"anyOf": [{"$ref": "#/$defs/Tree"}, {"type": "null"}]}}, "required": ["root"], "type": "object"}}},
  {"name": "two recursive types that name each other", "source": "type Dir = {files: File[], dirs: Dir[]}; type File = {name: string, parent: Dir | null}; const d: Dir = {files: [], dirs: []}; d", "expect": {"schema": {"$defs": {"Dir": {"type": "object", "properties": {"dirs": {"type": "array", "items": {"$ref": "#/$defs/Dir"}}, "files": {"type": "array", "items": {"$ref": "#/$defs/File"}}}, "required": ["dirs", "files"], "additionalProperties": false}, "File": {"type": "object", "properties": {"name": {"type": "string"}, "parent": {"anyOf": [{"$ref": "#/$defs/Dir"}, {"type": "null"}]}}, "required": ["name", "parent"], "additionalProperties": false}}, "$ref": "#/$defs/Dir"}}},
  {"name": "JSON as a recursive type", "source": "type Json = null | bool | float | string | Json[] | map<Json>; const j: Json = null; j", "expect": {"schema": {"$defs": {"Json": {"anyOf": [{"type": "boolean"}, {"type": "number"}, {"type": "string"}, {"type": "array", "items": {"$ref": "#/$defs/Json"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/Json"}}, {"type": "null"}]}}, "$ref": "#/$defs/Json"}}},
  {"name": "a recursive named type of the environment", "env": "{x: {head: Node | null}}", "source": "x", "types": [{"name": "Node", "type": "{v: int, next: Node | null}"}], "expect": {"schema": {"$defs": {"Node": {"type": "object", "properties": {"next": {"anyOf": [{"$ref": "#/$defs/Node"}, {"type": "null"}]}, "v": {"type": "integer"}}, "required": ["next", "v"], "additionalProperties": false}}, "additionalProperties": false, "properties": {"head": {"anyOf": [{"$ref": "#/$defs/Node"}, {"type": "null"}]}}, "required": ["head"], "type": "object"}}},
  {"name": "a named type that is not recursive is written out", "env": "{x: Point[]}", "source": "x", "types": [{"name": "Point", "type": "{x: float, y: float}"}], "expect": {"schema": {"type": "array", "items": {"type": "object", "properties": {"x": {"type": "number"}, "y": {"type": "number"}}, "required": ["x", "y"], "additionalProperties": false}}}},
  {"name": "a key named $defs is a field", "source": "{\"$defs\": 1}", "expect": {"schema": {"additionalProperties": false, "properties": {"$defs": {"type": "integer"}}, "required": ["$defs"], "type": "object"}}},
  {"name": "a recursive type the mapping writes out changes the order of an anyOf", "source": "type Aa = {next: Zz}; type Zz = Aa[]; const v: {first: Aa, second: Aa | Zz} = {first: {next: []}, second: []}; v", "expect": {"schema": {"$defs":{"Aa":{"additionalProperties":false,"properties":{"next":{"$ref":"#/$defs/Zz"}},"required":["next"],"type":"object"},"Zz":{"items":{"$ref":"#/$defs/Aa"},"type":"array"}},"additionalProperties":false,"properties":{"first":{"$ref":"#/$defs/Aa"},"second":{"anyOf":[{"$ref":"#/$defs/Aa"},{"$ref":"#/$defs/Zz"}]}},"required":["first","second"],"type":"object"}}}
 ]
}
