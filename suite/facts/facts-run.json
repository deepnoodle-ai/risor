{
 "env": "{report: {verdict: string} | null, approve: {verdict: string} | null, xs: int[]}",
 "facts": [
  {
   "someNotNull": [
    "report",
    "approve"
   ]
  }
 ],
 "cases": [
  {
   "name": "the chain when the first member is null",
   "source": "(report ?? approve).verdict",
   "vars": {
