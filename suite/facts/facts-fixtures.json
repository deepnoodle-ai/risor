[
 {
  "name": "every member null is invalid, at the host fact",
  "runner": {
   "env": "{report: {verdict: string} | null, approve: {verdict: string} | null}",
   "facts": [
    {
     "someNotNull": [
      "report",
      "approve"
     ]
    }
   ],
   "cases": [
    {
     "name": "c",
     "source": "(report ?? approve).verdict",
     "vars": {
      "report": null,
      "approve": null
     },
     "expect": {
      "value": "x"
     }
    }
   ]
  },
  "expect": {
   "verdicts": [
    {
     "name": "c",
     "status": "invalid",
     "fixture": [
      "facts",
      0
     ],
     "message": "at least one of report, approve must not be null"
    }
   ]
  }
 },
 {
  "name": "one member not null passes",
  "runner": {
   "env": "{report: {verdict: string} | null, approve: {verdict: string} | null}",
   "facts": [
    {
     "someNotNull": [
      "report",
      "approve"
     ]
    }
   ],
   "cases": [
    {
     "name": "c",
     "source": "(report ?? approve).verdict",
     "vars": {
      "report": null,
      "approve": {
       "verdict": "ok"
      }
     },
     "expect": {
      "value": "ok"
     }
    }
   ]
  },
  "expect": {
   "verdicts": [
    {
     "name": "c",
     "status": "pass"
    }
   ]
  }
 },
 {
  "name": "precondition false: not tested, and the run fails with class environment",
  "runner": {
   "env": "{report: {verdict: string} | null, approve: {verdict: string} | null}",
   "facts": [
    {
     "someNotNull": [
      "report",
      "approve"
     ]
    }
   ],
   "cases": [
    {
     "name": "c",
     "source": "(report ?? approve).verdict",
     "vars": {
      "report": null,
      "approve": null
     },
     "precondition": false,
     "expect": {
      "phase": "run",
      "diagnostics": [
       {
        "code": "null-operand",
        "class": "environment"
       }
      ]
     }
    }
   ]
  },
  "expect": {
   "verdicts": [
    {
     "name": "c",
     "status": "pass"
    }
   ]
  }
 },
 {
  "name": "a member not supplied: the host fact is not tested",
