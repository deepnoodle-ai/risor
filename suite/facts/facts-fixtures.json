     "vars": {
      "approve": null
     },
     "expect": {
      "value": null
     }
    }
   ]
  },
  "expect": {
   "verdicts": [
    {
     "name": "c",
     "status": "pass"
    }
   ]
  }
 },
 {
  "name": "the second host fact fails",
  "runner": {
   "env": "{report: {verdict: string} | null, approve: {verdict: string} | null, n: int | null}",
   "facts": [
    {
     "someNotNull": [
      "report",
      "approve"
     ]
    },
    {
     "someNotNull": [
      "n"
     ]
    }
   ],
   "cases": [
    {
     "name": "c",
     "source": "1",
     "vars": {
      "report": {
       "verdict": "ok"
      },
      "approve": null,
      "n": null
     },
     "expect": {
      "value": 1
     }
    }
   ]
  },
  "expect": {
   "verdicts": [
    {
     "name": "c",
     "status": "invalid",
     "fixture": [
      "facts",
      1
     ],
     "message": "at least one of n must not be null"
    }
   ]
  }
 },
 {
  "name": "the members are named in the order the case lists them",
