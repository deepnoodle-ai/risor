   "env": "{report: {verdict: string} | null, approve: {verdict: string} | null}",
   "facts": [
    {
     "someNotNull": [
      "report",
      "approve"
     ]
    }
   ],
   "cases": [
    {
     "name": "c",
     "source": "1",
     "vars": {
      "report": 5,
      "approve": null
