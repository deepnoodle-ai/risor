     ]
    }
   ]
  }
 },
 {
  "name": "a case that never runs is not tested",
  "runner": {
   "env": "{report: {verdict: string} | null, approve: {verdict: string} | null}",
   "facts": [
    {
     "someNotNull": [
      "report",
      "approve"
     ]
    }
   ],
   "cases": [
