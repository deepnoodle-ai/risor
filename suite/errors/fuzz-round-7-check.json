[
  {
    "name": "R7-9: a never subject reports nothing, and arity in the else branch stands",
    "source": "const m = a; m is int[] ? 0 : {\"a-b\": []}?.[\"a-b\"].filter()",
    "expect": {
      "phase": "check",
      "diagnostics": [
        {
          "code": "undefined-name",
          "span": [
            1,
            11,
            1,
            12
          ],
          "message": "a is not defined"
        },
        {
          "code": "arity",
          "span": [
            1,
            31,
            1,
            60
          ],
          "message": "the argument count of filter must be 1, found 0"
        }
      ]
    }
  },
  {
    "name": "R7-9: the same with a plain receiver",
    "source": "const m = a; m is int ? 0 : [].filter()",
    "expect": {
      "phase": "check",
      "diagnostics": [
        {
          "code": "undefined-name",
          "span": [
            1,
            11,
            1,
            12
          ],
          "message": "a is not defined"
        },
        {
          "code": "arity",
          "span": [
            1,
            29,
            1,
            40
          ],
          "message": "the argument count of filter must be 1, found 0"
        }
      ]
    }
  },
  {
    "name": "spread giving an unlisted key at an argument uses the extra template",
    "source": "f({...q, a: 1})",
    "functions": {"f": "(c: {a: int}) => int"},
    "env": "{q: {key: string}}",
    "expect": {
      "phase": "check",
      "diagnostics": [
        {
          "code": "arg-mismatch",
          "span": [1, 7, 1, 8],
          "message": "{a: int} does not allow key \"key\""
        }
      ]
    }
  },
  {
    "name": "spread giving a wrong field type reports the field types",
    "source": "{...base, ...bad}",
    "env": "{base: {listen: string}, bad: {listen: int}}",
    "returns": "{listen: string}",
    "expect": {
      "phase": "check",
      "diagnostics": [
        {
          "code": "result-mismatch",
          "span": [1, 14, 1, 17],
          "message": "expected string, found int"
        }
      ]
    }
  },
  {
    "name": "tagged union map literal with bad tag reports the tag literal set",
    "source": "{kind: \"oval\", r: 1}",
    "types": [{"name": "Shape", "type": "{kind: \"circle\", r: float} | {kind: \"rect\", w: float, h: float}"}],
    "returns": "Shape",
    "expect": {
      "phase": "check",
      "diagnostics": [
        {
          "code": "result-mismatch",
          "span": [1, 8, 1, 14],
          "message": "expected \"circle\" | \"rect\", found \"oval\""
        }
      ]
    }
  },
  {
    "name": "reserved word before => at top level uses the operand template",
    "source": "is => 1",
    "expect": {
      "phase": "parse",
      "diagnostics": [
        {
          "code": "reserved-word",
          "span": [1, 1, 1, 3],
          "message": "is is a reserved word and cannot stand here"
        }
      ]
    }
  },
  {
    "name": "return before => in a list element reports return-statement",
    "source": "[return => 1]",
    "expect": {
      "phase": "parse",
      "diagnostics": [
        {
          "code": "return-statement",
          "span": [1, 2, 1, 8],
          "message": "there is no return: the value of a block is its last expression"
        }
      ]
    }
  },
  {
    "name": "return before => at top level reports return-statement",
    "source": "return => 1",
    "expect": {
      "phase": "parse",
      "diagnostics": [
        {
          "code": "return-statement",
          "span": [1, 1, 1, 7],
          "message": "there is no return: the value of a block is its last expression"
        }
      ]
    }
  },
  {
    "name": "reserved word before => in an argument stays reserved-word name",
    "source": "[1].map(do => 1)",
    "expect": {
      "phase": "parse",
      "diagnostics": [
        {
          "code": "reserved-word",
          "span": [1, 9, 1, 11],
          "message": "do is a reserved word and cannot be a name"
        }
      ]
    }
  },
  {
    "name": "reserved word before => in a const value stays reserved-word name",
    "source": "const f = return => 1; 1",
    "expect": {
      "phase": "parse",
      "diagnostics": [
        {
          "code": "reserved-word",
          "span": [1, 11, 1, 17],
          "message": "return is a reserved word and cannot be a name"
        }
      ]
    }
  },
  {
