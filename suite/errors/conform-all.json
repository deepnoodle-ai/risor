 {
  "name": "a union: a value that conforms gives an empty list",
  "conform": {
   "type": "{kind: \"circle\", r: float} | {kind: \"rect\", h: float, w: float}",
   "value": {
    "kind": "rect",
    "w": 2,
    "h": 3
   },
   "max": 5
  },
  "expect": {
   "conforms": true,
   "failures": []
  }
 },
 {
  "name": "a union: a missing tag is one failure, and nothing more of the value is visited",
  "conform": {
   "type": "{kind: \"circle\", r: float} | {kind: \"rect\", h: float, w: float}",
   "value": {
    "r": "x",
    "z": 1
   },
   "max": 5
  },
  "expect": {
   "conforms": false,
   "path": [
    "kind"
   ],
   "message": "required field \"kind\" is missing",
   "failures": [
    {
     "path": [
      "kind"
     ],
     "message": "required field \"kind\" is missing"
    }
   ]
  }
 },
 {
  "name": "a union: an unknown tag is one failure, and nothing more of the value is visited",
