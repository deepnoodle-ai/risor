   "vars": {
    "body": {
     "id": "a",
     "x": 1
    }
   },
   "expect": {
    "value": {
     "id": "a",
     "x": 1
    },
    "steps": 2,
    "allocated": 0
   },
   "env": "{body: any, n: int, v: int | string, t: Time}",
   "opaque": [
    "Time"
   ]
  },
  {
