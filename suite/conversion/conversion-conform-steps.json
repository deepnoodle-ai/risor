{
 "cases": [
  {
   "name": "a list of five at a limit of 6: the walk charges exactly 6",
   "conform": {
    "type": "int[]",
    "value": [
     1,
     2,
     3,
     4,
     5
    ],
    "limit": 6
   },
   "expect": {
    "conforms": true,
    "steps": 6
   }
  },
  {
   "name": "a list of five at a limit of 5: the last element passes it",
   "conform": {
    "type": "int[]",
    "value": [
     1,
     2,
     3,
     4,
     5
    ],
    "limit": 5
   },
   "expect": {
    "phase": "run",
    "diagnostics": [
     {
      "code": "steps-exceeded",
      "message": "the run needed more than its limit of 5 steps"
     }
    ]
   }
  },
  {
   "name": "a limit of 0: any charges nothing and passes",
   "conform": {
    "type": "any",
    "value": [
     1,
     [
      2,
      [
       3
      ]
     ]
    ],
    "limit": 0
   },
   "expect": {
    "conforms": true,
    "steps": 0
   }
  },
  {
   "name": "a limit of 0: any other test charges its first step",
   "conform": {
    "type": "int",
    "value": 1,
    "limit": 0
   },
   "expect": {
    "phase": "run",
    "diagnostics": [
     {
      "code": "steps-exceeded",
      "message": "the run needed more than its limit of 0 steps"
     }
    ]
   }
  },
  {
   "name": "a failure within the limit is not-conforming",
   "conform": {
    "type": "int[]",
    "value": [
     1,
     "a",
     3,
     4,
     5
    ],
    "limit": 3
   },
   "expect": {
    "conforms": false,
    "path": [
     1
    ],
    "message": "expected int, found \"a\"",
    "steps": 3
   }
  },
  {
   "name": "the step of the failing place passes the limit first",
   "conform": {
    "type": "int[]",
    "value": [
     1,
     "a",
     3,
     4,
     5
    ],
    "limit": 2
   },
   "expect": {
    "phase": "run",
    "diagnostics": [
     {
      "code": "steps-exceeded"
     }
    ]
   }
  },
  {
