   "conform": {
    "type": "{a: int, ...int}",
    "value": {
     "a": 1,
     "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx": 1,
     "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy": 2
    },
