[
  {"name": "example 1: older than a week", "source": "time.parse(pr.updated_at) < now - time.duration(\"7d\")", "groups": ["json", "time", "math", "base64"], "env": "{pr: {updated_at: string}, now: float}", "vars": {"pr": {"updated_at": "2024-02-20T09:00:00Z"}, "now": 1709209845}, "expect": {"value": true, "steps": 5, "allocated": 0}},
  {"name": "example 2: a field of a JSON message, with a fallback", "source": "try { json.parse(msg).count ?? 0 } catch { -1 }", "groups": ["json", "time", "math", "base64"], "env": "{msg: string}", "vars": {"msg": "{\"count\": 3}"}, "expect": {"value": 3, "steps": 4, "allocated": 3}},
  {"name": "example 3: the same with a message that is not JSON", "source": "try { json.parse(msg).count ?? 0 } catch { -1 }", "groups": ["json", "time", "math", "base64"], "env": "{msg: string}", "vars": {"msg": "oops"}, "expect": {"value": -1, "steps": 2, "allocated": 0}},
  {"name": "example 4: writing JSON", "source": "json.stringify({id: 7, tags: [\"a\", \"b\"]})", "groups": ["json", "time", "math", "base64"], "expect": {"value": "{\"id\":7,\"tags\":[\"a\",\"b\"]}", "steps": 7, "allocated": 9}},
  {"name": "example 5: a token part", "source": "json.parse(base64.decode(part))", "groups": ["json", "time", "math", "base64"], "env": "{part: string}", "vars": {"part": "eyJzdWIiOiJhbmEiLCJleHAiOjE3MDkyMDk4NDV9"}, "expect": {"value": {"sub": "ana", "exp": 1709209845}, "steps": 5, "allocated": 7}},
  {"name": "example 6: a distance", "source": "math.sqrt(dx ** 2 + dy ** 2)", "groups": ["json", "time", "math", "base64"], "env": "{dx: float, dy: float}", "vars": {"dx": 3, "dy": 4}, "expect": {"value": 5, "steps": 4, "allocated": 0}},
  {"name": "example 7: a time in another offset, in UTC", "source": "time.format(time.parse(\"2024-02-29T12:30:45.500+01:00\"))", "groups": ["json", "time", "math", "base64"], "expect": {"value": "2024-02-29T11:30:45.5Z", "steps": 2, "allocated": 1}},
  {"name": "example 8: the message of integer-range", "source": "try { json.parse(s) } catch (err) { err.message }", "groups": ["json", "time", "math", "base64"], "env": "{s: string}", "vars": {"s": "9007199254740993"}, "expect": {"value": "the JSON text has a number with no fraction that is not a whole number", "steps": 4, "allocated": 11}}
]
