[
  {"name": "a group turned on", "source": "json.parse(\"[1]\")", "groups": ["json"], "expect": {"value": [1]}},
  {"name": "two groups turned on", "source": "[math.sqrt(4), base64.encode(\"a\")]", "groups": ["math", "base64"], "expect": {"value": [2, "YQ=="]}},
  {"name": "all four groups", "source": "[json.stringify(math.pi), time.format(0), base64.decode(\"YQ\")]", "groups": ["json", "math", "time", "base64"], "expect": {"value": ["3.141592653589793", "1970-01-01T00:00:00Z", "a"]}},
  {"name": "the order of the names does not matter", "source": "base64.encode(time.format(0))", "groups": ["time", "base64"], "expect": {"value": "MTk3MC0wMS0wMVQwMDowMDowMFo="}},
  {"name": "a group that is off: its namespace is an undefined name", "source": "json.parse(\"1\")", "groups": ["math"], "expect": {"phase": "check", "diagnostics": [{"code": "undefined-name", "span": [1, 1, 1, 5]}]}},
  {"name": "a constant of a group that is off", "source": "math.pi", "groups": ["json"], "expect": {"phase": "check", "diagnostics": [{"code": "undefined-name", "span": [1, 1, 1, 5]}]}},
  {"name": "an empty list of groups turns none on", "source": "time.parse(\"1970-01-01T00:00:00Z\")", "groups": [], "expect": {"phase": "check", "diagnostics": [{"code": "undefined-name", "span": [1, 1, 1, 5]}]}},
  {"name": "an explicit version 3.0 with a group", "source": "math.sqrt(9)", "groups": ["math"], "version": "3.0", "expect": {"value": 3}},
  {"name": "a group that does not exist: \"xml\"", "source": "1", "groups": ["xml"], "expect": {"phase": "declare", "diagnostics": [{"code": "bad-name"}]}},
  {"name": "a group that does not exist: \"regexp\"", "source": "1", "groups": ["regexp"], "expect": {"phase": "declare", "diagnostics": [{"code": "bad-name"}]}},
  {"name": "a group that does not exist: \"JSON\"", "source": "1", "groups": ["JSON"], "expect": {"phase": "declare", "diagnostics": [{"code": "bad-name"}]}},
  {"name": "a group that does not exist: \"core\"", "source": "1", "groups": ["core"], "expect": {"phase": "declare", "diagnostics": [{"code": "bad-name"}]}},
  {"name": "a group that does not exist: \"\"", "source": "1", "groups": [""], "expect": {"phase": "declare", "diagnostics": [{"code": "bad-name"}]}},
  {"name": "a group that does not exist: \"math.sqrt\"", "source": "1", "groups": ["math.sqrt"], "expect": {"phase": "declare", "diagnostics": [{"code": "bad-name"}]}},
  {"name": "a variable named like a group that is on", "source": "1", "groups": ["json"], "env": "{json: int}", "expect": {"phase": "declare", "diagnostics": [{"code": "name-clash"}]}},
  {"name": "a host function named like a group that is on", "source": "1", "groups": ["math"], "functions": {"math": "() => int"}, "expect": {"phase": "declare", "diagnostics": [{"code": "name-clash"}]}},
  {"name": "a variable named like a group that is off", "source": "json + 1", "groups": ["math"], "env": "{json: int}", "vars": {"json": 1}, "expect": {"value": 2}},
  {"name": "a variable named time with no group on", "source": "time", "env": "{time: string}", "vars": {"time": "noon"}, "expect": {"value": "noon"}},
  {"name": "a method call on a variable named like a group that is off", "source": "time.parse(\"x\")", "env": "{time: any}", "vars": {"time": {}}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "message": "a value of kind map has no method parse"}], "steps": 0, "allocated": 0}},
  {"name": "a host function named like an entry without its namespace does not clash", "source": "[sqrt(4), math.sqrt(4)]", "groups": ["math"], "functions": {"sqrt": {"type": "(x: float) => float", "calls": [{"args": [4], "result": 2}]}}, "expect": {"value": [2, 2]}},
  {"name": "a host function in a group namespace stays reserved when the group is on", "source": "1", "groups": ["math"], "functions": {"math.sqrt": "(x: float) => float"}, "expect": {"phase": "declare", "diagnostics": [{"code": "reserved-namespace"}]}},
  {"name": "a host namespace beside a group", "source": "[geo.parse(1), json.parse(\"2\")]", "groups": ["json"], "functions": {"geo.parse": {"type": "(n: int) => int", "calls": [{"args": [1], "result": 10}]}}, "expect": {"value": [10, 2]}},
  {"name": "a variable named like an entry without its namespace", "source": "[parse, json.parse(\"1\")]", "groups": ["json"], "env": "{parse: int}", "vars": {"parse": 5}, "expect": {"value": [5, 1]}},
  {"name": "an opaque type named like a group does not clash", "source": "json.stringify(1)", "groups": ["json"], "opaque": ["Json"], "expect": {"value": "1"}},
  {"name": "a map key named like a group", "source": "{json: 1}.json", "groups": ["json"], "expect": {"value": 1}},
  {"name": "a pattern key named like a group binds another name", "source": "const {math: m} = {math: 2}; m", "groups": ["math"], "expect": {"value": 2, "steps": 1, "allocated": 3}}
]
