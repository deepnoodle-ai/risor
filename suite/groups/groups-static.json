[
  {"name": "a namespace alone is not a value", "source": "json", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "not-a-value", "span": [1, 1, 1, 5]}]}},
  {"name": "a name that the group lacks", "source": "json.nothing(1)", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "undefined-function", "span": [1, 1, 1, 13]}]}},
  {"name": "only a plain . calls into a group", "source": "json?.parse(\"1\")", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "not-a-value", "span": [1, 1, 1, 5]}]}},
  {"name": "an entry named without a call", "source": "math.sqrt", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "not-a-value", "span": [1, 1, 1, 5]}]}},
  {"name": "a constant the group lacks", "source": "math.tau", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "not-a-value", "span": [1, 1, 1, 5]}]}},
  {"name": "a constant read with ?.", "source": "math?.pi", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "not-a-value", "span": [1, 1, 1, 5]}]}},
  {"name": "a constant called", "source": "math.pi()", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "undefined-function", "span": [1, 1, 1, 8]}]}},
  {"name": "too few arguments", "source": "math.sqrt()", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 12]}]}},
  {"name": "too many arguments", "source": "math.sqrt(1, 2)", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 16]}]}},
  {"name": "a lambda passed to a group entry", "source": "math.sqrt(x => x)", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "not-a-value", "span": [1, 11, 1, 17]}]}},
  {"name": "a const named like a group that is on", "source": "const json = 1; json", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "shadows-namespace", "span": [1, 7, 1, 11]}, {"code": "not-a-value", "span": [1, 17, 1, 21]}]}},
  {"name": "a parameter named like a group that is on", "source": "[1].map(math => math)", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "shadows-namespace", "span": [1, 9, 1, 13]}, {"code": "not-a-value", "span": [1, 17, 1, 21]}]}},
  {"name": "a catch name named like a group that is on", "source": "try { 1 } catch (math) { 2 }", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "shadows-namespace", "span": [1, 18, 1, 22]}]}},
  {"name": "a pattern name named like a group that is on", "source": "const {math} = {math: 2}; 1", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "shadows-namespace", "span": [1, 8, 1, 12]}]}},
  {"name": "a shorthand entry named like a group", "source": "{math}", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "not-a-value", "span": [1, 2, 1, 6]}]}},
  {"name": "a group in a default", "source": "const f = (x = math) => x; f()", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "not-a-value", "span": [1, 16, 1, 20]}]}},
  {"name": "a group that is off beside one that is on", "source": "[math.pi, time.format(0)]", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "undefined-name", "span": [1, 11, 1, 15]}]}},
  {"name": "an unknown entry and a namespace argument, in text order", "source": "json.nothing(math)", "groups": ["json", "math", "base64"], "expect": {"phase": "check", "diagnostics": [{"code": "undefined-function", "span": [1, 1, 1, 13]}, {"code": "not-a-value", "span": [1, 14, 1, 18]}]}},
  {"name": "two constants", "source": "math.pi + math.e", "groups": ["json", "math", "base64"], "expect": {"value": 5.859874482048838, "steps": 1, "allocated": 0}},
  {"name": "a constant in a map and a pattern", "source": "const {pi} = {pi: math.pi}; pi", "groups": ["json", "math", "base64"], "expect": {"value": 3.141592653589793, "steps": 1, "allocated": 3}},
  {"name": "a constant as an argument", "source": "json.stringify(math.pi)", "groups": ["json", "math", "base64"], "expect": {"value": "3.141592653589793", "steps": 1, "allocated": 1}},
  {"name": "a constant in a lambda body", "source": "[1, 2].map(n => n * math.pi)", "groups": ["json", "math", "base64"], "expect": {"value": [3.141592653589793, 6.283185307179586], "steps": 8, "allocated": 6}},
  {"name": "a constant read charges nothing", "source": "math.e", "groups": ["json", "math", "base64"], "expect": {"value": 2.718281828459045, "steps": 0, "allocated": 0}}
]
