[
  {"name": "json: parse of stringify gives the value back", "source": "json.parse(json.stringify(x)) == x", "groups": ["json", "time", "math", "base64"], "env": "{x: any}", "vars": {"x": {"b": [1, "x", null, true, {"c": 2.5}], "a": ""}}, "expect": {"value": true}},
  {"name": "json: stringify of parse writes the canonical text", "source": "json.stringify(json.parse(s))", "groups": ["json", "time", "math", "base64"], "env": "{s: string}", "vars": {"s": "{ \"b\" : [1, 2.50, 1e2], \"a\" : \"\\u00e9\" }"}, "expect": {"value": "{\"a\":\"é\",\"b\":[1,2.5,100]}"}},
  {"name": "base64: decode of encode gives the text back", "source": "base64.decode(base64.encode(s)) == s", "groups": ["json", "time", "math", "base64"], "env": "{s: string}", "vars": {"s": "a😀\u0000é￿"}, "expect": {"value": true}},
  {"name": "base64: the URL alphabet decodes to the same text", "source": "base64.decode(base64.encode(s).replaceAll(\"+\", \"-\").replaceAll(\"/\", \"_\").replaceAll(\"=\", \"\"))", "groups": ["json", "time", "math", "base64"], "env": "{s: string}", "vars": {"s": "????>>>😀"}, "expect": {"value": "????>>>😀"}},
  {"name": "time: format of parse is the same instant in UTC", "source": "time.format(time.parse(\"2024-02-29T12:30:45.500+01:00\"))", "groups": ["json", "time", "math", "base64"], "expect": {"value": "2024-02-29T11:30:45.5Z", "steps": 2, "allocated": 1}},
  {"name": "time: parse of format gives -0.1 back", "source": "time.parse(time.format(t)) == t", "groups": ["json", "time", "math", "base64"], "env": "{t: float}", "vars": {"t": -0.1}, "expect": {"value": true}},
  {"name": "time: parse of format gives 1e-70 back", "source": "time.parse(time.format(t)) == t", "groups": ["json", "time", "math", "base64"], "env": "{t: float}", "vars": {"t": 1e-70}, "expect": {"value": true}},
  {"name": "time: parse of format gives 946684800.1234568 back", "source": "time.parse(time.format(t)) == t", "groups": ["json", "time", "math", "base64"], "env": "{t: float}", "vars": {"t": 946684800.1234568}, "expect": {"value": true}},
  {"name": "time: parse of format gives -62167219200 back", "source": "time.parse(time.format(t)) == t", "groups": ["json", "time", "math", "base64"], "env": "{t: float}", "vars": {"t": -62167219200}, "expect": {"value": true}},
  {"name": "time: parse of format gives 253402300799.5 back", "source": "time.parse(time.format(t)) == t", "groups": ["json", "time", "math", "base64"], "env": "{t: float}", "vars": {"t": 253402300799.5}, "expect": {"value": true}},
  {"name": "time: parse of format gives 0.5 back", "source": "time.parse(time.format(t)) == t", "groups": ["json", "time", "math", "base64"], "env": "{t: float}", "vars": {"t": 0.5}, "expect": {"value": true}},
  {"name": "time: parse of format gives -1e-7 back", "source": "time.parse(time.format(t)) == t", "groups": ["json", "time", "math", "base64"], "env": "{t: float}", "vars": {"t": -1e-07}, "expect": {"value": true}},
  {"name": "time: the date of a time", "source": "time.format(now).slice(0, 10)", "groups": ["json", "time", "math", "base64"], "env": "{now: float}", "vars": {"now": 1709209845}, "expect": {"value": "2024-02-29", "steps": 2, "allocated": 2}},
  {"name": "time: older than a week", "source": "time.parse(pr.updated_at) < now - time.duration(\"7d\")", "groups": ["json", "time", "math", "base64"], "env": "{pr: {updated_at: string}, now: float}", "vars": {"pr": {"updated_at": "2024-02-20T09:00:00Z"}, "now": 1709209845}, "expect": {"value": true, "steps": 5, "allocated": 0}},
  {"name": "time: a difference of two times in hours", "source": "(time.parse(b) - time.parse(a)) / time.duration(\"1h\")", "groups": ["json", "time", "math", "base64"], "env": "{a: string, b: string}", "vars": {"a": "2024-02-28T00:00:00Z", "b": "2024-02-29T12:00:00Z"}, "expect": {"value": 36, "steps": 5, "allocated": 0}},
  {"name": "math with rounding in the program", "source": "round(math.sqrt(2) * 1000)", "groups": ["json", "time", "math", "base64"], "expect": {"value": 1414, "steps": 3, "allocated": 0}},
  {"name": "json and math: constants as JSON", "source": "json.stringify([math.pi, math.e])", "groups": ["json", "time", "math", "base64"], "expect": {"value": "[3.141592653589793,2.718281828459045]", "steps": 3, "allocated": 4}},
  {"name": "a token part: base64 then JSON", "source": "json.parse(base64.decode(part))", "groups": ["json", "time", "math", "base64"], "env": "{part: string}", "vars": {"part": "eyJzdWIiOiJhbmEiLCJleHAiOjE3MDkyMDk4NDV9"}, "expect": {"value": {"sub": "ana", "exp": 1709209845}, "steps": 5, "allocated": 7}},
  {"name": "catch a failure of a group: math.sqrt", "source": "try { math.sqrt(x) } catch (err) { err.message }", "groups": ["json", "time", "math", "base64"], "env": "{x: float, s: string, t: float, b: string, y: float}", "vars": {"x": -1, "s": "9007199254740993", "t": 253402300800, "b": "/w==", "y": 1000}, "expect": {"value": "the result of math.sqrt is not a real number", "steps": 3, "allocated": 10}},
  {"name": "catch a failure of a group: json.parse", "source": "try { json.parse(s) } catch (err) { err.message }", "groups": ["json", "time", "math", "base64"], "env": "{x: float, s: string, t: float, b: string, y: float}", "vars": {"x": -1, "s": "9007199254740993", "t": 253402300800, "b": "/w==", "y": 1000}, "expect": {"value": "the JSON text has a number with no fraction that is not a whole number", "steps": 4, "allocated": 11}},
  {"name": "catch a failure of a group: time.format", "source": "try { time.format(t) } catch (err) { err.message }", "groups": ["json", "time", "math", "base64"], "env": "{x: float, s: string, t: float, b: string, y: float}", "vars": {"x": -1, "s": "9007199254740993", "t": 253402300800, "b": "/w==", "y": 1000}, "expect": {"value": "the year of time 253402300800 is outside 0000 to 9999", "steps": 3, "allocated": 10}},
  {"name": "catch a failure of a group: base64.decode", "source": "try { base64.decode(b) } catch (err) { err.message }", "groups": ["json", "time", "math", "base64"], "env": "{x: float, s: string, t: float, b: string, y: float}", "vars": {"x": -1, "s": "9007199254740993", "t": 253402300800, "b": "/w==", "y": 1000}, "expect": {"value": "the decoded bytes are not valid UTF-8", "steps": 3, "allocated": 10}},
  {"name": "a limit failure of a group is not caught", "source": "try { json.parse(s) } catch { 0 }", "groups": ["json", "time", "math", "base64"], "env": "{s: string}", "vars": {"s": "[[[1]]]"}, "limits": {"depth": 2}, "expect": {"phase": "run", "diagnostics": [{"code": "depth-exceeded"}]}},
  {"name": "the depth of json.parse counts the calls in progress", "source": "[1].map(n => json.parse(s))", "groups": ["json", "time", "math", "base64"], "env": "{s: string}", "vars": {"s": "[[1]]"}, "limits": {"depth": 2}, "expect": {"phase": "run", "diagnostics": [{"code": "depth-exceeded"}]}},
  {"name": "the same text parses at the top of the program", "source": "json.parse(s)", "groups": ["json", "time", "math", "base64"], "env": "{s: string}", "vars": {"s": "[[1]]"}, "limits": {"depth": 2}, "expect": {"value": [[1]]}},
  {"name": "the depth of json.stringify counts the calls in progress", "source": "[1].map(n => json.stringify(x))", "groups": ["json", "time", "math", "base64"], "env": "{x: any}", "vars": {"x": [[1]]}, "limits": {"depth": 2}, "expect": {"phase": "run", "diagnostics": [{"code": "depth-exceeded"}]}}
]
