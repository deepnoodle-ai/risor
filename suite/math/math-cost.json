[
  {"name": "cost: a call charges 200 steps beyond its own", "source": "math.sin(x)", "groups": ["math"], "env": "{x: float}", "vars": {"x": 1}, "expect": {"value": 0.8414709848078965, "steps": 201, "allocated": 0}},
  {"name": "cost: a step limit of 201 is enough", "source": "math.sin(x)", "groups": ["math"], "env": "{x: float}", "vars": {"x": 1}, "limits": {"steps": 201}, "expect": {"value": 0.8414709848078965, "steps": 201, "allocated": 0}},
  {"name": "cost: a step limit of 200 is passed by the charge of 200", "source": "math.sin(x)", "groups": ["math"], "env": "{x: float}", "vars": {"x": 1}, "limits": {"steps": 200}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded"}]}},
  {"name": "cost: a step limit of 1 is passed by the charge of 200, after the call's step", "source": "math.cos(x)", "groups": ["math"], "env": "{x: float}", "vars": {"x": 1}, "limits": {"steps": 1}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded"}]}},
  {"name": "cost: not-real is found before the charge", "source": "math.log(x)", "groups": ["math"], "env": "{x: float}", "vars": {"x": 0}, "expect": {"phase": "run", "diagnostics": [{"code": "invalid-argument", "class": "value", "message": "the result of math.log is not a real number"}], "steps": 1, "allocated": 0}},
  {"name": "cost: not-real within a step limit of 1", "source": "math.asin(x)", "groups": ["math"], "env": "{x: float}", "vars": {"x": 2}, "limits": {"steps": 1}, "expect": {"phase": "run", "diagnostics": [{"code": "invalid-argument", "class": "value", "message": "the result of math.asin is not a real number"}], "steps": 1, "allocated": 0}},
  {"name": "cost: an overflow is found by computing, after the charge", "source": "math.exp(x)", "groups": ["math"], "env": "{x: float}", "vars": {"x": 710}, "expect": {"phase": "run", "diagnostics": [{"code": "number-range", "class": "range", "message": "the result of math.exp is out of range"}], "steps": 201, "allocated": 0}},
  {"name": "cost: an overflow of pow", "source": "math.pow(x, y)", "groups": ["math"], "env": "{x: float, y: float}", "vars": {"x": 10, "y": 400}, "expect": {"phase": "run", "diagnostics": [{"code": "number-range", "class": "range", "message": "the result of math.pow is out of range"}], "steps": 201, "allocated": 0}},
  {"name": "cost: an exact result still charges 200", "source": "math.pow(x, y)", "groups": ["math"], "env": "{x: float, y: float}", "vars": {"x": 5, "y": 0}, "expect": {"value": 1, "steps": 201, "allocated": 0}},
  {"name": "cost: two calls in one expression", "source": "math.sin(x) + math.cos(x)", "groups": ["math"], "env": "{x: float}", "vars": {"x": 1}, "expect": {"value": 1.3817732906760363, "steps": 403, "allocated": 0}},
  {"name": "cost: two calls within a step limit of 403", "source": "math.sin(x) + math.cos(x)", "groups": ["math"], "env": "{x: float}", "vars": {"x": 1}, "limits": {"steps": 403}, "expect": {"value": 1.3817732906760363, "steps": 403, "allocated": 0}},
  {"name": "cost: the charge of the second call passes a step limit of 401", "source": "math.sin(x) + math.cos(x)", "groups": ["math"], "env": "{x: float}", "vars": {"x": 1}, "limits": {"steps": 401}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded"}]}},
  {"name": "cost: with a step limit of 402 the + passes it, after both calls", "source": "math.sin(x) + math.cos(x)", "groups": ["math"], "env": "{x: float}", "vars": {"x": 1}, "limits": {"steps": 402}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded"}]}},
  {"name": "cost: math.sqrt charges no more than its call", "source": "math.sqrt(x) + math.sin(x)", "groups": ["math"], "env": "{x: float}", "vars": {"x": 1}, "expect": {"value": 1.8414709848078965, "steps": 203, "allocated": 0}},
