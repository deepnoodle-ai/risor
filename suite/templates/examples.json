{
 "cases": [
  {
   "name": "T1: Review of #${{ pr.number }}",
   "template": "string",
   "source": "Review of #${{ pr.number }}",
   "expect": {
    "value": "Review of #42",
    "steps": 2,
    "allocated": 1
   },
   "env": "{pr: {number: int}, xs: int[], name: string}",
   "vars": {
    "pr": {
     "number": 42
    },
    "xs": [
     1,
     2,
     3
    ],
    "name": "Ann"
   }
  },
  {
   "name": "T2: ${{ pr.number }}",
   "template": "value",
   "source": "${{ pr.number }}",
   "expect": {
    "value": 42,
    "steps": 1,
    "allocated": 0
   },
   "env": "{pr: {number: int}, xs: int[], name: string}",
   "vars": {
    "pr": {
     "number": 42
    },
    "xs": [
     1,
     2,
     3
    ],
    "name": "Ann"
   }
  },
  {
   "name": "T3: ${{ pr.number }}",
   "template": "string",
   "source": "${{ pr.number }}",
