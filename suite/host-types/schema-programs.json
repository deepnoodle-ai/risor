[
  {"name": "a required property makes the record never falsy", "source": "order ? 1 : 2", "schemas": {"order": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["id"]}}}, "expect": {"phase": "check", "diagnostics": [{"code": "always-truthy", "span": [1, 1, 1, 6]}]}},
  {"name": "no required property: the record may be falsy", "source": "v ? 1 : 2", "schemas": {"v": {"schema": {"type": "object", "properties": {"a": {"type": "string"}}}}}, "expect": {"type": "int", "sites": []}},
  {"name": "an enum without the empty string is never falsy", "source": "v || \"none\"", "schemas": {"v": {"schema": {"enum": ["a", "b"]}}}, "expect": {"phase": "check", "diagnostics": [{"code": "always-truthy", "span": [1, 1, 1, 2]}]}},
  {"name": "an enum with the empty string may be falsy", "source": "v || \"none\"", "schemas": {"v": {"schema": {"enum": ["", "a"]}}}, "expect": {"type": "\"a\" | \"none\"", "sites": []}},
  {"name": "an optional property is maybe-absent", "source": "order.note", "schemas": {"order": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["id"]}}}, "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 7, 1, 11]}]}},
  {"name": "an optional property read with ?.", "source": "order?.note ?? \"none\"", "schemas": {"order": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["id"]}}}, "expect": {"type": "string", "sites": []}},
  {"name": "a required property", "source": "order.id + 1", "schemas": {"order": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["id"]}}}, "expect": {"type": "int", "sites": []}},
  {"name": "a key the schema does not declare, on an open record", "source": "order?.extra", "schemas": {"order": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["id"]}}}, "expect": {"type": "any", "sites": []}},
  {"name": "a key the schema does not declare, closed", "source": "order?.extra", "schemas": {"order": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["id"]}, "options": ["closed"]}}, "expect": {"phase": "check", "diagnostics": [{"code": "no-field", "span": [1, 8, 1, 13]}]}},
  {"name": "a required nullable property is maybe-null", "source": "v.a.trim()", "schemas": {"v": {"schema": {"type": "object", "properties": {"a": {"type": ["string", "null"]}}, "required": ["a"]}}}, "expect": {"phase": "check", "diagnostics": [{"code": "maybe-null", "span": [1, 1, 1, 4]}]}},
  {"name": "absent-is-null: an optional property is present and may be null", "source": "order.note ?? \"none\"", "schemas": {"order": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["id"]}, "options": ["absent-is-null"]}}, "expect": {"type": "string", "sites": []}},
  {"name": "number is float, integer is int", "source": "i + 1 == f", "schemas": {"i": {"schema": {"type": "integer"}}, "f": {"schema": {"type": "number"}}}, "expect": {"type": "bool", "sites": []}},
  {"name": "int fits an int result", "source": "i", "schemas": {"i": {"schema": {"type": "integer"}}}, "returns": "int", "expect": {"type": "int", "sites": []}},
  {"name": "float does not fit an int result", "source": "f", "schemas": {"f": {"schema": {"type": "number"}}}, "returns": "int", "expect": {"phase": "check", "diagnostics": [{"code": "result-mismatch", "span": [1, 1, 1, 2]}]}},
  {"name": "an empty schema is any: a use is a dynamic site", "source": "v + 1", "schemas": {"v": {"schema": {}}}, "expect": {"type": "any", "sites": [{"class": "dynamic", "span": [1, 1, 1, 2]}]}},
  {"name": "run: a value valid by the schema", "source": "order.id + len(order?.tags ?? [])", "schemas": {"order": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["id"]}}}, "vars": {"order": {"id": 1, "tags": ["a", "b"]}}, "expect": {"type": "int", "sites": [], "value": 3}},
  {"name": "run: an absent optional property", "source": "order?.note ?? \"none\"", "schemas": {"order": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["id"]}}}, "vars": {"order": {"id": 1}}, "expect": {"value": "none"}},
  {"name": "run: a present optional property", "source": "order?.note ?? \"none\"", "schemas": {"order": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["id"]}}}, "vars": {"order": {"id": 1, "note": "x"}}, "expect": {"value": "x"}},
  {"name": "run: a key the schema does not declare is allowed", "source": "order.id", "schemas": {"order": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["id"]}}}, "vars": {"order": {"id": 1, "extra": true}}, "expect": {"value": 1}},
  {"name": "run: absent-is-null, a value the host filled with null", "source": "order.note ?? \"none\"", "schemas": {"order": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}, "note": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}}, "required": ["id"]}, "options": ["absent-is-null"]}}, "vars": {"order": {"id": 1, "note": null, "tags": null}}, "expect": {"value": "none"}},
  {"name": "run: integer 2.0 is int", "source": "i + 1", "schemas": {"i": {"schema": {"type": "integer"}}}, "vars": {"i": 2.0}, "expect": {"type": "int", "sites": [], "value": 3, "steps": 1, "allocated": 0}},
  {"name": "run: a literal set from enum in a match", "source": "match s { \"a\" => 1, \"b\" => 2 }", "schemas": {"s": {"schema": {"enum": ["a", "b"]}}}, "vars": {"s": "b"}, "expect": {"type": "int", "sites": [], "value": 2}}
