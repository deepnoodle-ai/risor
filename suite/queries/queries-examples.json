[
  {"name": "example 1: filter, then a star", "source": "orders.filter(o => o.status == \"open\")[*].id", "env": "{orders: any}", "vars": {"orders": [{"id": "a", "status": "open"}, {"id": "b", "status": "paid"}, {"id": "c", "status": "open"}]}, "expect": {"value": ["a", "c"], "steps": 18, "allocated": 6}},
  {"name": "example 2: every sku ordered", "source": "orders[*].lines[*].sku", "env": "{orders: any}", "vars": {"orders": [{"lines": [{"sku": "a"}, {"sku": "b"}]}, {"lines": []}, {"lines": [{"sku": "c"}, {"sku": "d"}, {"sku": "e"}, {"sku": "f"}]}]}, "expect": {"value": ["a", "b", "c", "d", "e", "f"], "steps": 18, "allocated": 7}},
  {"name": "example 3: the two slowest, descending", "source": "events.sortBy(e => e.ms, \"desc\").slice(0, 2)[*].ms", "env": "{events: any}", "vars": {"events": [{"ms": 5, "id": "x"}, {"ms": 9, "id": "y"}, {"ms": 1, "id": "z"}]}, "expect": {"value": [9, 5], "steps": 24, "allocated": 10}},
  {"name": "example 4: customer descending, then placed ascending", "source": "orders.sortBy(o => o.placed).sortBy(o => o.customer, \"desc\")[*].id", "env": "{orders: any}", "vars": {"orders": [{"id": "1", "customer": "a", "placed": 2}, {"id": "2", "customer": "b", "placed": 1}, {"id": "3", "customer": "a", "placed": 1}]}, "expect": {"value": ["2", "3", "1"]}},
  {"name": "example 5: the users seen, without null", "source": "events[*].user.filter(u => u != null).unique()", "env": "{events: {user: string | null}[]}", "vars": {"events": [{"user": "a"}, {"user": null}, {"user": "b"}, {"user": "a"}]}, "expect": {"type": "string[]", "sites": [], "value": ["a", "b"]}},
  {"name": "example 6: events of each kind", "source": "events.countBy(e => e.kind)", "env": "{events: any}", "vars": {"events": [{"kind": "push"}, {"kind": "pr"}, {"kind": "push"}]}, "expect": {"value": {"pr": 1, "push": 2}}},
  {"name": "example 7: the quantity for each customer", "source": "orders.groupBy(o => o.customer).mapValues(g => g[*].lines[*].qty.sum())", "env": "{orders: any}", "vars": {"orders": [{"customer": "a", "lines": [{"qty": 1}, {"qty": 2}]}, {"customer": "b", "lines": [{"qty": 5}]}, {"customer": "a", "lines": []}]}, "expect": {"value": {"a": 3, "b": 5}}},
  {"name": "example 8: the slowest event, the first of equal ones", "source": "events.maxBy(e => e.ms)", "env": "{events: any}", "vars": {"events": [{"ms": 5, "id": "x"}, {"ms": 9, "id": "y"}, {"ms": 9, "id": "z"}]}, "expect": {"value": {"ms": 9, "id": "y"}, "steps": 11, "allocated": 0}},
  {"name": "example 9: a join by key", "source": "{ const byId = customers.indexBy(c => c.id); orders.map(o => byId?.[o.customer]?.name ?? \"unknown\") }", "env": "{customers: any, orders: any}", "vars": {"customers": [{"id": "c1", "name": "Ann"}, {"id": "c2", "name": "Bo"}], "orders": [{"customer": "c2"}, {"customer": "c9"}]}, "expect": {"value": ["Bo", "unknown"]}},
  {"name": "example 10: each owner's services", "source": "services.entries().groupBy(e => e.value.owner).mapValues(g => g[*].key)", "env": "{services: any}", "vars": {"services": {"s1": {"owner": "x"}, "s2": {"owner": "y"}, "s3": {"owner": "x"}}}, "expect": {"value": {"x": ["s1", "s3"], "y": ["s2"]}}},
  {"name": "example 11: membership in a projection", "source": "\"urgent\" in issue.labels[*].name", "env": "{issue: any}", "vars": {"issue": {"labels": [{"name": "bug"}, {"name": "urgent"}]}}, "expect": {"value": true}},
  {"name": "example 12: the greatest ms", "source": "events[*].ms.max()", "env": "{events: any}", "vars": {"events": [{"ms": 5, "id": "x"}, {"ms": 9, "id": "y"}, {"ms": 1, "id": "z"}]}, "expect": {"value": 9, "steps": 10, "allocated": 4}}
]
