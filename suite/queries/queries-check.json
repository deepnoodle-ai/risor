{
 "env": "{orders: {id: string, lines: {qty: int, sku: string}[], note?: string, status: \"open\" | \"paid\"}[], services: map<{owner: string}>, body: any, users: {email: string}[], ol: {id: string, lines: {qty: int, sku: string}[] | null}[], xn: {a: int}[] | null, rs: ({a: int} | null)[], s: string, n: int, i: int, ss: string[], xss: int[][], m: map<int>, op: {a: int, ...}[], u: (int | string)[], c: bool}",
 "cases": [
  {"name": "a field of each element", "source": "orders[*].id", "expect": {"type": "string[]", "sites": []}},
  {"name": "a list that no star iterated keeps its level", "source": "orders[*].lines", "expect": {"type": "{qty: int, sku: string}[][]", "sites": []}},
  {"name": "two stars give one flat list", "source": "orders[*].lines[*].sku", "expect": {"type": "string[]", "sites": []}},
  {"name": "a later star with no read", "source": "orders[*].lines[*]", "expect": {"type": "{qty: int, sku: string}[]", "sites": []}},
  {"name": "a plain index read in a projection is one index site", "source": "orders[*].lines[0].qty", "expect": {"type": "int[]", "sites": [{"class": "index", "span": [1, 1, 1, 19]}]}},
  {"name": "a method call ends the projection", "source": "orders[*].lines[*].qty.sum()", "expect": {"type": "int", "sites": []}},
  {"name": "min after a projection", "source": "orders[*].lines[*].qty.min()", "expect": {"type": "int | null", "sites": []}},
  {"name": "a method of the element after a projection is no-method", "source": "users[*].email.toLowerCase()", "expect": {"phase": "check", "diagnostics": [{"code": "no-method", "span": [1, 16, 1, 27]}]}},
  {"name": "?.[*] on a list that may be null", "source": "xn?.[*].a", "expect": {"type": "int[] | null", "sites": []}},
  {"name": "?.[*] covers the method call after the projection", "source": "xn?.[*].a.sum()", "expect": {"type": "int | null", "sites": []}},
  {"name": "[*] on a list that may be null", "source": "xn[*].a", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-null", "span": [1, 1, 1, 3]}]}},
  {"name": "a later ?.[*] on a list that may be null", "source": "ol[*].lines?.[*].sku", "expect": {"type": "(string | null)[]", "sites": []}},
  {"name": "a later [*] on a list that may be null", "source": "ol[*].lines[*].sku", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-null", "span": [1, 1, 1, 12]}]}},
  {"name": "?. on an optional field in a projection", "source": "orders[*]?.note", "expect": {"type": "(string | null)[]", "sites": []}},
  {"name": "a plain read of an optional field in a projection", "source": "orders[*].note", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 11, 1, 15]}]}},
  {"name": "?. on elements that may be null", "source": "rs[*]?.a", "expect": {"type": "(int | null)[]", "sites": []}},
  {"name": "a plain read on elements that may be null", "source": "rs[*].a", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-null", "span": [1, 1, 1, 6]}]}},
  {"name": "a star on a map", "source": "services[*].owner", "expect": {"phase": "check", "diagnostics": [{"code": "kind", "span": [1, 1, 1, 9]}]}},
  {"name": "the values of a map, then a star", "source": "services.values()[*].owner", "expect": {"type": "string[]", "sites": []}},
  {"name": "a star on a string", "source": "s[*]", "expect": {"phase": "check", "diagnostics": [{"code": "kind", "span": [1, 1, 1, 2]}]}},
  {"name": "a star on a number", "source": "n[*]", "expect": {"phase": "check", "diagnostics": [{"code": "kind", "span": [1, 1, 1, 2]}]}},
  {"name": "a star on a record", "source": "m[*]", "expect": {"phase": "check", "diagnostics": [{"code": "kind", "span": [1, 1, 1, 2]}]}},
  {"name": "a later star on strings", "source": "ss[*][*]", "expect": {"phase": "check", "diagnostics": [{"code": "kind", "span": [1, 1, 1, 6]}]}},
  {"name": "a later star on lists", "source": "xss[*][*]", "expect": {"type": "int[]", "sites": []}},
  {"name": "a projection on any data", "source": "body.items[*].tags[*]", "expect": {"type": "any[]", "sites": [{"class": "dynamic", "span": [1, 1, 1, 5]}, {"class": "dynamic", "span": [1, 1, 1, 11]}, {"class": "dynamic", "span": [1, 1, 1, 14]}, {"class": "dynamic", "span": [1, 1, 1, 19]}]}},
  {"name": "a plain index on an any element records an index site", "source": "body[*][0]", "expect": {"type": "any[]", "sites": [{"class": "dynamic", "span": [1, 1, 1, 5]}, {"class": "dynamic", "span": [1, 1, 1, 8]}, {"class": "index", "span": [1, 1, 1, 11]}]}},
  {"name": "an optional index on an any element records none", "source": "body[*]?.[0]", "expect": {"type": "any[]", "sites": [{"class": "dynamic", "span": [1, 1, 1, 5]}, {"class": "dynamic", "span": [1, 1, 1, 8]}]}},
  {"name": "?.[*] on any may be null", "source": "body?.[*]", "expect": {"type": "any[] | null", "sites": [{"class": "dynamic", "span": [1, 1, 1, 5]}]}},
  {"name": "an unlisted field of an open record in a projection", "source": "op[*].z", "expect": {"type": "any[]", "sites": [{"class": "dynamic", "span": [1, 1, 1, 6]}]}},
  {"name": "?. on an unlisted field of an open record records no site", "source": "op[*]?.z", "expect": {"type": "any[]", "sites": []}},
  {"name": "no-field in a projection", "source": "orders[*].nope", "expect": {"phase": "check", "diagnostics": [{"code": "no-field", "span": [1, 11, 1, 15]}]}},
  {"name": "after no-field the projection is never, and nothing more is reported", "source": "orders[*].nope + 1", "expect": {"phase": "check", "diagnostics": [{"code": "no-field", "span": [1, 11, 1, 15]}]}},
  {"name": "after kind at a later star nothing more is reported", "source": "ss[*][*] + 1", "expect": {"phase": "check", "diagnostics": [{"code": "kind", "span": [1, 1, 1, 6]}]}},
  {"name": "an element type never with no diagnostic gives never[]", "source": "[][*]", "expect": {"type": "never[]", "sites": []}},
  {"name": "a read on a never element reports nothing", "source": "[][*].a", "expect": {"type": "never[]", "sites": []}},
  {"name": "never[] is a list: + reports kind", "source": "[][*] + 1", "expect": {"phase": "check", "diagnostics": [{"code": "kind", "span": [1, 1, 1, 6]}]}},
  {"name": "a never receiver gives never", "source": "[][0][*].a", "expect": {"type": "never", "sites": [{"class": "index", "span": [1, 1, 1, 6]}]}},
  {"name": "an index expression in a projection must fit int", "source": "orders[*].lines[i]", "expect": {"type": "{qty: int, sku: string}[]", "sites": [{"class": "index", "span": [1, 1, 1, 19]}]}},
  {"name": "an optional index in a projection gives null and no site", "source": "orders[*].lines?.[0]", "expect": {"type": "({qty: int, sku: string} | null)[]", "sites": []}},
  {"name": "a string index on a list element", "source": "orders[*].lines[s]", "expect": {"phase": "check", "diagnostics": [{"code": "kind", "span": [1, 17, 1, 18]}]}},
  {"name": "a string key on a record element", "source": "orders[*][\"id\"]", "expect": {"type": "string[]", "sites": []}},
  {"name": "a number index on a record element", "source": "orders[*][0]", "expect": {"phase": "check", "diagnostics": [{"code": "kind", "span": [1, 11, 1, 12]}]}},
  {"name": "a union of kinds at a step", "source": "u[*].x", "expect": {"phase": "check", "diagnostics": [{"code": "kind", "span": [1, 1, 1, 5]}]}},
  {"name": "a list literal as receiver", "source": "[1, 2][*]", "expect": {"type": "int[]", "sites": []}},
  {"name": "a list of lists literal, two stars", "source": "[[1], [2, 3]][*][*]", "expect": {"type": "int[]", "sites": []}},
  {"name": "?.[*] on a list that is never null", "source": "orders?.[*].id", "expect": {"type": "string[]", "sites": []}},
  {"name": "filter, then a star", "source": "orders.filter(o => o.status == \"open\")[*].id", "expect": {"type": "string[]", "sites": []}},
  {"name": "a projection of a literal set", "source": "orders[*].status", "expect": {"type": "(\"open\" | \"paid\")[]", "sites": []}},
  {"name": "filter narrows a projection that may hold null", "source": "orders[*]?.note.filter(x => x != null)", "expect": {"type": "string[]", "sites": []}},
  {"name": "a fact about the receiver applies before the star", "source": "xn != null ? xn[*].a : []", "expect": {"type": "int[]", "sites": []}},
  {"name": "a projection gives no fact", "source": "xn?.[*].a != null ? xn[*].a : []", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-null", "span": [1, 21, 1, 23]}]}},
  {"name": "a projection through a string index", "source": "ss[*][0]", "expect": {"type": "string[]", "sites": [{"class": "index", "span": [1, 1, 1, 9]}]}},
  {"name": "a projection in a lambda body, where the element is a parameter", "source": "xss.map(x => x[*])", "expect": {"type": "int[][]", "sites": []}},
  {"name": "as, then a projection", "source": "(body as {items: {tags: string[]}[]}).items[*].tags[*]", "expect": {"type": "string[]", "sites": [{"class": "value", "span": [1, 2, 1, 37]}]}},
  {"name": "an undefined name inside an index expression", "source": "orders[*].lines[nope]", "expect": {"phase": "check", "diagnostics": [{"code": "undefined-name", "span": [1, 17, 1, 21]}]}},
  {"name": "an undefined receiver", "source": "nope[*]", "expect": {"phase": "check", "diagnostics": [{"code": "undefined-name", "span": [1, 1, 1, 5]}]}},
  {"name": "a function read as the receiver", "source": "len[*]", "expect": {"phase": "check", "diagnostics": [{"code": "not-a-value", "span": [1, 1, 1, 4]}]}},
  {"name": "a rejected dynamic site on the receiver", "source": "body[*].a", "reject": ["constant-condition", "dynamic"], "expect": {"phase": "check", "diagnostics": [{"code": "unchecked", "span": [1, 1, 1, 5]}]}},
  {"name": "a rejected dynamic site on an element", "source": "op[*].z.y", "reject": ["constant-condition", "dynamic"], "expect": {"phase": "check", "diagnostics": [{"code": "unchecked", "span": [1, 1, 1, 6]}]}},
  {"name": "a rejected index site in a projection", "source": "orders[*].lines[0]", "reject": ["constant-condition", "index"], "expect": {"phase": "check", "diagnostics": [{"code": "may-fail", "span": [1, 1, 1, 19]}]}}
 ]
}
