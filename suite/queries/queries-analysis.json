[
  {"name": "a path through two stars", "source": "orders[*].lines[*].sku", "expect": {"analysis": {"names": ["orders"], "refs": [{"name": "orders", "path": [{"star": true}, "lines", {"star": true}, "sku"], "span": [1, 1, 1, 23]}], "calls": [], "literal": false}}},
  {"name": "a path that ends after a star", "source": "orders[*].lines", "expect": {"analysis": {"names": ["orders"], "refs": [{"name": "orders", "path": [{"star": true}, "lines"], "span": [1, 1, 1, 16]}], "calls": [], "literal": false}}},
  {"name": "a computed index stops the path after a star", "source": "orders[*].lines[0].sku", "expect": {"analysis": {"names": ["orders"], "refs": [{"name": "orders", "path": [{"star": true}, "lines"], "span": [1, 1, 1, 16]}], "calls": [], "literal": false}}},
  {"name": "a string key after a star is a step", "source": "orders[*].lines[\"x\"]", "expect": {"analysis": {"names": ["orders"], "refs": [{"name": "orders", "path": [{"star": true}, "lines", "x"], "span": [1, 1, 1, 21]}], "calls": [], "literal": false}}},
  {"name": "a method call after a projection ends the path", "source": "orders[*].lines[*].qty.sum()", "expect": {"analysis": {"names": ["orders"], "refs": [{"name": "orders", "path": [{"star": true}, "lines", {"star": true}, "qty"], "span": [1, 1, 1, 23]}], "calls": [], "literal": false}}},
  {"name": "?.[*] and ?. give the same steps", "source": "orders?.[*]?.id", "expect": {"analysis": {"names": ["orders"], "refs": [{"name": "orders", "path": [{"star": true}, "id"], "span": [1, 1, 1, 16]}], "calls": [], "literal": false}}},
  {"name": "the key * is not a star", "source": "orders[\"*\"]", "expect": {"analysis": {"names": ["orders"], "refs": [{"name": "orders", "path": ["*"], "span": [1, 1, 1, 12]}], "calls": [], "literal": false}}},
  {"name": "a path that ends with a star runs to its ]", "source": "xs[*]", "expect": {"analysis": {"names": ["xs"], "refs": [{"name": "xs", "path": [{"star": true}], "span": [1, 1, 1, 6]}], "calls": [], "literal": false}}},
  {"name": "white space in a star does not change the step", "source": "xs[ * ]", "expect": {"analysis": {"names": ["xs"], "refs": [{"name": "xs", "path": [{"star": true}], "span": [1, 1, 1, 8]}], "calls": [], "literal": false}}},
  {"name": "two stars and no read", "source": "xs[*][*]", "expect": {"analysis": {"names": ["xs"], "refs": [{"name": "xs", "path": [{"star": true}, {"star": true}], "span": [1, 1, 1, 9]}], "calls": [], "literal": false}}},
  {"name": "fields before the star", "source": "a.b[*].c", "expect": {"analysis": {"names": ["a"], "refs": [{"name": "a", "path": ["b", {"star": true}, "c"], "span": [1, 1, 1, 9]}], "calls": [], "literal": false}}},
  {"name": "a name in an index expression of a projection", "source": "xs[*].a[i]", "expect": {"analysis": {"names": ["i", "xs"], "refs": [{"name": "xs", "path": [{"star": true}, "a"], "span": [1, 1, 1, 8]}, {"name": "i", "path": [], "span": [1, 9, 1, 10]}], "calls": [], "literal": false}}},
  {"name": "a call in an index expression of a projection is not in a lambda", "source": "orders[*].lines[pick(n)]", "expect": {"analysis": {"names": ["n", "orders"], "refs": [{"name": "orders", "path": [{"star": true}, "lines"], "span": [1, 1, 1, 16]}, {"name": "n", "path": [], "span": [1, 22, 1, 23]}], "calls": [{"name": "pick", "namespace": null, "span": [1, 17, 1, 24], "args": [[1, 22, 1, 23]], "lambda": false}], "literal": false}}},
  {"name": "a projection of a literal is not a literal", "source": "[1, 2][*]", "expect": {"analysis": {"names": [], "refs": [], "calls": [], "literal": false}}},
  {"name": "a projection of a bound name is no reference", "source": "ys.map(y => y[*].k)", "expect": {"analysis": {"names": ["ys"], "refs": [{"name": "ys", "path": [], "span": [1, 1, 1, 3]}], "calls": [{"name": "ys.map", "namespace": "ys", "span": [1, 1, 1, 20], "args": [[1, 8, 1, 19]], "lambda": false}], "literal": false}}},
  {"name": "a star after a method call is not part of the reference", "source": "xs.filter(x => x.ok)[*].id", "expect": {"analysis": {"names": ["xs"], "refs": [{"name": "xs", "path": [], "span": [1, 1, 1, 3]}], "calls": [{"name": "xs.filter", "namespace": "xs", "span": [1, 1, 1, 21], "args": [[1, 11, 1, 20]], "lambda": false}], "literal": false}}},
  {"name": "a projection as an argument of a call", "source": "geo.distance(xs[*].a, b)", "expect": {"analysis": {"names": ["b", "geo", "xs"], "refs": [{"name": "geo", "path": [], "span": [1, 1, 1, 4]}, {"name": "xs", "path": [{"star": true}, "a"], "span": [1, 14, 1, 21]}, {"name": "b", "path": [], "span": [1, 23, 1, 24]}], "calls": [{"name": "geo.distance", "namespace": "geo", "span": [1, 1, 1, 25], "args": [[1, 14, 1, 21], [1, 23, 1, 24]], "lambda": false}], "literal": false}}},
  {"name": "a path does not follow a binding through a star", "source": "const os = orders; os[*].id", "expect": {"analysis": {"names": ["orders"], "refs": [{"name": "orders", "path": [], "span": [1, 12, 1, 18]}], "calls": [], "literal": false}}}
]
