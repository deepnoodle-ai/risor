  {"name": "white space inside the brackets of a star", "source": "xs[ * ].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}]}, "expect": {"value": [1, 2], "steps": 4, "allocated": 3}},
  {"name": "a comment inside ?.[*]", "source": "xs?.[ /* all */ * ].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}]}, "expect": {"value": [1, 2], "steps": 4, "allocated": 3}},
  {"name": "white space around the . after a star", "source": "xs[*] . a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}]}, "expect": {"value": [1, 2], "steps": 4, "allocated": 3}},
  {"name": "a star after a call", "source": "range(2)[*]", "expect": {"value": [0, 1], "steps": 5, "allocated": 6}},
