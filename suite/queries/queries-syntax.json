  {"name": "a star after an if", "source": "if (c) { xs } else { xs }[*]", "expect": {"phase": "parse", "diagnostics": [{"code": "unexpected-token", "span": [1, 26, 1, 27]}]}},
  {"name": "a star after a try", "source": "try { xs } catch { xs }?.[*]", "expect": {"phase": "parse", "diagnostics": [{"code": "unexpected-token", "span": [1, 24, 1, 27]}]}},
