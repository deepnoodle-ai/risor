[
  {"name": "one star and a field", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "expect": {"value": [1, 2, 3], "steps": 6, "allocated": 4}},
  {"name": "a star with no read copies the list", "source": "xs[*]", "env": "{xs: any}", "vars": {"xs": [1, 2, 3]}, "expect": {"value": [1, 2, 3], "steps": 3, "allocated": 4}},
  {"name": "a star over an empty list", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": []}, "expect": {"value": [], "steps": 0, "allocated": 1}},
  {"name": "a star over a list of one gives a list of one", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": [{"a": 5}]}, "expect": {"value": [5], "steps": 2, "allocated": 2}},
  {"name": "two stars give one flat list", "source": "orders[*].lines[*].sku", "env": "{orders: any}", "vars": {"orders": [{"lines": [{"sku": "a"}, {"sku": "b"}]}, {"lines": []}, {"lines": [{"sku": "c"}, {"sku": "d"}, {"sku": "e"}, {"sku": "f"}]}]}, "expect": {"value": ["a", "b", "c", "d", "e", "f"], "steps": 18, "allocated": 7}},
  {"name": "two stars where every inner list is empty", "source": "xs[*].b[*]", "env": "{xs: any}", "vars": {"xs": [{"b": []}, {"b": []}]}, "expect": {"value": [], "steps": 4, "allocated": 1}},
  {"name": "a list that no star iterated is not flattened", "source": "xs[*].b", "env": "{xs: any}", "vars": {"xs": [{"b": [1]}, {"b": [2, 3]}]}, "expect": {"value": [[1], [2, 3]], "steps": 4, "allocated": 3}},
  {"name": "two stars and no read flatten one level", "source": "xs[*][*]", "env": "{xs: any}", "vars": {"xs": [[1], [2, 3], []]}, "expect": {"value": [1, 2, 3], "steps": 6, "allocated": 4}},
  {"name": "three stars", "source": "xs[*][*][*]", "env": "{xs: any}", "vars": {"xs": [[[1], [2]], [[3]], []]}, "expect": {"value": [1, 2, 3], "steps": 9, "allocated": 4}},
  {"name": "a later star on an element that is not a list", "source": "xs[*][*]", "env": "{xs: any}", "vars": {"xs": [[1], 2]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 9], "class": "dynamic", "message": "cannot apply [*] to a value of kind number"}], "steps": 3, "allocated": 0}},
  {"name": "the order is depth first", "source": "xs[*].b[*].c", "env": "{xs: any}", "vars": {"xs": [{"b": [{"c": 1}, {"c": 2}]}, {"b": [{"c": 3}]}]}, "expect": {"value": [1, 2, 3], "steps": 10, "allocated": 4}},
  {"name": "an index read applies to each element", "source": "xs[*].b[0]", "env": "{xs: any}", "vars": {"xs": [{"b": [1, 2]}, {"b": [3]}]}, "expect": {"value": [1, 3], "steps": 6, "allocated": 3}},
  {"name": "an index read out of range at the second element", "source": "xs[*].b[1]", "env": "{xs: any}", "vars": {"xs": [{"b": [1, 2]}, {"b": [3]}]}, "expect": {"phase": "run", "diagnostics": [{"code": "index-range", "span": [1, 1, 1, 11], "class": "index", "message": "index 1 is outside the list of length 1"}], "steps": 6, "allocated": 0}},
  {"name": "an optional index read out of range gives null", "source": "xs[*].b?.[1]", "env": "{xs: any}", "vars": {"xs": [{"b": [1, 2]}, {"b": [3]}]}, "expect": {"value": [2, null], "steps": 6, "allocated": 3}},
  {"name": "a string key read", "source": "xs[*][\"a-b\"]", "env": "{xs: any}", "vars": {"xs": [{"a-b": 1}, {"a-b": 2}]}, "expect": {"value": [1, 2], "steps": 4, "allocated": 3}},
  {"name": "an optional string key read that finds nothing", "source": "xs[*]?.[\"a-b\"]", "env": "{xs: any}", "vars": {"xs": [{"a-b": 1}, {}]}, "expect": {"value": [1, null], "steps": 4, "allocated": 3}},
  {"name": "a missing field fails at the element", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {}]}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 1, 8], "class": "dynamic", "message": "the map has no field a"}], "steps": 4, "allocated": 0}},
  {"name": "a missing key fails at the element", "source": "xs[*][\"a-b\"]", "env": "{xs: any}", "vars": {"xs": [{"a-b": 1}, {}]}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 1, 13], "class": "dynamic", "message": "the map has no key \"a-b\""}], "steps": 4, "allocated": 0}},
  {"name": "?. on an absent field gives null and goes on", "source": "xs[*]?.a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {}]}, "expect": {"value": [1, null], "steps": 4, "allocated": 3}},
  {"name": "?. on a null element gives one null", "source": "xs[*]?.a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, null]}, "expect": {"value": [1, null], "steps": 3, "allocated": 3}},
  {"name": "a plain read on a null element fails", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, null]}, "expect": {"phase": "run", "diagnostics": [{"code": "null-operand", "span": [1, 1, 1, 8], "class": "dynamic", "message": "cannot read field a of null"}], "steps": 3, "allocated": 0}},
  {"name": "?. that finds an absent field, then a plain read, fails", "source": "xs[*]?.a.b", "env": "{xs: any}", "vars": {"xs": [{"a": {"b": 1}}, {}]}, "expect": {"phase": "run", "diagnostics": [{"code": "null-operand", "span": [1, 1, 1, 11], "class": "dynamic", "message": "cannot read field b of null"}], "steps": 5, "allocated": 0}},
  {"name": "?. that finds a null element skips the rest of the reads", "source": "xs[*]?.a.b", "env": "{xs: any}", "vars": {"xs": [{"a": {"b": 1}}, null]}, "expect": {"value": [1, null], "steps": 4, "allocated": 3}},
  {"name": "a field read on an element of the wrong kind", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, 5]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 8], "class": "dynamic", "message": "cannot read field a of a value of kind number"}], "steps": 3, "allocated": 0}},
  {"name": "?. on an element of the wrong kind still fails", "source": "xs[*]?.a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, "x"]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 9], "class": "dynamic", "message": "cannot read field a of a value of kind string"}], "steps": 3, "allocated": 0}},
  {"name": "a later [*] on null fails", "source": "xs[*].b[*]", "env": "{xs: any}", "vars": {"xs": [{"b": [1]}, {"b": null}]}, "expect": {"phase": "run", "diagnostics": [{"code": "null-operand", "span": [1, 1, 1, 11], "class": "dynamic", "message": "cannot apply [*] to null"}], "steps": 5, "allocated": 0}},
  {"name": "a later ?.[*] on null gives one null", "source": "xs[*].b?.[*]", "env": "{xs: any}", "vars": {"xs": [{"b": [1]}, {"b": null}]}, "expect": {"value": [1, null], "steps": 5, "allocated": 3}},
  {"name": "a later ?.[*] on a value that is not a list fails", "source": "xs[*].b?.[*]", "env": "{xs: any}", "vars": {"xs": [{"b": 5}]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 13], "class": "dynamic", "message": "cannot apply [*] to a value of kind number"}], "steps": 2, "allocated": 0}},
  {"name": "a later star on a map fails", "source": "xs[*].b[*]", "env": "{xs: any}", "vars": {"xs": [{"b": {"c": 1}}]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 11], "class": "dynamic", "message": "cannot apply [*] to a value of kind map"}], "steps": 2, "allocated": 0}},
  {"name": "a skip in level one passes over the later star", "source": "xs[*]?.b[*]", "env": "{xs: any}", "vars": {"xs": [{"b": [1, 2]}, null, {"b": [3]}]}, "expect": {"value": [1, 2, null, 3], "steps": 8, "allocated": 5}},
  {"name": "a skip inside level two", "source": "xs[*].b[*]?.c", "env": "{xs: any}", "vars": {"xs": [{"b": [{"c": 1}, null]}, {"b": [null]}]}, "expect": {"value": [1, null, null], "steps": 8, "allocated": 4}},
  {"name": "[*] on null fails", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": null}, "expect": {"phase": "run", "diagnostics": [{"code": "null-operand", "span": [1, 1, 1, 6], "class": "dynamic", "message": "cannot apply [*] to null"}], "steps": 0, "allocated": 0}},
  {"name": "?.[*] on null makes the chain null", "source": "xs?.[*].a", "env": "{xs: any}", "vars": {"xs": null}, "expect": {"value": null, "steps": 0, "allocated": 0}},
  {"name": "?.[*] on a list is a star", "source": "xs?.[*].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}]}, "expect": {"value": [1, 2], "steps": 4, "allocated": 3}},
  {"name": "a star on a map fails", "source": "xs[*]", "env": "{xs: any}", "vars": {"xs": {"a": 1}}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 6], "class": "dynamic", "message": "cannot apply [*] to a value of kind map"}], "steps": 0, "allocated": 0}},
  {"name": "a star on a map with a read after it fails at the star", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": {"a": 1}}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 6], "class": "dynamic", "message": "cannot apply [*] to a value of kind map"}], "steps": 0, "allocated": 0}},
  {"name": "a star on a string fails", "source": "xs[*]", "env": "{xs: any}", "vars": {"xs": "abc"}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 6], "class": "dynamic", "message": "cannot apply [*] to a value of kind string"}], "steps": 0, "allocated": 0}},
  {"name": "a star on a number fails", "source": "xs[*]", "env": "{xs: any}", "vars": {"xs": 5}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 6], "class": "dynamic", "message": "cannot apply [*] to a value of kind number"}], "steps": 0, "allocated": 0}},
  {"name": "a star on a bool fails", "source": "xs[*]", "env": "{xs: any}", "vars": {"xs": true}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 6], "class": "dynamic", "message": "cannot apply [*] to a value of kind bool"}], "steps": 0, "allocated": 0}},
  {"name": "?.[*] on a map fails: ?. forgives null only", "source": "xs?.[*]", "env": "{xs: any}", "vars": {"xs": {"a": 1}}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 8], "class": "dynamic", "message": "cannot apply [*] to a value of kind map"}], "steps": 0, "allocated": 0}},
  {"name": "?.[*] on the empty string fails", "source": "xs?.[*]", "env": "{xs: any}", "vars": {"xs": ""}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 8], "class": "dynamic", "message": "cannot apply [*] to a value of kind string"}], "steps": 0, "allocated": 0}},
  {"name": "reads before the star are a plain chain", "source": "m.items[*].n", "env": "{m: any}", "vars": {"m": {"items": [{"n": 1}, {"n": 2}]}}, "expect": {"value": [1, 2], "steps": 5, "allocated": 3}},
  {"name": "?. before the star makes the whole chain null", "source": "m?.items[*].n", "env": "{m: any}", "vars": {"m": null}, "expect": {"value": null, "steps": 0, "allocated": 0}},
  {"name": "?. that finds an absent key before a plain star", "source": "m?.items[*]", "env": "{m: any}", "vars": {"m": {}}, "expect": {"phase": "run", "diagnostics": [{"code": "null-operand", "span": [1, 1, 1, 12], "class": "dynamic", "message": "cannot apply [*] to null"}], "steps": 1, "allocated": 0}},
  {"name": "a string index inside a projection creates a string", "source": "xs[*][0]", "env": "{xs: any}", "vars": {"xs": ["ab", "c"]}, "expect": {"value": ["a", "c"], "steps": 4, "allocated": 5}},
  {"name": "a string index out of range inside a projection", "source": "xs[*][1]", "env": "{xs: any}", "vars": {"xs": ["ab", "c"]}, "expect": {"phase": "run", "diagnostics": [{"code": "index-range", "span": [1, 1, 1, 9], "class": "index", "message": "index 1 is outside the string of length 1"}], "steps": 4, "allocated": 1}},
  {"name": "an int index on a map element fails", "source": "xs[*][0]", "env": "{xs: any}", "vars": {"xs": [{"a": 1}]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 9], "class": "dynamic", "message": "a map key must be a string, found 0"}], "steps": 1, "allocated": 0}},
  {"name": "a string key on a list element fails", "source": "xs[*][\"a\"]", "env": "{xs: any}", "vars": {"xs": [[1]]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 11], "class": "dynamic", "message": "expected a whole number, found \"a\""}], "steps": 1, "allocated": 0}},
  {"name": "an index read on a number element fails", "source": "xs[*][0]", "env": "{xs: any}", "vars": {"xs": [7]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 9], "class": "dynamic", "message": "cannot index a value of kind number"}], "steps": 1, "allocated": 0}},
  {"name": "the null of a ?. read is kept among the values", "source": "xs[*].b?.c", "env": "{xs: any}", "vars": {"xs": [{"b": {"c": 1}}, {"b": {}}, {"b": {"c": 3}}]}, "expect": {"value": [1, null, 3], "steps": 9, "allocated": 4}},
  {"name": "a projection of the first optional read inside a level", "source": "xs[*].b?.c.d", "env": "{xs: any}", "vars": {"xs": [{"b": {"c": {"d": 1}}}, {"b": null}]}, "expect": {"value": [1, null], "steps": 6, "allocated": 3}},
  {"name": "null elements are copied by a star with no read", "source": "xs[*]", "env": "{xs: any}", "vars": {"xs": [null, 1, null]}, "expect": {"value": [null, 1, null], "steps": 3, "allocated": 4}},
  {"name": "a star over a list of lists with no read keeps the inner lists", "source": "xs[*]", "env": "{xs: any}", "vars": {"xs": [[1], []]}, "expect": {"value": [[1], []], "steps": 2, "allocated": 3}},
  {"name": "?.[*] later, over an empty list", "source": "xs[*].b?.[*]", "env": "{xs: any}", "vars": {"xs": [{"b": []}]}, "expect": {"value": [], "steps": 2, "allocated": 1}},
  {"name": "a method call ends the projection and receives the list", "source": "xs[*].a.sum()", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "expect": {"value": 6, "steps": 10, "allocated": 4}},
  {"name": "first after a projection", "source": "xs[*].a.first()", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "expect": {"value": 1, "steps": 7, "allocated": 4}},
  {"name": "a read of the result needs parentheses", "source": "(xs[*].a)[1]", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "expect": {"value": 2, "steps": 7, "allocated": 4}},
  {"name": "a read after the star is a step of the projection, not of the result", "source": "xs[*].a[1]", "env": "{xs: any}", "vars": {"xs": [{"a": [5]}, {"a": [6, 7]}]}, "expect": {"phase": "run", "diagnostics": [{"code": "index-range", "span": [1, 1, 1, 11], "class": "index", "message": "index 1 is outside the list of length 1"}], "steps": 3, "allocated": 0}},
  {"name": "a method of the list, not of the element, after a projection", "source": "xs[*].keys()", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "check": false, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 13], "class": "dynamic", "message": "a value of kind list has no method keys"}], "steps": 3, "allocated": 4}},
  {"name": "a method of the element is not reached", "source": "xs[*].email.toLowerCase()", "env": "{xs: any}", "vars": {"xs": [{"email": "A"}]}, "check": false, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 26], "class": "dynamic", "message": "a value of kind list has no method toLowerCase"}], "steps": 2, "allocated": 2}},
  {"name": "a star after a method call begins a new projection", "source": "xs.filter(x => x.ok)[*].id", "env": "{xs: any}", "vars": {"xs": [{"ok": true, "id": 1}, {"ok": false, "id": 2}, {"ok": true, "id": 3}]}, "expect": {"value": [1, 3], "steps": 15, "allocated": 6}},
  {"name": "an index expression is evaluated for each element", "source": "xs[*].b[i + 0]", "env": "{xs: any, i: any}", "vars": {"xs": [{"b": [5]}, {"b": [6]}], "i": 0}, "expect": {"value": [5, 6], "steps": 8, "allocated": 3}},
  {"name": "a projection inside an index expression", "source": "xs[*].b[ys[*].n.first()]", "env": "{xs: any, ys: any}", "vars": {"xs": [{"b": [5]}, {"b": [6]}], "ys": [{"n": 0}]}, "expect": {"value": [5, 6], "steps": 12, "allocated": 7}},
  {"name": "a projection in a template part", "source": "`${xs[*].a}`", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}]}, "expect": {"value": "[1,2]", "steps": 7, "allocated": 4}},
  {"name": "membership in a projection", "source": "2 in xs[*].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "expect": {"value": true, "steps": 8, "allocated": 4}},
  {"name": "the message of a failed read, caught", "source": "try { xs[*].a } catch (err) { err.message }", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {}]}, "expect": {"value": "the map has no field a", "steps": 6, "allocated": 10}},
  {"name": "the error value of a failed star", "source": "try { xs[*] } catch (err) { [err.code, err.message, err.path] }", "env": "{xs: any}", "vars": {"xs": {"a": 1}}, "expect": {"value": ["wrong-kind", "cannot apply [*] to a value of kind map", null], "steps": 4, "allocated": 14}},
  {"name": "the message of [*] on null, caught", "source": "try { xs[*] } catch (err) { err.message }", "env": "{xs: any}", "vars": {"xs": null}, "expect": {"value": "cannot apply [*] to null", "steps": 2, "allocated": 10}},
  {"name": "the message of a later star on a string, caught", "source": "try { xs[*][*] } catch (err) { err.message }", "env": "{xs: any}", "vars": {"xs": [[1], "ab"]}, "expect": {"value": "cannot apply [*] to a value of kind string", "steps": 5, "allocated": 10}},
  {"name": "a list literal as the receiver", "source": "[1, 2, 3][*]", "expect": {"value": [1, 2, 3], "steps": 3, "allocated": 8}},
  {"name": "a map literal as the primary", "source": "{a: [{b: 1}]}.a[*].b", "expect": {"value": [1], "steps": 3, "allocated": 10}},
  {"name": "the span of a step starts at the parenthesis of the primary", "source": "(xs)[*].a", "env": "{xs: any}", "vars": {"xs": [{}]}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 1, 10], "class": "dynamic", "message": "the map has no field a"}], "steps": 2, "allocated": 0}},
  {"name": "a step span across lines", "source": "xs\n  [*]\n  .a", "env": "{xs: any}", "vars": {"xs": [{}]}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 3, 5], "class": "dynamic", "message": "the map has no field a"}], "steps": 2, "allocated": 0}},
  {"name": "a projection bound by const, then indexed", "source": "const ys = xs[*].a; ys[1]", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "expect": {"value": 2, "steps": 7, "allocated": 4}},
  {"name": "a projection compared with ==", "source": "xs[*].a == [1, 2, 3]", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "expect": {"value": true, "steps": 12, "allocated": 8}},
  {"name": "?.[*] on null makes the whole chain null, method calls included", "source": "xs?.[*].a.sum()", "env": "{xs: any}", "vars": {"xs": null}, "expect": {"value": null, "steps": 0, "allocated": 0}},
  {"name": "a ?. inside the projection does not skip the method call after it", "source": "xs[*]?.a.sum()", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, null]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 15], "class": "dynamic", "message": "sum cannot take an element of kind null"}], "steps": 6, "allocated": 3}},
  {"name": "a projection inside a lambda body", "source": "ys.map(y => y.b[*].c)", "env": "{ys: any}", "vars": {"ys": [{"b": [{"c": 1}]}, {"b": []}]}, "expect": {"value": [[1], []], "steps": 10, "allocated": 6}},
  {"name": "a word that is reserved may follow . in a projection", "source": "xs[*].if", "env": "{xs: any}", "vars": {"xs": [{"if": 1}, {"if": 2}]}, "expect": {"value": [1, 2], "steps": 4, "allocated": 3}},
  {"name": "a typed projection that breaks its declared type", "source": "xs[*].a", "env": "{xs: {a: int}[]}", "vars": {"xs": [{"a": 1}, {}]}, "precondition": false, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 1, 8], "class": "environment", "message": "the map has no field a"}], "steps": 4, "allocated": 0}}
]
