[
  {"name": "cost: one star, three elements", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "expect": {"value": [1, 2, 3], "steps": 6, "allocated": 4}},
  {"name": "cost: a field word of 64 code points", "source": "xs[*].aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "env": "{xs: any}", "vars": {"xs": [{"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 1}, {"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 2}]}, "expect": {"value": [1, 2], "steps": 6, "allocated": 3}},
  {"name": "cost: a field word of 63 code points", "source": "xs[*].aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "env": "{xs: any}", "vars": {"xs": [{"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 1}, {"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 2}]}, "expect": {"value": [1, 2], "steps": 4, "allocated": 3}},
  {"name": "cost: a string key of 64 code points", "source": "xs[*][\"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk\"]", "env": "{xs: any}", "vars": {"xs": [{"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk": 1}]}, "expect": {"value": [1], "steps": 3, "allocated": 2}},
  {"name": "cost: a string index on a string of weight 64", "source": "xs[*][1]", "env": "{xs: any}", "vars": {"xs": ["abababababababababababababababababababababababababababababababab", "c"]}, "expect": {"phase": "run", "diagnostics": [{"code": "index-range", "span": [1, 1, 1, 9], "class": "index", "message": "index 1 is outside the string of length 1"}], "steps": 5, "allocated": 1}},
  {"name": "cost: a string index on 32 code points above U+FFFF", "source": "xs[*][0]", "env": "{xs: any}", "vars": {"xs": ["😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀"]}, "expect": {"value": ["😀"], "steps": 3, "allocated": 3}},
  {"name": "cost: the nested worked count Q4", "source": "orders[*].lines[*].sku", "env": "{orders: any}", "vars": {"orders": [{"lines": [{"sku": "a"}, {"sku": "b"}]}, {"lines": []}, {"lines": [{"sku": "c"}, {"sku": "d"}, {"sku": "e"}, {"sku": "f"}]}]}, "expect": {"value": ["a", "b", "c", "d", "e", "f"], "steps": 18, "allocated": 7}},
  {"name": "cost: the nested worked count Q5, with a null", "source": "orders[*].lines?.[*].sku", "env": "{orders: any}", "vars": {"orders": [{"lines": [{"sku": "a"}, {"sku": "b"}]}, {"lines": null}, {"lines": [{"sku": "c"}, {"sku": "d"}, {"sku": "e"}, {"sku": "f"}]}]}, "expect": {"value": ["a", "b", null, "c", "d", "e", "f"], "steps": 18, "allocated": 8}},
  {"name": "cost: ?. that skips charges nothing for the reads it skips", "source": "xs[*]?.a.b.c", "env": "{xs: any}", "vars": {"xs": [null, null, {"a": {"b": {"c": 1}}}]}, "expect": {"value": [null, null, 1], "steps": 6, "allocated": 4}},
  {"name": "cost: a failure part way keeps the steps, and no units for the result", "source": "xs[*].a.b", "env": "{xs: any}", "vars": {"xs": [{"a": {"b": 1}}, {"a": 2}]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 10], "class": "dynamic", "message": "cannot read field b of a value of kind number"}], "steps": 5, "allocated": 0}},
  {"name": "cost: a star test that fails charges nothing", "source": "xs[*][*]", "env": "{xs: any}", "vars": {"xs": [[1, 2], {}]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 9], "class": "dynamic", "message": "cannot apply [*] to a value of kind map"}], "steps": 4, "allocated": 0}},
  {"name": "cost: ?.[*] on null charges nothing", "source": "xs?.[*].a.b", "env": "{xs: any}", "vars": {"xs": null}, "expect": {"value": null, "steps": 0, "allocated": 0}},
