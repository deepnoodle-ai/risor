  {"name": "steps-exceeded during the visits", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "limits": {"steps": 5}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded"}]}},
  {"name": "the projection within a step limit of its count", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "limits": {"steps": 6}, "expect": {"value": [1, 2, 3], "steps": 6, "allocated": 4}},
  {"name": "allocation-exceeded at the result", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "limits": {"allocation": 3}, "expect": {"phase": "run", "diagnostics": [{"code": "allocation-exceeded"}]}},
  {"name": "the projection within an allocation limit of its count", "source": "xs[*].a", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "limits": {"allocation": 4}, "expect": {"value": [1, 2, 3], "steps": 6, "allocated": 4}},
  {"name": "a call inside a projection stands a level deeper for the star", "source": "const g = x => x; xs[*].b[g(0)]", "env": "{xs: any}", "vars": {"xs": [{"b": [7]}]}, "limits": {"depth": 2}, "expect": {"phase": "run", "diagnostics": [{"code": "depth-exceeded"}]}},
  {"name": "the same call within a depth limit of 3", "source": "const g = x => x; xs[*].b[g(0)]", "env": "{xs: any}", "vars": {"xs": [{"b": [7]}]}, "limits": {"depth": 3}, "expect": {"value": [7], "steps": 5, "allocated": 2}},
  {"name": "without a star the same call is one level shallower", "source": "const g = x => x; xs[0].b[g(0)]", "env": "{xs: any}", "vars": {"xs": [{"b": [7]}]}, "limits": {"depth": 2}, "expect": {"value": 7, "steps": 5, "allocated": 0}},
  {"name": "a star in progress adds nothing to the depth count", "source": "xs[*][*][*].a", "env": "{xs: any}", "vars": {"xs": [[[{"a": 1}]]]}, "limits": {"depth": 1}, "expect": {"value": [1], "steps": 4, "allocated": 2}},
  {"name": "worked count Q2: the map form", "source": "xs.map(x => x.a)", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "expect": {"value": [1, 2, 3], "steps": 11, "allocated": 4}},
  {"name": "worked count Q9: the flatMap form", "source": "orders.flatMap(o => o.lines).map(l => l.sku)", "env": "{orders: any}", "vars": {"orders": [{"lines": [{"sku": "a"}, {"sku": "b"}]}, {"lines": []}, {"lines": [{"sku": "c"}, {"sku": "d"}, {"sku": "e"}, {"sku": "f"}]}]}, "expect": {"value": ["a", "b", "c", "d", "e", "f"], "steps": 37, "allocated": 14}},
  {"name": "worked count Q7", "source": "xs[*].a.sum()", "env": "{xs: any}", "vars": {"xs": [{"a": 1}, {"a": 2}, {"a": 3}]}, "expect": {"value": 6, "steps": 10, "allocated": 4}},
  {"name": "the index expression of a skipped read is not evaluated", "source": "xs[*]?.b[i + 1]", "env": "{xs: any, i: any}", "vars": {"xs": [null, {"b": [5, 6]}], "i": 0}, "expect": {"value": [null, 6], "steps": 5, "allocated": 3}}
