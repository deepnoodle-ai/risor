{
 "cases": [
  {
   "name": "library functions are calls",
   "source": "len(xs) > 0 ? xs[0] : fail(\"empty\")",
   "expect": {
    "analysis": {
     "names": [
      "xs"
     ],
     "calls": [
      {
       "name": "len",
       "namespace": null,
       "span": [
        1,
        1,
        1,
        8
       ],
       "args": [
        [
         1,
         5,
         1,
         7
        ]
       ],
       "lambda": false
      },
      {
       "name": "fail",
       "namespace": null,
       "span": [
        1,
        23,
        1,
        36
       ],
       "args": [
        [
         1,
         28,
         1,
         35
        ]
       ],
       "lambda": false
      }
     ]
    }
   }
  },
  {
   "name": "a call in a namespace has the form of a method call",
   "source": "geo.distance(a, b) > limit",
   "expect": {
    "analysis": {
     "names": [
      "a",
      "b",
      "geo",
      "limit"
     ],
     "refs": [
      {
       "name": "geo",
       "path": [],
       "span": [
        1,
        1,
        1,
        4
       ]
      },
      {
       "name": "a",
       "path": [],
       "span": [
        1,
        14,
        1,
        15
       ]
      },
      {
       "name": "b",
       "path": [],
       "span": [
        1,
        17,
        1,
        18
       ]
      },
      {
       "name": "limit",
       "path": [],
       "span": [
        1,
        22,
        1,
        27
       ]
      }
     ],
     "calls": [
      {
       "name": "geo.distance",
       "namespace": "geo",
       "span": [
        1,
        1,
        1,
        19
       ],
       "args": [
        [
         1,
         14,
         1,
         15
        ],
        [
         1,
         17,
         1,
         18
        ]
       ],
       "lambda": false
      }
     ]
    }
   }
  },
  {
   "name": "an optional step is not a call of a namespace",
   "source": "geo?.distance(a)",
   "expect": {
    "analysis": {
     "names": [
      "a",
      "geo"
     ],
     "calls": []
    }
   }
  },
  {
   "name": "a step after the call",
   "source": "geo.distance(a).km",
   "expect": {
    "analysis": {
     "calls": [
      {
       "name": "geo.distance",
       "namespace": "geo",
       "span": [
        1,
        1,
        1,
        16
       ],
       "args": [
        [
         1,
         14,
         1,
         15
        ]
       ],
       "lambda": false
      }
     ]
    }
   }
  },
  {
   "name": "only the first method call of a free name",
   "source": "x.m(a)?.n(b)",
   "expect": {
    "analysis": {
     "names": [
      "a",
      "b",
      "x"
     ],
     "calls": [
      {
       "name": "x.m",
       "namespace": "x",
       "span": [
        1,
        1,
        1,
        7
       ],
       "args": [
        [
         1,
         5,
         1,
         6
        ]
       ],
       "lambda": false
      }
     ]
    }
   }
  },
  {
   "name": "a field read is not a call",
   "source": "n.m",
   "expect": {
    "analysis": {
     "refs": [
      {
       "name": "n",
       "path": [
        "m"
       ],
       "span": [
        1,
        1,
        1,
        4
       ]
      }
     ],
     "calls": []
    }
   }
  },
  {
   "name": "a bound receiver is not a call",
   "source": "const geo = 1; geo.distance(a)",
   "expect": {
    "analysis": {
     "names": [
      "a"
     ],
     "calls": []
    }
   }
  },
  {
   "name": "a call inside a lambda",
   "source": "xs.map(x => lookup(x.id))",
