   "expect": {
    "analysis": {
     "names": [
      "xs"
     ],
     "refs": [
      {
       "name": "xs",
       "path": [],
       "span": [
        1,
        28,
        1,
        30
       ]
      }
     ]
    }
   }
  },
  {
   "name": "a read in a template literal",
   "source": "`a ${b} c`",
   "expect": {
    "analysis": {
     "names": [
      "b"
     ],
     "refs": [
      {
       "name": "b",
       "path": [],
