   "expect": {
    "analysis": {
     "names": [
      "len",
      "xs"
     ],
     "refs": [
      {
       "name": "xs",
       "path": [],
       "span": [
        1,
        1,
        1,
        3
       ]
      },
      {
       "name": "len",
       "path": [],
       "span": [
        1,
        8,
        1,
        11
       ]
      }
     ]
    }
   }
  },
  {
   "name": "a const-bound lambda passed by name is not a read",
