[
  {"name": "a call of its own name has the result type", "source": "const f = (n: int): int[] => n <= 0 ? [] : [n, ...f(n - 1)]; f(3)", "expect": {"sites":[],"type":"int[]"}},
  {"name": "the result type stands for a call of its own name, not the body's type", "source": "const f = (n: int): int | null => n <= 0 ? null : f(n - 1) + 1; f(2)", "expect": {"diagnostics":[{"code":"maybe-null","message":"f(n - 1) may be null; its type is int | null","span":[1,51,1,59]}],"phase":"check"}},
  {"name": "result-mismatch at the body", "source": "const f = (n: int): string => n <= 0 ? 0 : f(n - 1); f(2)", "expect": {"diagnostics":[{"code":"result-mismatch","message":"expected string, found int","span":[1,40,1,41]}],"phase":"check"}},
  {"name": "arg-mismatch at a call of its own name", "source": "const f = (s: string): int => s == \"\" ? 0 : f(1); f(\"a\")", "expect": {"diagnostics":[{"code":"arg-mismatch","message":"expected string, found int","span":[1,47,1,48]}],"phase":"check"}},
  {"name": "arg-mismatch: any does not surely fit a parameter's type", "source": "const f = (n: int, x: any): int => n <= 0 ? 0 : f(x, x); f(1, 1)", "expect": {"diagnostics":[{"code":"arg-mismatch","message":"expected int, found any","span":[1,51,1,52]}],"phase":"check"}},
  {"name": "a parameter with a default takes null", "source": "const f = (n: int = 0): int => n <= 0 ? 0 : f(null); f(2)", "expect": {"sites":[],"type":"int"}},
  {"name": "its own name given to map: the element must fit its parameter", "source": "const f = (s: string): int => len([1].map(f)); f(\"a\")", "expect": {"diagnostics":[{"code":"arg-mismatch","message":"expected string, found int","span":[1,15,1,21]}],"phase":"check"}},
  {"name": "its own name given to map: the result type is the element type", "source": "const f = (n: int): int[] => n <= 0 ? [] : [n - 1].map(f)[0]; f(2)", "expect": {"sites":[{"class":"index","span":[1,44,1,61]}],"type":"int[]"}},
  {"name": "its own name given to flatMap", "source": "const f = (n: int): int[] => n <= 0 ? [0] : [n - 1].flatMap(f); f(2)", "expect": {"sites":[],"type":"int[]"}},
  {"name": "its own name given to filter", "source": "const f = (n: int): bool => n <= 0 || len([n - 1].filter(f)) > 0; f(3)", "expect": {"sites":[],"type":"bool"}},
  {"name": "its own name given to reduce", "source": "const f = (a: int, b: int): int => b <= 0 ? a : [b - 1].reduce(f, a + b); f(0, 4)", "expect": {"sites":[],"type":"int"}},
  {"name": "its own name given to reduce: the accumulator must fit", "source": "const f = (a: string, b: int): string => [b].reduce(f, 1); f(\"a\", 1)", "expect": {"diagnostics":[{"code":"arg-mismatch","message":"expected string, found int | string","span":[1,15,1,21]},{"code":"result-mismatch","message":"expected string, found int | string","span":[1,42,1,58]}],"phase":"check"}},
  {"name": "its own name given to a method on any", "source": "const f = (x: any): any => x.map(f); f([1])", "expect": {"sites":[{"class":"dynamic","span":[1,28,1,29]}],"type":"any"}},
  {"name": "its own name given to a method on any: any does not surely fit int", "source": "const f = (n: int): any => y.map(f); f(1)", "env": "{y: any}", "expect": {"diagnostics":[{"code":"arg-mismatch","message":"expected int, found any","span":[1,15,1,18]}],"phase":"check"}},
  {"name": "a parameter with a function type takes no value", "source": "const f = (g: (x: int) => int, n: int): int => n <= 0 ? 0 : f(g, n - 1); 1", "expect": {"diagnostics":[{"code":"arg-mismatch","message":"parameter g of f takes a function","span":[1,63,1,64]}],"phase":"check"}},
  {"name": "the body is checked once: its sites", "source": "const f = (xs: int[]): int => len(xs) == 0 ? 0 : xs[0] + f(xs.slice(1)); f([1, 2])", "expect": {"sites":[{"class":"index","span":[1,50,1,55]}],"type":"int"}},
  {"name": "a narrowed argument fits", "source": "const f = (n: int | null): int => n == null ? 0 : f(n > 0 ? n - 1 : null) + 1; f(2)", "expect": {"sites":[],"type":"int"}},
  {"name": "a call of its own name in a lambda inside it has the result type", "source": "const f = (n: int): string => n <= 0 ? \"\" : [n].map(k => f(k - 1))[0]; f(2)", "expect": {"sites":[{"class":"index","span":[1,45,1,70]}],"type":"string"}},
