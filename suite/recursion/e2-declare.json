 {
  "name": "a schema's $ref cycle is a recursive type, named by the pointer's last token",
  "schemas": {
   "t": {
    "schema": {
     "$defs": {
      "node": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string"
        },
        "kids": {
         "type": "array",
         "items": {
          "$ref": "#/$defs/node"
         }
        }
       },
       "required": [
        "name",
        "kids"
       ],
       "additionalProperties": false
      }
     },
     "$ref": "#/$defs/node"
    }
   }
  },
  "source": "t.kids",
  "expect": {
   "type": "Node[]",
   "sites": []
  }
 },
 {
  "name": "a schema's $ref to its root is named by the variable",
