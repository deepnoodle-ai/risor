[
 {
  "name": "a named type names itself",
  "types": [
   {
    "name": "Tree",
    "type": "{kids: Tree[]}"
   }
  ],
  "env": "{t: Tree}",
  "vars": {
   "t": {
    "kids": []
   }
  },
  "source": "t.kids",
  "expect": {
   "type": "Tree[]",
   "value": []
  }
 },
 {
  "name": "two named types name each other",
  "types": [
   {
    "name": "Dir",
    "type": "{files: File[], dirs: Dir[]}"
   },
   {
    "name": "File",
    "type": "{name: string, parent: Dir | null}"
   }
  ],
  "env": "{d: Dir}",
  "vars": {
   "d": {
    "files": [
     {
      "name": "a",
      "parent": null
     }
    ],
    "dirs": []
   }
  },
  "source": "d.files[0].parent",
  "expect": {
   "type": "Dir | null",
   "value": null
  }
 },
 {
  "name": "a named type names a later one at its top",
  "types": [
   {
    "name": "Maybe",
    "type": "Cell | null"
   },
   {
    "name": "Cell",
    "type": "{head: int, tail: Maybe}"
   }
  ],
  "env": "{m: Maybe}",
  "vars": {
   "m": {
    "head": 1,
    "tail": null
   }
  },
  "source": "m?.tail",
  "expect": {
   "type": "Maybe | null",
   "value": null
  }
 },
 {
  "name": "bad-type: a named type that is itself or null",
  "types": [
   {
    "name": "Loop",
    "type": "Loop | null"
   }
  ],
  "source": "1",
  "expect": {
   "phase": "declare",
   "diagnostics": [
    {
     "code": "bad-type"
    }
   ]
  }
 },
 {
  "name": "bad-type: a named type that is itself, beside a record that names it",
