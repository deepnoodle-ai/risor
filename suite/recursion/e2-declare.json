    "version": "3.0",
    "functions": {},
    "opaque": {},
    "removed": [],
    "reject": [
     "constant-condition"
    ],
    "limits": {
     "steps": 1000000,
     "allocation": 1000000,
     "depth": 200
    },
    "variables": {
     "t": "Tree",
     "ts": "Tree[]"
    },
    "types": {
     "Tree": "{kids: Tree[]}"
    }
   }
  }
 },
