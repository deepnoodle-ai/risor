[
  {"name": "the type of a walk of an int", "source": "walk(1, x => null)", "expect": {"type": "int[]", "sites": []}},
  {"name": "the type of a walk of null", "source": "walk(null, x => null)", "expect": {"type": "null[]", "sites": []}},
  {"name": "the depth parameter is an int", "source": "walk(1, (x, d) => d > 0 ? null : [d])", "expect": {"type": "int[]", "sites": []}},
  {"name": "the seed rule widens T by the children's element type", "source": "walk(1, x => [\"a\"])", "expect": {"type": "(int | \"a\")[]", "sites": []}},
  {"name": "the seed rule fires on a fit that used any", "source": "walk(d, x => x.subs)", "env": "{d: {name: string, subs: {name: string, subs: any[]}[]}}", "expect": {"type": "{name: string, subs: any[]}[]", "sites": [{"class": "dynamic", "span": [1, 14, 1, 20]}]}},
  {"name": "a tree with three typed levels", "source": "walk(n, x => x.kids)", "env": "{n: {name: string, kids: {name: string, kids: {name: string, kids: any[]}[]}[]}}", "expect": {"type": "{kids: {kids: any[], name: string}[], name: string}[]", "sites": [{"class": "dynamic", "span": [1, 14, 1, 20]}]}},
  {"name": "a walk of any", "source": "walk(t, x => x.kids)", "env": "{t: any}", "expect": {"type": "any[]", "sites": [{"class": "dynamic", "span": [1, 14, 1, 15]}, {"class": "dynamic", "span": [1, 14, 1, 20]}]}},
  {"name": "a walk of any in strict mode", "source": "walk(t, x => x.kids)", "env": "{t: any}", "reject": ["constant-condition", "dynamic"], "expect": {"phase": "check", "diagnostics": [{"code": "unchecked", "span": [1, 14, 1, 15], "message": "the check cannot show the kind of x, and this environment rejects dynamic sites"}]}},
  {"name": "a body that is not a list", "source": "walk(0, x => x)", "expect": {"phase": "check", "diagnostics": [{"code": "arg-mismatch", "span": [1, 14, 1, 15], "message": "the function given to walk gives int, which does not fit int[] | null"}]}},
  {"name": "a body that is a list and a number", "source": "walk(t, x => if (x == 0) { 1 / x } else { [x - 1] })", "env": "{t: int}", "expect": {"phase": "check", "diagnostics": [{"code": "arg-mismatch", "span": [1, 14, 1, 52], "message": "the function given to walk gives float | int[], which does not fit int[] | null"}]}},
  {"name": "a value at children", "source": "walk(t, 5)", "env": "{t: any}", "expect": {"phase": "check", "diagnostics": [{"code": "arg-mismatch", "span": [1, 9, 1, 10], "message": "parameter children of walk takes a function"}]}},
  {"name": "a lambda at root", "source": "walk(x => 1, x => null)", "expect": {"phase": "check", "diagnostics": [{"code": "not-a-value", "span": [1, 6, 1, 12], "message": "a function cannot stand at parameter root of walk, which takes a value"}, {"code": "cannot-infer", "span": [1, 14, 1, 23], "message": "the types of the parameters of this function cannot be inferred from the call of walk"}]}},
  {"name": "a body that never returns", "source": "walk(1, x => fail(\"no\"))", "expect": {"type": "int[]", "sites": [{"class": "value", "span": [1, 14, 1, 24]}]}},
  {"name": "a walk of records", "source": "walk(t, x => x.kids)", "env": "{t: {id: int, kids: never[]}}", "expect": {"type": "{id: int, kids: never[]}[]", "sites": []}},
  {"name": "a checked walk of any data runs", "source": "walk(t, x => x.kids).map(x => x.n)", "env": "{t: any}", "vars": {"t": {"n": "a", "kids": [{"n": "b", "kids": []}, {"n": "c", "kids": [{"n": "d", "kids": []}]}]}}, "expect": {"type": "any[]", "sites": [{"class": "dynamic", "span": [1, 14, 1, 15]}, {"class": "dynamic", "span": [1, 14, 1, 20]}, {"class": "dynamic", "span": [1, 31, 1, 32]}], "value": ["a", "b", "c", "d"], "steps": 28, "allocated": 10}}
]
