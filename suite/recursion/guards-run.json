[
  {"name": "a falsy guard passes to the next arm", "source": "match x { 1 if (y > 0) => \"a\", 1 => \"b\", _ => \"c\" }", "env": "{x: int, y: int}", "vars": {"x": 1, "y": 0}, "expect": {"value": "b", "steps": 3, "allocated": 0}},
  {"name": "a truthy guard takes its arm", "source": "match x { 1 if (y > 0) => \"a\", 1 => \"b\", _ => \"c\" }", "env": "{x: int, y: int}", "vars": {"x": 1, "y": 1}, "expect": {"value": "a", "steps": 2, "allocated": 0}},
  {"name": "a guard is not evaluated when no literal of its arm matched", "source": "match x { 1 if (y > 0) => \"a\", 1 => \"b\", _ => \"c\" }", "env": "{x: int, y: int}", "vars": {"x": 2, "y": 1}, "expect": {"value": "c", "steps": 3, "allocated": 0}},
  {"name": "a guard whose arm did not match charges nothing and does not fail", "source": "match x { 1 if (1 / y > 0) => \"a\", _ => \"b\" }", "env": "{x: int, y: int}", "vars": {"x": 2, "y": 0}, "expect": {"value": "b", "steps": 2, "allocated": 0}},
  {"name": "a guard on _", "source": "match x { _ if (x > 5) => \"big\", _ => \"small\" }", "env": "{x: int}", "vars": {"x": 1}, "expect": {"value": "small", "steps": 3, "allocated": 0}},
  {"name": "a guard on _ that is truthy", "source": "match x { _ if (x > 5) => \"big\", _ => \"small\" }", "env": "{x: int}", "vars": {"x": 9}, "expect": {"value": "big", "steps": 2, "allocated": 0}},
  {"name": "a guard belongs to every literal of its arm", "source": "match s { \"held\" | \"late\" if (p) => \"escalate\", _ => \"wait\" }", "env": "{s: string, p: bool}", "vars": {"s": "late", "p": true}, "expect": {"value": "escalate", "steps": 1, "allocated": 0}},
  {"name": "a guard of several literals that is falsy", "source": "match s { \"held\" | \"late\" if (p) => \"escalate\", _ => \"wait\" }", "env": "{s: string, p: bool}", "vars": {"s": "held", "p": false}, "expect": {"value": "wait", "steps": 2, "allocated": 0}},
  {"name": "the example of the grammar", "source": "match order.status {\n  \"open\" if (order.total > 1000) => \"review\",\n  \"open\" => \"ship\",\n  \"held\" | \"late\" if (order.priority) => \"escalate\",\n  _ => \"wait\",\n}", "env": "{order: {status: string, total: int, priority: bool}}", "vars": {"order": {"status": "open", "total": 1500, "priority": false}}, "expect": {"value": "review", "steps": 4, "allocated": 0}},
  {"name": "the example of the grammar, a small order", "source": "match order.status {\n  \"open\" if (order.total > 1000) => \"review\",\n  \"open\" => \"ship\",\n  \"held\" | \"late\" if (order.priority) => \"escalate\",\n  _ => \"wait\",\n}", "env": "{order: {status: string, total: int, priority: bool}}", "vars": {"order": {"status": "open", "total": 10, "priority": false}}, "expect": {"value": "ship", "steps": 5, "allocated": 0}},
  {"name": "a failure in a guard is the failure of the match", "source": "match x { 1 if (1 / y > 0) => \"a\", _ => \"b\" }", "env": "{x: int, y: int}", "vars": {"x": 1, "y": 0}, "expect": {"phase": "run", "diagnostics": [{"code": "divide-by-zero", "span": [1, 17, 1, 22], "class": "divide", "message": "the divisor of / is zero"}], "steps": 2, "allocated": 0}},
  {"name": "no arm taken after a falsy guard", "source": "match x { 1 if (y > 0) => \"a\" }", "env": "{x: int, y: int}", "vars": {"x": 1, "y": 0}, "check": false, "expect": {"phase": "run", "diagnostics": [{"code": "no-match", "span": [1, 1, 1, 32], "class": "dynamic", "message": "the match has no arm for 1"}], "steps": 2, "allocated": 0}},
  {"name": "a guard tests truthiness: an empty list is falsy", "source": "match x { 1 if (xs) => \"some\", _ => \"none\" }", "env": "{x: int, xs: int[]}", "vars": {"x": 1, "xs": []}, "expect": {"value": "none", "steps": 2, "allocated": 0}},
  {"name": "a guard tests truthiness: null is falsy", "source": "match x { 1 if (u) => \"some\", _ => \"none\" }", "env": "{x: int, u: int | null}", "vars": {"x": 1, "u": null}, "expect": {"value": "none", "steps": 2, "allocated": 0}},
  {"name": "a guard tests truthiness: zero is falsy", "source": "match x { 1 if (u) => \"some\", _ => \"none\" }", "env": "{x: int, u: int | null}", "vars": {"x": 1, "u": 0}, "expect": {"value": "none", "steps": 2, "allocated": 0}},
  {"name": "a guard tests truthiness: a non-empty string is truthy", "source": "match x { 1 if (s) => \"some\", _ => \"none\" }", "env": "{x: int, s: string}", "vars": {"x": 1, "s": "a"}, "expect": {"value": "some", "steps": 1, "allocated": 0}},
  {"name": "a guard may call a library entry with a lambda", "source": "match x { 1 if (xs.some(v => v > 2)) => \"big\", _ => \"small\" }", "env": "{x: int, xs: int[]}", "vars": {"x": 1, "xs": [1, 3]}, "expect": {"value": "big", "steps": 9, "allocated": 0}},
  {"name": "a guard may hold a match", "source": "match x { 1 if (match y { 0 => false, _ => true }) => \"a\", _ => \"b\" }", "env": "{x: int, y: int}", "vars": {"x": 1, "y": 0}, "expect": {"value": "b", "steps": 3, "allocated": 0}},
  {"name": "a guard in a lambda reads its parameter", "source": "[1, 2, 3].map(v => match v { 1 if (v < n) => \"low\", _ => \"other\" })", "env": "{n: int}", "vars": {"n": 2}, "expect": {"value": ["low", "other", "other"], "steps": 14, "allocated": 8}},
  {"name": "a string literal charges its prefix before the guard", "source": "match s { \"open\" if (n > 1000) => \"review\", \"open\" => \"ship\", _ => \"wait\" }", "env": "{s: string, n: int}", "vars": {"s": "open", "n": 5}, "expect": {"value": "ship", "steps": 3, "allocated": 0}},
  {"name": "a literal of an earlier guarded arm may be listed again", "source": "match x { 1 if (c) => \"a\", 1 => \"b\", _ => \"c\" }", "env": "{x: int, c: bool}", "vars": {"x": 1, "c": false}, "expect": {"value": "b", "steps": 2, "allocated": 0}},
  {"name": "a guarded _ does not make later arms unreachable", "source": "match x { _ if (c) => 1, 2 => 3, _ => 4 }", "env": "{x: int, c: bool}", "vars": {"x": 2, "c": false}, "expect": {"value": 3, "steps": 2, "allocated": 0}},
  {"name": "a plain _ after a guarded _", "source": "match x { _ if (c) => 1, _ => 2 }", "env": "{x: int, c: bool}", "vars": {"x": 2, "c": false}, "expect": {"value": 2, "steps": 2, "allocated": 0}},
  {"name": "a call in a guard stands inside two levels", "source": "match x { 1 if (xs.some(v => v > 0)) => 1, _ => 0 }", "env": "{x: int, xs: int[]}", "vars": {"x": 1, "xs": [1]}, "limits": {"depth": 3}, "expect": {"value": 1, "steps": 6, "allocated": 0}},
  {"name": "a call in a guard passes a depth limit of 2", "source": "match x { 1 if (xs.some(v => v > 0)) => 1, _ => 0 }", "env": "{x: int, xs: int[]}", "vars": {"x": 1, "xs": [1]}, "limits": {"depth": 2}, "expect": {"phase": "run", "diagnostics": [{"code": "depth-exceeded", "class": "limit", "message": "calls and nested values went deeper than the depth limit of 2"}]}},
  {"name": "the same call in the result stands inside one level", "source": "match x { 1 => xs.some(v => v > 0), _ => false }", "env": "{x: int, xs: int[]}", "vars": {"x": 1, "xs": [1]}, "limits": {"depth": 2}, "expect": {"value": true, "steps": 6, "allocated": 0}},
  {"name": "a guard's failure is caught by try", "source": "try { match x { 1 if (1 / y > 0) => \"a\", _ => \"b\" } } catch { \"caught\" }", "env": "{x: int, y: int}", "vars": {"x": 1, "y": 0}, "expect": {"value": "caught", "steps": 2, "allocated": 0}},
  {"name": "a literal listed again after a plain arm is duplicate-case", "source": "match x { 1 => \"a\", 1 if (c) => \"b\", _ => \"c\" }", "env": "{x: int, c: bool}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-case", "span": [1, 21, 1, 22], "message": "1 is listed twice in this match"}]}},
  {"name": "a literal listed twice in a guarded arm is duplicate-case", "source": "match x { 1 | 1 if (c) => \"a\", _ => \"b\" }", "env": "{x: int, c: bool}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-case", "span": [1, 15, 1, 16], "message": "1 is listed twice in this match"}]}},
  {"name": "a guarded arm after a plain _ is unreachable", "source": "match x { _ => 1, 2 if (c) => 3 }", "env": "{x: int, c: bool}", "expect": {"phase": "check", "diagnostics": [{"code": "unreachable-arm", "span": [1, 19, 1, 32], "message": "this arm comes after _ and is never chosen"}]}},
  {"name": "a guarded _ after a plain _ is unreachable", "source": "match x { _ => 1, _ if (c) => 3 }", "env": "{x: int, c: bool}", "expect": {"phase": "check", "diagnostics": [{"code": "unreachable-arm", "span": [1, 19, 1, 32], "message": "this arm comes after _ and is never chosen"}]}},
  {"name": "a name in a guard is resolved", "source": "match x { 1 if (nope) => 1, _ => 0 }", "env": "{x: int}", "expect": {"phase": "check", "diagnostics": [{"code": "undefined-name", "span": [1, 17, 1, 21], "message": "nope is not defined"}]}},
  {"name": "the static rules of an arm come before those of its guard", "source": "match x { _ => 1, 1 | 1 if (nope) => 2 }", "env": "{x: int}", "expect": {"phase": "check", "diagnostics": [{"code": "unreachable-arm", "span": [1, 19, 1, 39], "message": "this arm comes after _ and is never chosen"}, {"code": "duplicate-case", "span": [1, 23, 1, 24], "message": "1 is listed twice in this match"}, {"code": "undefined-name", "span": [1, 29, 1, 33], "message": "nope is not defined"}]}}
]
