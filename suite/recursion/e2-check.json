  "expect": {
   "type": "Right"
  }
 },
 {
  "name": "a join where the first fits the second gives the second",
  "source": "type Left = {next: Left[]}; type Right = {next: Right[]}; const a: Left = {next: []}; const b: Right = {next: []}; [a, b]",
  "expect": {
   "type": "Right[]"
  }
 },
 {
  "name": "a join where the first fits the second gives the second, the other way",
  "source": "type Left = {next: Left[]}; type Right = {next: Right[]}; const a: Left = {next: []}; const b: Right = {next: []}; [b, a]",
  "expect": {
   "type": "Left[]"
  }
 },
