    }
   ]
  }
 },
 {
  "name": "use 2: a wrong field of a child names the type",
  "source": "type Node = {name: string, kids: Node[]}; const f = (n: Node): string => n.kids[0].nam; 1",
  "expect": {
   "phase": "check",
   "diagnostics": [
    {
     "code": "no-field",
     "message": "Node has no field \"nam\""
    }
   ]
  }
 },
 {
  "name": "maybe-absent names the type",
  "source": "type Expr = {k: \"num\", v: float} | {k: \"add\", l: Expr, r: Expr}; const f = (e: Expr): float => e.v; 1",
  "expect": {
   "phase": "check",
   "diagnostics": [
    {
     "code": "maybe-absent",
     "message": "field \"v\" may be absent from Expr"
    }
   ]
  }
 },
 {
  "name": "result-mismatch prints a recursive type by its name",
  "source": "type Node = {name: string, kids: Node[]}; const f = (n: Node): string => n.kids; 1",
  "expect": {
   "phase": "check",
   "diagnostics": [
    {
     "code": "result-mismatch",
     "message": "expected string, found Node[]"
    }
   ]
  }
 },
 {
  "name": "a value that does not fit, inside",
