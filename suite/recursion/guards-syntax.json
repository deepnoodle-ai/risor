[
  {"name": "a guard on a negative literal", "source": "match x { -1 if (c) => \"neg\", _ => \"other\" }", "env": "{x: int, c: bool}", "vars": {"x": -1, "c": true}, "expect": {"value": "neg", "steps": 1, "allocated": 0}},
  {"name": "a guard on null", "source": "match u { null if (c) => \"none\", _ => \"some\" }", "env": "{u: int | null, c: bool}", "vars": {"u": null, "c": true}, "expect": {"value": "none", "steps": 1, "allocated": 0}},
  {"name": "a guard on true", "source": "match b { true if (c) => 1, _ => 2 }", "env": "{b: bool, c: bool}", "vars": {"b": true, "c": true}, "expect": {"value": 1, "steps": 1, "allocated": 0}},
  {"name": "a lambda inside a guard", "source": "match x { 1 if (xs.every(v => v > 0)) => 1, _ => 0 }", "env": "{x: int, xs: int[]}", "vars": {"x": 1, "xs": [1, 2]}, "expect": {"value": 1, "steps": 9, "allocated": 0}},
  {"name": "an if expression inside a guard", "source": "match x { 1 if (if (c) { y > 0 } else { false }) => 1, _ => 0 }", "env": "{x: int, y: int, c: bool}", "vars": {"x": 1, "y": 1, "c": true}, "expect": {"value": 1, "steps": 2, "allocated": 0}},
  {"name": "a guard over several lines", "source": "match x {\n  1 if (\n    y > 0\n  ) => \"a\",\n  _ => \"b\",\n}", "env": "{x: int, y: int}", "vars": {"x": 1, "y": 1}, "expect": {"value": "a", "steps": 2, "allocated": 0}},
  {"name": "parentheses inside a guard", "source": "match x { 1 if ((y)) => 1, _ => 0 }", "env": "{x: int, y: int}", "vars": {"x": 1, "y": 1}, "expect": {"value": 1, "steps": 1, "allocated": 0}},
  {"name": "a guard without parentheses", "source": "match x { 1 if c => 2, _ => 3 }", "env": "{x: int, c: bool}", "expect": {"phase": "parse", "diagnostics": [{"code": "unexpected-token", "span": [1, 16, 1, 17], "message": "unexpected c"}]}},
  {"name": "a guard with no test", "source": "match x { 1 if => 2, _ => 3 }", "env": "{x: int}", "expect": {"phase": "parse", "diagnostics": [{"code": "unexpected-token", "span": [1, 16, 1, 18], "message": "unexpected =>"}]}},
  {"name": "a guard with empty parentheses", "source": "match x { 1 if () => 2, _ => 3 }", "env": "{x: int}", "expect": {"phase": "parse", "diagnostics": [{"code": "unexpected-token", "span": [1, 17, 1, 18], "message": "unexpected )"}]}},
  {"name": "a guard with no arrow", "source": "match x { 1 if (c) 2, _ => 3 }", "env": "{x: int, c: bool}", "expect": {"phase": "parse", "diagnostics": [{"code": "unexpected-token", "span": [1, 20, 1, 21], "message": "unexpected 2"}]}},
  {"name": "a guard with two tests", "source": "match x { 1 if (c, d) => 2, _ => 3 }", "env": "{x: int, c: bool, d: bool}", "expect": {"phase": "parse", "diagnostics": [{"code": "unexpected-token", "span": [1, 18, 1, 19], "message": "unexpected ,"}]}},
  {"name": "two guards on one arm", "source": "match x { 1 if (c) if (d) => 2, _ => 3 }", "env": "{x: int, c: bool, d: bool}", "expect": {"phase": "parse", "diagnostics": [{"code": "unexpected-token", "span": [1, 20, 1, 22], "message": "unexpected if"}]}},
  {"name": "a guard with no literal", "source": "match x { if (c) => 2, _ => 3 }", "env": "{x: int, c: bool}", "expect": {"phase": "parse", "diagnostics": [{"code": "reserved-word", "span": [1, 11, 1, 13], "message": "if is a reserved word and cannot stand here"}]}},
  {"name": "a = after a guard is not an assignment", "source": "match x { 1 if (c) = 2, _ => 3 }", "env": "{x: int, c: bool}", "expect": {"phase": "parse", "diagnostics": [{"code": "unexpected-token", "span": [1, 20, 1, 21], "message": "unexpected ="}]}},
  {"name": "a literal after a guard", "source": "match x { 1 if (c) | 2 => 3, _ => 4 }", "env": "{x: int, c: bool}", "expect": {"phase": "parse", "diagnostics": [{"code": "bitwise-operator", "span": [1, 20, 1, 21], "message": "| is not an operator here; write || for a logical or"}]}},
  {"name": "a guard's parentheses are a level", "source": "match x { 1 if (((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((c))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) => 1, _ => 0 }", "env": "{x: int, c: bool}", "vars": {"x": 1, "c": true}, "expect": {"value": 1, "steps": 1, "allocated": 0}},
  {"name": "a guard's parentheses count toward the nesting limit", "source": "match x { 1 if ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((c)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) => 1, _ => 0 }", "env": "{x: int, c: bool}", "expect": {"phase": "parse", "diagnostics": [{"code": "nesting-exceeded", "span": [1, 115, 1, 116], "message": "( opens a level past the limit of 100 levels of nesting"}]}}
]
