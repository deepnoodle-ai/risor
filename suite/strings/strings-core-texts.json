{
 "cases": [
  {
   "name": "core text: a text block",
   "source": "\"\"\"abc\"\"\"",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "text-block-open",
      "span": [
       1,
       1,
       1,
       4
      ]
     }
    ]
   }
  },
  {
   "name": "core text: a text block after an operator",
   "source": "1 + \"\"\"a\nb\"\"\"",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "text-block-open",
      "span": [
       1,
       5,
       1,
       8
      ]
     }
    ]
   }
  },
  {
   "name": "core text: nothing in a text block is an escape",
   "source": "\"\"\"\\q\"\"\"",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "text-block-open",
      "span": [
       1,
       1,
       1,
       4
      ]
     }
    ]
   }
  },
  {
   "name": "core text: a text block with no close runs to the end of input",
   "source": "\"\"\"abc",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "text-block-open",
      "span": [
       1,
       1,
       1,
       4
      ]
     }
    ]
   }
  },
  {
   "name": "core text: four double quotes",
   "source": "\"\"\"\"",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "text-block-open",
      "span": [
       1,
       1,
       1,
       4
      ]
     }
    ]
   }
  },
  {
   "name": "core text: a text block after an empty string",
   "source": "\"\" + \"\"\"x\"\"\"",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "text-block-open",
      "span": [
       1,
       6,
       1,
       9
      ]
     }
    ]
   }
  },
  {
   "name": "core text: r, a space, then a text block",
   "source": "r \"\"\"a\"\"\"",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "text-block-open",
      "span": [
       1,
       3,
       1,
       6
      ]
     }
    ]
   }
  },
  {
   "name": "core text: a raw string r\"...\"",
   "source": "r\"a\"",
   "expect": {
    "value": "a",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "core text: a raw string r'...'",
   "source": "r'a'",
   "expect": {
    "value": "a",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "core text: a prefixed string after an operator",
   "source": "1 + r\"a\"",
   "check": false,
   "expect": {
    "phase": "run",
    "diagnostics": [
     {
      "code": "wrong-kind",
      "span": [
       1,
       1,
       1,
       9
      ],
      "class": "dynamic"
     }
    ],
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "core text: nothing in a prefixed string is an escape",
   "source": "r\"a\\q\"",
   "expect": {
    "value": "a\\q",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "core text: a prefixed string runs to the end of its line",
   "source": "r\"abc\n1",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unterminated-string",
      "span": [
       1,
       1,
       1,
       6
      ]
     }
    ]
   }
  },
  {
   "name": "core text kept: a lexical error after a text block",
   "source": "\"\"\"x\"\"\" @",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-character",
      "span": [
       1,
       9,
       1,
       10
      ]
     }
    ]
   }
  },
  {
   "name": "core text kept: a lexical error after a prefixed literal",
   "source": "r`a` @",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-character",
      "span": [
       1,
       6,
       1,
       7
      ]
     }
    ]
   }
  },
