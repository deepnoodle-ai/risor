{
 "cases": [
  {
   "name": "the indentation of the closing delimiter is removed",
   "source": "\"\"\"\n  a\n    b\n  \"\"\"",
   "expect": {
    "value": "a\n  b",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "a blank line before the closing delimiter gives a final line feed",
   "source": "\"\"\"\n  a\n\n  \"\"\"",
   "expect": {
    "value": "a\n",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "no content line gives the empty string",
   "source": "\"\"\"\n\"\"\"",
   "expect": {
    "value": "",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "one empty line gives the empty string",
   "source": "\"\"\"\n\n\"\"\"",
   "expect": {
    "value": "",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "two empty lines give one line feed",
   "source": "\"\"\"\n\n\n\"\"\"",
   "expect": {
    "value": "\n",
    "steps": 0,
    "allocated": 0
   }
  },
  {
