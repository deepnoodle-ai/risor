[
  {"name": "a variable supplied as null reads as null", "source": "a", "env": "{a: int | null}", "vars": {"a": null}, "expect": {"value": null, "steps": 0, "allocated": 0}},
  {"name": "a variable of each JSON kind reads as that kind", "source": "[a, b, c, d, e, f]", "env": "{a: bool, b: int, c: float, d: string, e: int[], f: {k: string}}", "vars": {"a": true, "b": 42, "c": 1.5, "d": "héllo", "e": [1, 2], "f": {"k": "v"}}, "expect": {"value": [true, 42, 1.5, "héllo", [1, 2], {"k": "v"}], "steps": 0, "allocated": 7}},
  {"name": "a host list is read in place and not charged", "source": "xs", "env": "{xs: int[]}", "vars": {"xs": [1, 2, 3]}, "expect": {"value": [1, 2, 3], "steps": 0, "allocated": 0}},
  {"name": "a host map is read in place and not charged", "source": "m", "env": "{m: {a: int, b: string}}", "vars": {"m": {"a": 1, "b": "x"}}, "expect": {"value": {"a": 1, "b": "x"}, "steps": 0, "allocated": 0}},
  {"name": "each field read of host data costs 1", "source": "m.a.b", "env": "{m: {a: {b: int}}}", "vars": {"m": {"a": {"b": 7}}}, "expect": {"value": 7, "steps": 2, "allocated": 0}},
  {"name": "an index into a host list costs 1", "source": "xs[1]", "env": "{xs: int[]}", "vars": {"xs": [10, 20]}, "expect": {"value": 20, "steps": 1, "allocated": 0}},
  {"name": "an index then a field of host data", "source": "xs[0].name", "env": "{xs: {name: string}[]}", "vars": {"xs": [{"name": "a"}]}, "expect": {"value": "a", "steps": 2, "allocated": 0}},
  {"name": "host data put in a new list is not charged again", "source": "[xs, xs]", "env": "{xs: int[]}", "vars": {"xs": [1]}, "expect": {"value": [[1], [1]], "steps": 0, "allocated": 3}},
  {"name": "a spread of a host list copies its elements", "source": "[...xs]", "env": "{xs: int[]}", "vars": {"xs": [1, 2, 3]}, "expect": {"value": [1, 2, 3], "steps": 3, "allocated": 4}},
  {"name": "a spread of a host map copies its entries", "source": "{...m}", "env": "{m: {a: int, b: int}}", "vars": {"m": {"a": 1, "b": 2}}, "expect": {"value": {"a": 1, "b": 2}, "steps": 2, "allocated": 5}},
  {"name": "two host maps compared by ==", "source": "m == n", "env": "{m: {a: int}, n: {a: int}}", "vars": {"m": {"a": 1}, "n": {"a": 1}}, "expect": {"value": true, "steps": 2, "allocated": 0}},
  {"name": "the keys of a host map are visited in code point order", "source": "m.keys()", "env": "{m: map<int>}", "vars": {"m": {"b": 1, "a": 2}}, "expect": {"value": ["a", "b"], "steps": 5, "allocated": 3}},
  {"name": "a host key of 64 code points is charged by the key rule", "source": "m[k]", "env": "{m: map<any>, k: string}", "vars": {"m": {"kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk": 1}, "k": "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"}, "expect": {"value": 1, "steps": 2, "allocated": 0}},
  {"name": "a host value whose map key is not a name", "source": "m[\"a-b\"]", "env": "{m: {\"a-b\": int}}", "vars": {"m": {"a-b": 4}}, "expect": {"value": 4, "steps": 1, "allocated": 0}},
  {"name": "a declared variable that is read and not supplied is missing-variable", "source": "a + 1", "env": "{a: int}", "expect": {"phase": "run", "diagnostics": [{"code": "missing-variable", "span": [1, 1, 1, 2], "class": "environment", "message": "the host did not supply variable a"}], "steps": 0, "allocated": 0}},
  {"name": "missing-variable passes through catch", "source": "try { a } catch { 0 }", "env": "{a: int}", "expect": {"phase": "run", "diagnostics": [{"code": "missing-variable", "span": [1, 7, 1, 8], "class": "environment"}], "steps": 0, "allocated": 0}},
  {"name": "missing-variable passes through catch with a name, and no error value is charged", "source": "try { a } catch (err) { err.code }", "env": "{a: int}", "expect": {"phase": "run", "diagnostics": [{"code": "missing-variable", "span": [1, 7, 1, 8]}], "steps": 0, "allocated": 0}},
  {"name": "missing-variable has the span of the read", "source": "[1, a]", "env": "{a: int}", "expect": {"phase": "run", "diagnostics": [{"code": "missing-variable", "span": [1, 5, 1, 6]}], "steps": 0, "allocated": 0}},
  {"name": "a variable on a branch not taken is not asked for", "source": "ok ? a : 0", "env": "{ok: bool, a: int}", "vars": {"ok": false}, "expect": {"value": 0, "steps": 0, "allocated": 0}},
  {"name": "a variable after a falsy && is not asked for", "source": "ok && a", "env": "{ok: bool, a: int}", "vars": {"ok": false}, "expect": {"value": false, "steps": 0, "allocated": 0}},
  {"name": "a variable shadowed by a const is not asked for", "source": "const a = 2; a", "env": "{a: int}", "expect": {"value": 2, "steps": 0, "allocated": 0}},
  {"name": "a variable read in a lambda that is never called is not asked for", "source": "const f = x => a; 1", "env": "{a: int}", "expect": {"value": 1, "steps": 1, "allocated": 0}},
  {"name": "a variable read in a callback over an empty list is not asked for", "source": "xs.map(x => a)", "env": "{xs: int[], a: int}", "vars": {"xs": []}, "expect": {"value": [], "steps": 2, "allocated": 1}},
  {"name": "a declared variable that is not read need not be supplied", "source": "a", "env": "{a: int, b: int}", "vars": {"a": 1}, "expect": {"value": 1, "steps": 0, "allocated": 0}},
  {"name": "an absent field of host data is missing-field, not null", "source": "m.a", "env": "{m: map<any>}", "vars": {"m": {}}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 1, 4], "class": "dynamic", "message": "the map has no field a"}], "steps": 1, "allocated": 0}},
  {"name": "a field of host data that holds null reads as null", "source": "m.a", "env": "{m: map<any>}", "vars": {"m": {"a": null}}, "expect": {"value": null, "steps": 1, "allocated": 0}},
  {"name": "?. on an absent field of host data gives null", "source": "m?.a", "env": "{m: map<any>}", "vars": {"m": {}}, "expect": {"value": null, "steps": 1, "allocated": 0}},
  {"name": "a JSON number written 2.0 is the number 2", "source": "n == 2", "env": "{n: int}", "vars": {"n": 2.0}, "expect": {"value": true, "steps": 1, "allocated": 0}},
  {"name": "a value that breaks its declared type fails where it is read", "source": "n + 1", "env": "{n: int}", "vars": {"n": "x"}, "precondition": false, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 6], "class": "environment", "message": "cannot apply + to string and number"}], "steps": 0, "allocated": 0}},
  {"name": "a value that breaks its declared type is not tested where it is only passed on", "source": "[n]", "env": "{n: int}", "vars": {"n": "x"}, "precondition": false, "expect": {"value": ["x"], "steps": 0, "allocated": 2}},
  {"name": "null where the declared type has none is null-operand at the read", "source": "m.a", "env": "{m: {a: int}}", "vars": {"m": null}, "precondition": false, "expect": {"phase": "run", "diagnostics": [{"code": "null-operand", "span": [1, 1, 1, 4], "class": "environment", "message": "cannot read field a of null"}], "steps": 0, "allocated": 0}},
  {"name": "a required field that the host left out is missing-field at the read", "source": "m.a", "env": "{m: {a: int}}", "vars": {"m": {}}, "precondition": false, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 1, 4], "class": "environment", "message": "the map has no field a"}], "steps": 1, "allocated": 0}},
  {"name": "a value outside its declared literal set is no-match", "source": "match x { \"a\" => 1, \"b\" => 2 }", "env": "{x: \"a\" | \"b\"}", "vars": {"x": "c"}, "precondition": false, "expect": {"phase": "run", "diagnostics": [{"code": "no-match", "span": [1, 1, 1, 31], "class": "environment", "message": "the match has no arm for \"c\""}], "steps": 2, "allocated": 0}},
  {"name": "a failure from a value that breaks its type is caught", "source": "try { n + 1 } catch (err) { err.code }", "env": "{n: int}", "vars": {"n": "x"}, "precondition": false, "expect": {"value": "wrong-kind", "steps": 2, "allocated": 10}},
  {"name": "precondition true is the same as no precondition", "source": "n + 1", "env": "{n: int}", "vars": {"n": 1}, "precondition": true, "expect": {"value": 2, "steps": 1, "allocated": 0}},
  {"name": "a method is chosen by the receiver's kind, not its declared type (AC1)", "source": "x.slice(1)", "env": "{x: string}", "vars": {"x": [1, 2, 3]}, "precondition": false, "expect": {"value": [2, 3], "steps": 3, "allocated": 3}},
  {"name": "an absent _ element of a list pattern is index-range (AC2)", "source": "const [a, _] = xs; a", "env": "{xs: int[]}", "vars": {"xs": [1]}, "expect": {"phase": "run", "diagnostics": [{"code": "index-range", "span": [1, 11, 1, 12], "message": "the list has length 1, and the pattern needs index 1"}], "steps": 2, "allocated": 0}}
]
