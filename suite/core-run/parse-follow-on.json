{
 "cases": [
  {
   "name": "T3: in as a match case",
   "source": "match x { in => 1 }",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "reserved-word",
      "span": [
       1,
       11,
       1,
       13
      ]
     }
    ]
   }
  },
  {
   "name": "T3: else as a match case",
   "source": "match x { else => 1, _ => 2 }",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "reserved-word",
      "span": [
       1,
       11,
       1,
       15
      ]
     }
    ]
   }
  },
  {
   "name": "T3: a name as a match case",
   "source": "match x { a => 1 }",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       11,
       1,
       12
      ]
     }
    ]
   }
  },
  {
   "name": "T3: a name after | in a match case",
   "source": "match x { 1 | b => 2 }",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       15,
       1,
       16
      ]
     }
    ]
   }
  },
  {
   "name": "P12: a template as a match literal",
   "source": "match s { `a` => 1, _ => 0 }",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token"
     }
    ]
   }
  },
  {
   "name": "P12: a template with an interpolation as a match literal",
   "source": "match s { `${1}` => 1, _ => 0 }",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token"
     }
    ]
   }
  },
  {
   "name": "an at sign",
   "source": "@",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-character",
      "span": [
       1,
       1,
       1,
       2
      ]
     }
    ]
   }
  },
  {
   "name": "a line end in a one-line string",
   "source": "\"abc\n\"",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unterminated-string",
      "span": [
       1,
       1,
       1,
       5
      ]
     }
    ]
   }
  },
  {
   "name": "a backslash before a line end in a template",
   "source": "`a\\\nb`",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "line-continuation",
      "span": [
       1,
       3,
       1,
       4
      ]
     }
    ]
   }
  }
 ]
}
