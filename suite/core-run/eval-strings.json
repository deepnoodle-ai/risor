   "expect": {
    "value": "\r",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\b is a backspace",
   "source": "\"\\b\"",
   "expect": {
    "value": "\b",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\f is a form feed",
   "source": "\"\\f\"",
   "expect": {
    "value": "\f",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\\\ is a backslash",
   "source": "\"\\\\\"",
   "expect": {
    "value": "\\",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\/ is a slash",
   "source": "\"\\/\"",
   "expect": {
    "value": "/",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\\" is a double quote",
   "source": "\"\\\"\"",
   "expect": {
    "value": "\"",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\' is a single quote",
   "source": "'\\''",
   "expect": {
    "value": "'",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "a double quote stands in single quotes",
