   "expect": {
    "value": "\"",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "a single quote stands in double quotes",
   "source": "\"'\"",
   "expect": {
    "value": "'",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\u with four digits",
   "source": "\"\\u0041\"",
   "expect": {
    "value": "A",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\u with lower-case digits",
   "source": "\"\\u00e9\"",
   "expect": {
    "value": "é",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\u{ } with one digit",
   "source": "\"\\u{41}\"",
   "expect": {
    "value": "A",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\u{ } names an emoji",
   "source": "\"\\u{1F600}\"",
   "expect": {
    "value": "😀",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "a surrogate pair of \\u escapes is one code point",
   "source": "\"\\uD83D\\uDE00\"",
   "expect": {
    "value": "😀",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\u{10FFFF} is the last code point",
   "source": "\"\\u{10FFFF}\"",
   "expect": {
    "value": "􏿿",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\` in a template",
   "source": "`\\``",
   "expect": {
    "value": "`",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\$ in a template",
   "source": "`\\$`",
   "expect": {
    "value": "$",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\${ in a template is text",
   "source": "`\\${x}`",
   "expect": {
    "value": "${x}",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "a $ not followed by { is text",
   "source": "`a$b`",
   "expect": {
    "value": "a$b",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "a raw CR LF in a template reads as LF",
   "source": "`a\r\nb`",
   "expect": {
    "value": "a\nb",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "a raw CR in a template reads as LF",
   "source": "`a\rb`",
   "expect": {
    "value": "a\nb",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\r in a template is still CR",
   "source": "`a\\rb`",
   "expect": {
    "value": "a\rb",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "a raw line feed in a template",
   "source": "`a\nb`",
   "expect": {
    "value": "a\nb",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "a // inside a string is not a comment",
   "source": "\"a//b\"",
   "expect": {
    "value": "a//b",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "a pair of escapes has weight 2",
   "source": "\"\\uD83D\\uDE00\" + s",
   "env": "{s: any}",
   "vars": {
    "s": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
   },
   "expect": {
    "value": "😀aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "steps": 2,
    "allocated": 2
   }
  }
 ]
}
