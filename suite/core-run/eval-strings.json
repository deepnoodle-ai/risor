   "expect": {
    "value": "a\nb",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\t is a tab",
   "source": "\"\\t\"",
   "expect": {
    "value": "\t",
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "\\r is a carriage return",
