[
  {"name": "match: the second arm is taken", "source": "match x { \"a\" => 1, \"b\" => 2, _ => 0 }", "env": "{x: any}", "vars": {"x": "b"}, "expect": {"value": 2, "steps": 2, "allocated": 0}},
  {"name": "match: the first arm taken charges one step", "source": "match x { \"a\" => 1, \"b\" => 2, _ => 0 }", "env": "{x: any}", "vars": {"x": "a"}, "expect": {"value": 1, "steps": 1, "allocated": 0}},
  {"name": "match: the default arm after every other arm", "source": "match x { \"a\" => 1, \"b\" => 2, _ => 0 }", "env": "{x: any}", "vars": {"x": "z"}, "expect": {"value": 0, "steps": 3, "allocated": 0}},
  {"name": "match: an arm of several literals counts one step", "source": "match x { \"a\" | \"b\" | \"c\" => 1, _ => 0 }", "env": "{x: any}", "vars": {"x": "c"}, "expect": {"value": 1, "steps": 1, "allocated": 0}},
  {"name": "match: number literals", "source": "match x { 1 => \"one\", 2 => \"two\", _ => \"many\" }", "env": "{x: any}", "vars": {"x": 2}, "expect": {"value": "two", "steps": 2, "allocated": 0}},
  {"name": "match: a negative number literal", "source": "match x { -1 => \"neg\", 0 => \"zero\", _ => \"pos\" }", "env": "{x: any}", "vars": {"x": -1}, "expect": {"value": "neg", "steps": 1, "allocated": 0}},
  {"name": "match: 1 and 1.0 are one value", "source": "match x { 1.0 => \"one\", _ => \"other\" }", "env": "{x: any}", "vars": {"x": 1}, "expect": {"value": "one", "steps": 1, "allocated": 0}},
  {"name": "match: an arm compares with ==, not by truthiness: zero is not false", "source": "match x { false => \"false\", _ => \"other\" }", "env": "{x: any}", "vars": {"x": 0}, "expect": {"value": "other", "steps": 2, "allocated": 0}},
  {"name": "match: null is not the empty string", "source": "match x { \"\" => \"empty\", _ => \"other\" }", "env": "{x: any}", "vars": {"x": null}, "expect": {"value": "other", "steps": 2, "allocated": 0}},
  {"name": "match: the null literal", "source": "match x { null => \"none\", _ => \"some\" }", "env": "{x: any}", "vars": {"x": null}, "expect": {"value": "none", "steps": 1, "allocated": 0}},
  {"name": "match: the true literal", "source": "match x { false => \"no\", true => \"yes\", _ => \"other\" }", "env": "{x: any}", "vars": {"x": true}, "expect": {"value": "yes", "steps": 2, "allocated": 0}},
  {"name": "match: a list subject equals no literal", "source": "match x { 1 => \"one\", _ => \"other\" }", "env": "{x: any}", "vars": {"x": [1]}, "expect": {"value": "other", "steps": 2, "allocated": 0}},
  {"name": "match: the subject is evaluated once", "source": "match a + b { 1 => \"one\", 2 => \"two\", 3 => \"three\", _ => \"other\" }", "env": "{a: any, b: any}", "vars": {"a": 1, "b": 2}, "expect": {"value": "three", "steps": 4, "allocated": 0}},
  {"name": "match: a result not chosen is not evaluated", "source": "match x { \"a\" => 1 / d, _ => 0 }", "env": "{x: any, d: any}", "vars": {"x": "b", "d": 0}, "expect": {"value": 0, "steps": 2, "allocated": 0}},
  {"name": "match: the chosen result is evaluated and can fail", "source": "match x { \"a\" => 1 / d, _ => 0 }", "env": "{x: any, d: any}", "vars": {"x": "a", "d": 0}, "expect": {"phase": "run", "diagnostics": [{"code": "divide-by-zero", "span": [1, 18, 1, 23], "message": "the divisor of / is zero"}], "steps": 2, "allocated": 0}},
  {"name": "match: a result that builds a list", "source": "match x { \"a\" => [1, 2], _ => [] }", "env": "{x: any}", "vars": {"x": "a"}, "expect": {"value": [1, 2], "steps": 1, "allocated": 3}},
  {"name": "match: a long string literal equal to the subject charges its common prefix", "source": "match x { \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" => 1, _ => 0 }", "env": "{x: any}", "vars": {"x": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}, "expect": {"value": 1, "steps": 2, "allocated": 0}},
  {"name": "match: two long literals in one arm, the second equal", "source": "match x { \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab\" | \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" => 1, _ => 0 }", "env": "{x: any}", "vars": {"x": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}, "expect": {"value": 1, "steps": 3, "allocated": 0}},
  {"name": "match: an arm stops at its first equal literal", "source": "match x { \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" | \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab\" => 1, _ => 0 }", "env": "{x: any}", "vars": {"x": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}, "expect": {"value": 1, "steps": 2, "allocated": 0}},
  {"name": "match: a long subject that shares a long prefix with a literal and is not equal", "source": "match x { \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab\" => 1, _ => 0 }", "env": "{x: any}", "vars": {"x": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}, "expect": {"value": 0, "steps": 4, "allocated": 0}},
  {"name": "match: no-match on a value outside its declared literal set", "source": "match x { \"a\" => 1, \"b\" => 2 }", "env": "{x: \"a\" | \"b\"}", "precondition": false, "vars": {"x": "c"}, "expect": {"phase": "run", "diagnostics": [{"code": "no-match", "span": [1, 1, 1, 31], "message": "the match has no arm for \"c\""}], "steps": 2, "allocated": 0}},
  {"name": "match: no-match names a number", "source": "match x { true => 1, false => 0 }", "env": "{x: bool}", "precondition": false, "vars": {"x": 5}, "expect": {"phase": "run", "diagnostics": [{"code": "no-match", "span": [1, 1, 1, 34], "message": "the match has no arm for 5"}], "steps": 2, "allocated": 0}},
  {"name": "match: no-match names null", "source": "match x { true => 1, false => 0 }", "env": "{x: bool}", "precondition": false, "vars": {"x": null}, "expect": {"phase": "run", "diagnostics": [{"code": "no-match", "span": [1, 1, 1, 34], "message": "the match has no arm for null"}], "steps": 2, "allocated": 0}},
  {"name": "match: no-match names a list by its kind", "source": "match x { true => 1, false => 0 }", "env": "{x: bool}", "precondition": false, "vars": {"x": [1]}, "expect": {"phase": "run", "diagnostics": [{"code": "no-match", "span": [1, 1, 1, 34], "message": "the match has no arm for list"}], "steps": 2, "allocated": 0}},
  {"name": "match: no-match names a map by its kind", "source": "match x { true => 1, false => 0 }", "env": "{x: bool}", "precondition": false, "vars": {"x": {}}, "expect": {"phase": "run", "diagnostics": [{"code": "no-match", "span": [1, 1, 1, 34], "message": "the match has no arm for map"}], "steps": 2, "allocated": 0}},
  {"name": "match: no-match charges every arm", "source": "match x { \"a\" => 1, \"b\" => 2, \"c\" => 3 }", "env": "{x: \"a\" | \"b\" | \"c\"}", "precondition": false, "vars": {"x": "d"}, "expect": {"phase": "run", "diagnostics": [{"code": "no-match", "span": [1, 1, 1, 41], "message": "the match has no arm for \"d\""}], "steps": 3, "allocated": 0}},
  {"name": "match: catch catches no-match, and the message names the value", "source": "try { match x { \"a\" => 1, \"b\" => 2 } } catch (e) { e.message }", "env": "{x: \"a\" | \"b\"}", "precondition": false, "vars": {"x": "c"}, "expect": {"value": "the match has no arm for \"c\"", "steps": 4, "allocated": 10}},
  {"name": "match: the code of no-match", "source": "try { match x { \"a\" => 1, \"b\" => 2 } } catch (e) { e.code }", "env": "{x: \"a\" | \"b\"}", "precondition": false, "vars": {"x": "c"}, "expect": {"value": "no-match", "steps": 4, "allocated": 10}},
  {"name": "match: a match that covers its literal set needs no default", "source": "match x { \"a\" => 1, \"b\" => 2 }", "env": "{x: \"a\" | \"b\"}", "vars": {"x": "b"}, "expect": {"value": 2, "steps": 2, "allocated": 0}},
  {"name": "match: a match that covers bool", "source": "match x { true => 1, false => 0 }", "env": "{x: bool}", "vars": {"x": false}, "expect": {"value": 0, "steps": 2, "allocated": 0}},
  {"name": "match: a match that covers bool and null", "source": "match x { true => \"y\", false => \"n\", null => \"?\" }", "env": "{x: bool | null}", "vars": {"x": null}, "expect": {"value": "?", "steps": 3, "allocated": 0}},
  {"name": "match: a match in a lambda body", "source": "xs.map(x => match x { 1 => \"a\", _ => \"b\" })", "env": "{xs: any}", "vars": {"xs": [1, 2]}, "expect": {"value": ["a", "b"], "steps": 9, "allocated": 3}},
  {"name": "match: an if in parentheses as the subject", "source": "match (if (c) { 1 } else { 2 }) { 1 => \"one\", _ => \"two\" }", "env": "{c: any}", "vars": {"c": false}, "expect": {"value": "two", "steps": 2, "allocated": 0}},
  {"name": "match: a match as an operand", "source": "match x { 1 => 10, _ => 20 } + 1", "env": "{x: any}", "vars": {"x": 1}, "expect": {"value": 11, "steps": 2, "allocated": 0}},
  {"name": "match: a match as the value of a const", "source": "const label = match x { 200 => \"ok\", 404 => \"missing\", _ => \"error\" }; label", "env": "{x: any}", "vars": {"x": 404}, "expect": {"value": "missing", "steps": 2, "allocated": 0}},
  {"name": "match: the default arm takes any subject, a map", "source": "match x { \"a\" => 1, _ => 2 }", "env": "{x: any}", "vars": {"x": {"a": 1}}, "expect": {"value": 2, "steps": 2, "allocated": 0}},
  {"name": "match: an arm with a string and a number literal", "source": "match x { \"1\" | 1 => \"one\", _ => \"other\" }", "env": "{x: any}", "vars": {"x": 1}, "expect": {"value": "one", "steps": 1, "allocated": 0}},
  {"name": "match: the subject is a field read", "source": "match m.kind { \"bug\" => 1, \"idea\" => 2, _ => 3 }", "env": "{m: any}", "vars": {"m": {"kind": "idea"}}, "expect": {"value": 2, "steps": 3, "allocated": 0}},
  {"name": "match: duplicate-case, 1 then 1.0", "source": "match x { 1 => \"a\", 1.0 => \"b\", _ => \"c\" }", "env": "{x: any}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-case", "span": [1, 21, 1, 24]}]}},
  {"name": "match: duplicate-case, 1 then 1e0", "source": "match x { 1 => \"a\", 1e0 => \"b\", _ => \"c\" }", "env": "{x: any}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-case", "span": [1, 21, 1, 24]}]}},
  {"name": "match: duplicate-case, a string and the same string by an escape", "source": "match x { \"A\" => 1, '\\u{41}' => 2, _ => 0 }", "env": "{x: any}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-case", "span": [1, 21, 1, 29]}]}},
  {"name": "match: duplicate-case, 0 then -0, the span has the -", "source": "match x { 0 => \"z\", -0 => \"n\", _ => \"o\" }", "env": "{x: any}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-case", "span": [1, 21, 1, 23]}]}},
  {"name": "match: duplicate-case, two equal literals in one arm", "source": "match x { 1 | 1 => \"a\", _ => \"b\" }", "env": "{x: any}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-case", "span": [1, 15, 1, 16]}]}}
]
