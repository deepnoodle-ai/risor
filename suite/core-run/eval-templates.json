  {
   "name": "a host list renders as compact JSON",
   "source": "`${xs}`",
   "env": "{xs: any}",
   "vars": {
    "xs": [
     1,
     "a",
     null,
     true
    ]
   },
   "expect": {
    "value": "[1,\"a\",null,true]",
    "steps": 5,
    "allocated": 1
   }
  },
  {
   "name": "an empty list renders as []",
   "source": "`${xs}`",
   "env": "{xs: any}",
   "vars": {
    "xs": []
   },
   "expect": {
    "value": "[]",
    "steps": 1,
    "allocated": 1
   }
  },
  {
   "name": "a nested list is walked at every level",
   "source": "`${xs}`",
   "env": "{xs: any}",
   "vars": {
    "xs": [
     [
      1
     ],
     []
    ]
   },
   "expect": {
    "value": "[[1],[]]",
    "steps": 4,
    "allocated": 1
   }
  },
  {
   "name": "a list literal in a template",
   "source": "`${[1, 2]}`",
   "expect": {
    "value": "[1,2]",
    "steps": 3,
    "allocated": 4
   }
  },
  {
   "name": "an empty map renders as {}",
   "source": "`${m}`",
   "env": "{m: any}",
   "vars": {
    "m": {}
   },
   "expect": {
    "value": "{}",
    "steps": 1,
    "allocated": 1
   }
  },
  {
   "name": "a map of one entry",
   "source": "`${m}`",
   "env": "{m: any}",
   "vars": {
    "m": {
     "a": 1
    }
   },
   "expect": {
    "value": "{\"a\":1}",
    "steps": 2,
    "allocated": 1
   }
  },
  {
   "name": "a map of three entries in key order",
   "source": "`${m}`",
   "env": "{m: any}",
   "vars": {
    "m": {
     "c": 3,
     "a": 1,
     "b": 2
    }
   },
   "expect": {
    "value": "{\"a\":1,\"b\":2,\"c\":3}",
    "steps": 10,
    "allocated": 1
   }
  },
  {
   "name": "a map of four entries",
   "source": "`${m}`",
   "env": "{m: any}",
   "vars": {
    "m": {
     "d": 4,
     "c": 3,
     "b": 2,
     "a": 1
    }
   },
   "expect": {
    "value": "{\"a\":1,\"b\":2,\"c\":3,\"d\":4}",
    "steps": 13,
    "allocated": 1
   }
  },
  {
   "name": "a map of five entries",
   "source": "`${m}`",
   "env": "{m: any}",
   "vars": {
    "m": {
     "e": 5,
     "d": 4,
     "c": 3,
     "b": 2,
     "a": 1
    }
   },
   "expect": {
    "value": "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5}",
    "steps": 21,
    "allocated": 1
   }
  },
  {
   "name": "a map inside a list",
   "source": "`${xs}`",
   "env": "{xs: any}",
   "vars": {
    "xs": [
     {
      "a": 1
     }
    ]
   },
   "expect": {
    "value": "[{\"a\":1}]",
    "steps": 3,
    "allocated": 1
   }
  },
  {
   "name": "a map with a null value",
   "source": "`${m}`",
   "env": "{m: any}",
   "vars": {
    "m": {
     "a": null
    }
   },
   "expect": {
    "value": "{\"a\":null}",
    "steps": 2,
    "allocated": 1
   }
  },
  {
   "name": "map keys are in code point order",
   "source": "`${m}`",
   "env": "{m: any}",
   "vars": {
    "m": {
     "b": 1,
     "B": 2,
     "a": 3
    }
   },
   "expect": {
    "value": "{\"B\":2,\"a\":3,\"b\":1}",
    "steps": 10,
    "allocated": 1
   }
  },
  {
   "name": "key order is by code point, not UTF-16 unit",
   "source": "`${m}`",
   "env": "{m: any}",
   "vars": {
    "m": {
     "｡": 1,
     "😀": 2
    }
   },
   "expect": {
    "value": "{\"｡\":1,\"😀\":2}",
    "steps": 5,
    "allocated": 1
   }
  },
  {
   "name": "long keys add to the walk of a map",
   "source": "`${m}`",
   "env": "{m: any}",
   "vars": {
    "m": {
     "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 1,
     "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb": 2
    }
   },
   "expect": {
    "value": "{\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\":1,\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\":2}",
    "steps": 7,
    "allocated": 2
   }
  },
  {
   "name": "a quote in a list element is escaped",
   "source": "`${xs}`",
   "env": "{xs: any}",
   "vars": {
    "xs": [
     "say \"hi\""
    ]
   },
   "expect": {
    "value": "[\"say \\\"hi\\\"\"]",
    "steps": 2,
    "allocated": 1
   }
  },
  {
   "name": "a backslash in a list element is escaped",
   "source": "`${xs}`",
   "env": "{xs: any}",
   "vars": {
    "xs": [
     "a\\b"
    ]
   },
   "expect": {
    "value": "[\"a\\\\b\"]",
    "steps": 2,
    "allocated": 1
   }
  },
  {
   "name": "control characters with short escapes",
   "source": "`${xs}`",
   "env": "{xs: any}",
   "vars": {
    "xs": [
     "\n\t\r\b\f"
    ]
   },
   "expect": {
    "value": "[\"\\n\\t\\r\\b\\f\"]",
    "steps": 2,
    "allocated": 1
   }
  },
  {
   "name": "other control characters use \\u00 and lower case",
   "source": "`${xs}`",
   "env": "{xs: any}",
   "vars": {
    "xs": [
     "\u0001\u001f"
    ]
   },
   "expect": {
    "value": "[\"\\u0001\\u001f\"]",
    "steps": 2,
    "allocated": 1
   }
  },
  {
   "name": "slash, angle bracket, DEL and U+2028 are not escaped",
   "source": "`${xs}`",
   "env": "{xs: any}",
   "vars": {
    "xs": [
     "/<& "
    ]
   },
   "expect": {
    "value": "[\"/<& \"]",
    "steps": 2,
    "allocated": 1
   }
  },
  {
   "name": "non-ASCII text is not escaped",
   "source": "`${xs}`",
   "env": "{xs: any}",
   "vars": {
    "xs": [
     "é😀"
    ]
   },
   "expect": {
    "value": "[\"é😀\"]",
    "steps": 2,
    "allocated": 1
   }
  },
  {
   "name": "a map key is escaped",
   "source": "`${m}`",
   "env": "{m: any}",
   "vars": {
    "m": {
     "a\"b": 1
    }
   },
   "expect": {
    "value": "{\"a\\\"b\":1}",
    "steps": 2,
    "allocated": 1
   }
  },
  {
   "name": "a string part of weight 64",
   "source": "`${x}`",
   "env": "{x: any}",
   "vars": {
    "x": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
   },
   "expect": {
    "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "steps": 2,
    "allocated": 2
   }
  },
  {
   "name": "text parts count toward the size",
   "source": "`xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx${1}`",
   "expect": {
    "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx1",
    "steps": 2,
    "allocated": 2
   }
  },
  {
   "name": "a template inside a template",
   "source": "`a${`b${x}`}`",
   "env": "{x: any}",
   "vars": {
    "x": 1
   },
   "expect": {
    "value": "ab1",
    "steps": 2,
    "allocated": 2
   }
  },
  {
   "name": "01 example 44",
   "source": "`${[1, \"a\"]}-${null}-${{b: 1, a: true}}`",
   "expect": {
    "value": "[1,\"a\"]--{\"a\":true,\"b\":1}",
    "steps": 7,
    "allocated": 9
   }
  },
  {
   "name": "a failing part keeps what the walk charged",
   "source": "`${xs}${1 / d}`",
   "env": "{xs: any, d: any}",
   "vars": {
    "xs": [
     1,
     2
    ],
    "d": 0
   },
   "expect": {
    "phase": "run",
    "diagnostics": [
     {
      "code": "divide-by-zero",
      "span": [
       1,
       9,
       1,
       14
      ],
      "message": "the divisor of / is zero"
     }
    ],
    "steps": 3,
    "allocated": 0
   }
  }
 ]
}
