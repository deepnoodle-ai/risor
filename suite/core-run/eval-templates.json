{
 "cases": [
  {
   "name": "a template joins text and a value",
   "source": "`a${x}b`",
   "env": "{x: any}",
   "vars": {
    "x": 1
   },
   "expect": {
    "value": "a1b",
    "steps": 1,
    "allocated": 1
   }
  },
  {
   "name": "a string part is unchanged",
   "source": "`${x}`",
   "env": "{x: any}",
   "vars": {
    "x": "say \"hi\""
   },
   "expect": {
    "value": "say \"hi\"",
    "steps": 1,
    "allocated": 1
   }
  },
  {
   "name": "a null part is empty",
   "source": "`[${x}]`",
   "env": "{x: any}",
   "vars": {
    "x": null
   },
   "expect": {
    "value": "[]",
    "steps": 1,
    "allocated": 1
   }
  },
  {
   "name": "bool parts",
   "source": "`${x}${y}`",
   "env": "{x: any, y: any}",
   "vars": {
    "x": true,
    "y": false
   },
   "expect": {
    "value": "truefalse",
    "steps": 1,
    "allocated": 1
   }
  },
