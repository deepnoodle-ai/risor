{
 "cases": [
  {
   "name": "in a list: found last",
   "source": "3 in [1, 2, 3]",
   "expect": {
    "value": true,
    "steps": 3,
    "allocated": 4
   }
  },
  {
   "name": "in a list: not found",
   "source": "4 in [1, 2, 3]",
   "expect": {
    "value": false,
    "steps": 3,
    "allocated": 4
   }
  },
  {
   "name": "in a list: found first",
   "source": "1 in [1, 2, 3]",
   "expect": {
    "value": true,
    "steps": 1,
    "allocated": 4
   }
  },
  {
   "name": "in the empty list",
   "source": "x in ys",
   "env": "{x: any, ys: any}",
   "vars": {
    "x": 1,
    "ys": []
   },
   "expect": {
    "value": false,
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "null in a list",
   "source": "null in [1, null]",
   "expect": {
    "value": true,
    "steps": 2,
    "allocated": 3
   }
  },
  {
   "name": "a list in a list of lists",
   "source": "[1] in [[1]]",
   "expect": {
    "value": true,
    "steps": 3,
    "allocated": 6
   }
  },
  {
   "name": "lists of different lengths add nothing",
   "source": "[1] in [[1, 2]]",
   "expect": {
    "value": false,
    "steps": 1,
    "allocated": 7
   }
  },
  {
