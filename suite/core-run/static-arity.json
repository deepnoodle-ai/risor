{
 "env": "{n: int, s: string, ok: bool, xs: int[], m: {a: int, b: string}, blob: any}",
 "functions": {"rate": "(code: string) => float !", "opt": "(s: string, n?: int) => string", "many": "(a: int, ...rest: int[]) => int", "geo.distance": "(a: string, b: string) => float"},
 "cases": [
  {"name": "a const-bound lambda called with too few arguments", "source": "const f = (a, b) => a; f(1)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 24, 1, 28]}]}},
  {"name": "a const-bound lambda called with too many arguments", "source": "const f = a => a; f(1, 2)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 19, 1, 26]}]}},
  {"name": "a parameter with a default may be left out", "source": "const f = (a, b = 2) => a + b; f(1)", "expect": {"value": 3, "steps": 3, "allocated": 0}},
  {"name": "a parameter with no default may not be left out", "source": "const f = (a, b = 2) => a; f()", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 28, 1, 31]}]}},
  {"name": "a default does not allow an extra argument", "source": "const f = (a, b = 2) => a; f(1, 2, 3)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 28, 1, 38]}]}},
  {"name": "a parameter written _ counts", "source": "const f = (_, b) => b; f(1)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 24, 1, 28]}]}},
  {"name": "a lambda with no parameters called with one argument", "source": "const f = () => 1; f(1)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 20, 1, 24]}]}},
  {"name": "len with no argument", "source": "len()", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 6]}]}},
  {"name": "len with two arguments", "source": "len(\"a\", \"b\")", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 14]}]}},
  {"name": "range with three arguments", "source": "range(1, 2, 3)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 15]}]}},
  {"name": "min needs two arguments", "source": "min(1)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 7]}]}},
  {"name": "min takes any number of arguments from two", "source": "min(3, 1, 2)", "expect": {"value": 1}},
  {"name": "fail with no argument", "source": "fail()", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 7]}]}},
  {"name": "a host function with too few arguments", "source": "rate()", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 7]}]}},
  {"name": "a host function with too many arguments", "source": "rate(\"a\", \"b\")", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 15]}]}},
  {"name": "the optional parameter of a host function may be left out", "source": "opt(\"a\")", "expect": {}},
  {"name": "a host function with an optional parameter and too many arguments", "source": "opt(\"a\", 1, 2)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 15]}]}},
  {"name": "a rest parameter takes any number of arguments", "source": "many(1, 2, 3, 4)", "expect": {}},
  {"name": "a host function with a rest parameter and too few arguments", "source": "many()", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 7]}]}},
  {"name": "the span of arity on a namespaced call starts at the namespace", "source": "geo.distance(\"a\", \"b\", \"c\")", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 28]}]}},
  {"name": "the span of arity runs across lines to the closing parenthesis", "source": "len(\n  \"a\",\n  \"b\")", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 3, 7]}]}},
  {"name": "after arity on a library function, no lambda argument is tested", "source": "len(x => 1, 2)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 15]}]}},
  {"name": "after arity on a const-bound lambda, no lambda argument is tested", "source": "const inc = n => n + 1; inc(inc, 1)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 25, 1, 36]}]}},
  {"name": "after arity the body of a lambda argument is still walked", "source": "len(x => nope, 2)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 18]}, {"code": "undefined-name", "span": [1, 10, 1, 14]}]}},
  {"name": "arity in the body of a const-bound lambda with no use", "source": "const g = t => len(); 1", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 16, 1, 21]}]}},
  {"name": "arity on an inner call only", "source": "len(len())", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 5, 1, 10]}]}},
  {"name": "arity and an undefined name inside it, the wider span first", "source": "len(nope, 1)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 1, 1, 13]}, {"code": "undefined-name", "span": [1, 5, 1, 9]}]}},
  {"name": "a count of arguments on a method call is not a static rule", "source": "blob.trim(1, 2)", "expect": {}},
  {"name": "a call gives every parameter up to the last with no default (AC10)", "source": "const f = (a = 1, b) => b; f(5)", "expect": {"phase": "check", "diagnostics": [{"code": "arity", "span": [1, 28, 1, 32]}]}},
  {"name": "null for a parameter with a default before one without (AC10)", "source": "const f = (a = 1, b) => b; f(null, 5)", "expect": {"value": 5, "steps": 2, "allocated": 0}}
 ]
}
