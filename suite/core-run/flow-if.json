[
  {"name": "if: null is falsy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": null}, "expect": {"value": "f", "steps": 0, "allocated": 0}},
  {"name": "if: false is falsy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": false}, "expect": {"value": "f", "steps": 0, "allocated": 0}},
  {"name": "if: true is truthy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": true}, "expect": {"value": "t", "steps": 0, "allocated": 0}},
  {"name": "if: zero is falsy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": 0}, "expect": {"value": "f", "steps": 0, "allocated": 0}},
  {"name": "if: one is truthy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": 1}, "expect": {"value": "t", "steps": 0, "allocated": 0}},
  {"name": "if: a negative fraction is truthy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": -1.5}, "expect": {"value": "t", "steps": 0, "allocated": 0}},
  {"name": "if: the empty string is falsy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": ""}, "expect": {"value": "f", "steps": 0, "allocated": 0}},
  {"name": "if: a space is truthy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": " "}, "expect": {"value": "t", "steps": 0, "allocated": 0}},
  {"name": "if: the string \"0\" is truthy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": "0"}, "expect": {"value": "t", "steps": 0, "allocated": 0}},
  {"name": "if: the string \"false\" is truthy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": "false"}, "expect": {"value": "t", "steps": 0, "allocated": 0}},
  {"name": "if: the empty list is falsy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": []}, "expect": {"value": "f", "steps": 0, "allocated": 0}},
  {"name": "if: [0] is truthy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": [0]}, "expect": {"value": "t", "steps": 0, "allocated": 0}},
  {"name": "if: [null] is truthy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": [null]}, "expect": {"value": "t", "steps": 0, "allocated": 0}},
  {"name": "if: [[]] is truthy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": [[]]}, "expect": {"value": "t", "steps": 0, "allocated": 0}},
  {"name": "if: the empty map is falsy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": {}}, "expect": {"value": "f", "steps": 0, "allocated": 0}},
  {"name": "if: {a: null} is truthy as a test", "source": "if (x) { \"t\" } else { \"f\" }", "env": "{x: any}", "vars": {"x": {"a": null}}, "expect": {"value": "t", "steps": 0, "allocated": 0}},
  {"name": "?:: zero is falsy as a test", "source": "x ? 1 : 2", "env": "{x: any}", "vars": {"x": 0}, "expect": {"value": 2, "steps": 0, "allocated": 0}},
  {"name": "?:: the empty list is falsy as a test", "source": "x ? 1 : 2", "env": "{x: any}", "vars": {"x": []}, "expect": {"value": 2, "steps": 0, "allocated": 0}},
  {"name": "?:: a non-empty string is truthy as a test", "source": "x ? 1 : 2", "env": "{x: any}", "vars": {"x": "x"}, "expect": {"value": 1, "steps": 0, "allocated": 0}},
  {"name": "?:: the empty map is falsy as a test", "source": "x ? 1 : 2", "env": "{x: any}", "vars": {"x": {}}, "expect": {"value": 2, "steps": 0, "allocated": 0}},
  {"name": "!: null gives true", "source": "!x", "env": "{x: any}", "vars": {"x": null}, "expect": {"value": true, "steps": 1, "allocated": 0}},
  {"name": "!: [1] gives false", "source": "!x", "env": "{x: any}", "vars": {"x": [1]}, "expect": {"value": false, "steps": 1, "allocated": 0}},
  {"name": "!: the empty string gives true", "source": "!x", "env": "{x: any}", "vars": {"x": ""}, "expect": {"value": true, "steps": 1, "allocated": 0}},
  {"name": "!: {a: 1} gives false", "source": "!x", "env": "{x: any}", "vars": {"x": {"a": 1}}, "expect": {"value": false, "steps": 1, "allocated": 0}},
  {"name": "!: two nots charge two steps", "source": "!!x", "env": "{x: any}", "vars": {"x": "a"}, "expect": {"value": true, "steps": 2, "allocated": 0}},
  {"name": "if: the first truthy test wins, and later tests are not evaluated", "source": "if (a) { 1 } else if (1 / d > 0) { 2 } else { 3 }", "env": "{a: any, d: any}", "vars": {"a": true, "d": 0}, "expect": {"value": 1, "steps": 0, "allocated": 0}},
  {"name": "if: a falsy test goes on to the next test", "source": "if (a) { 1 } else if (1 / d > 0) { 2 } else { 3 }", "env": "{a: any, d: any}", "vars": {"a": false, "d": 0}, "expect": {"phase": "run", "diagnostics": [{"code": "divide-by-zero", "span": [1, 23, 1, 28], "message": "the divisor of / is zero"}], "steps": 1, "allocated": 0}},
  {"name": "if: the else branch when no test is truthy", "source": "if (a) { 1 } else if (b) { 2 } else { 3 }", "env": "{a: any, b: any}", "vars": {"a": 0, "b": ""}, "expect": {"value": 3, "steps": 0, "allocated": 0}},
  {"name": "if: the second test is truthy", "source": "if (a) { 1 } else if (b) { 2 } else { 3 }", "env": "{a: any, b: any}", "vars": {"a": null, "b": [1]}, "expect": {"value": 2, "steps": 0, "allocated": 0}},
  {"name": "if: the branch not taken is not evaluated", "source": "if (c) { 1 } else { 1 / d }", "env": "{c: any, d: any}", "vars": {"c": true, "d": 0}, "expect": {"value": 1, "steps": 0, "allocated": 0}},
  {"name": "if: the else branch taken is evaluated and can fail", "source": "if (c) { 1 } else { 1 / d }", "env": "{c: any, d: any}", "vars": {"c": false, "d": 0}, "expect": {"phase": "run", "diagnostics": [{"code": "divide-by-zero", "span": [1, 21, 1, 26], "message": "the divisor of / is zero"}], "steps": 1, "allocated": 0}},
  {"name": "if: each test evaluated is charged, and the branch taken", "source": "if (x > 10) { x * 2 } else if (x > 0) { x * 3 } else { 0 }", "env": "{x: any}", "vars": {"x": 5}, "expect": {"value": 15, "steps": 3, "allocated": 0}},
  {"name": "if: the first branch charges only the first test", "source": "if (x > 10) { x * 2 } else if (x > 0) { x * 3 } else { 0 }", "env": "{x: any}", "vars": {"x": 20}, "expect": {"value": 40, "steps": 2, "allocated": 0}},
  {"name": "if: the else branch after two tests", "source": "if (x > 10) { x * 2 } else if (x > 0) { x * 3 } else { 0 }", "env": "{x: any}", "vars": {"x": -1}, "expect": {"value": 0, "steps": 2, "allocated": 0}},
  {"name": "if: an if gives the value of its branch, a map", "source": "if (c) { {id: 1} } else { {id: 2} }", "env": "{c: any}", "vars": {"c": true}, "expect": {"value": {"id": 1}, "steps": 0, "allocated": 3}},
  {"name": "if: an if as a lambda body", "source": "xs.map(x => if (x > 1) { \"big\" } else { \"small\" })", "env": "{xs: any}", "vars": {"xs": [1, 2]}, "expect": {"value": ["small", "big"], "steps": 8, "allocated": 3}},
  {"name": "if: an if in parentheses as an operand", "source": "(if (c) { 1 } else { 2 }) + 3", "env": "{c: any}", "vars": {"c": true}, "expect": {"value": 4, "steps": 1, "allocated": 0}},
  {"name": "if: an if as the value of a const", "source": "const v = if (c) { \"y\" } else { \"n\" }; v", "env": "{c: any}", "vars": {"c": 0}, "expect": {"value": "n", "steps": 0, "allocated": 0}},
  {"name": "if: an if in a list item is evaluated once", "source": "[if (c) { a + 1 } else { a - 1 }, a]", "env": "{c: any, a: any}", "vars": {"c": null, "a": 1}, "expect": {"value": [0, 1], "steps": 1, "allocated": 3}},
  {"name": "?:: the false branch is not evaluated", "source": "c ? 1 : 1 / d", "env": "{c: any, d: any}", "vars": {"c": true, "d": 0}, "expect": {"value": 1, "steps": 0, "allocated": 0}},
  {"name": "?:: the true branch is not evaluated", "source": "c ? 1 / d : 2", "env": "{c: any, d: any}", "vars": {"c": false, "d": 0}, "expect": {"value": 2, "steps": 0, "allocated": 0}},
  {"name": "?:: a ? b : c ? d : e groups to the right", "source": "a ? 1 : b ? 2 : 3", "env": "{a: any, b: any}", "vars": {"a": false, "b": true}, "expect": {"value": 2, "steps": 0, "allocated": 0}},
  {"name": "&&: a falsy left operand is the value, and the right is not evaluated", "source": "a && 1 / d", "env": "{a: any, d: any}", "vars": {"a": 0, "d": 0}, "expect": {"value": 0, "steps": 0, "allocated": 0}},
  {"name": "&&: a truthy left operand gives the right operand", "source": "a && b", "env": "{a: any, b: any}", "vars": {"a": 1, "b": "x"}, "expect": {"value": "x", "steps": 0, "allocated": 0}},
  {"name": "||: a truthy left operand is the value, and the right is not evaluated", "source": "a || 1 / d", "env": "{a: any, d: any}", "vars": {"a": "s", "d": 0}, "expect": {"value": "s", "steps": 0, "allocated": 0}},
  {"name": "||: a falsy left operand gives the right operand", "source": "a || b", "env": "{a: any, b: any}", "vars": {"a": [], "b": [2]}, "expect": {"value": [2], "steps": 0, "allocated": 0}},
  {"name": "if: a test that is a library call", "source": "if (len(xs) > 0) { xs[0] } else { \"none\" }", "env": "{xs: any}", "vars": {"xs": [7]}, "expect": {"value": 7, "steps": 3, "allocated": 0}},
  {"name": "if: a test that is a call by name", "source": "const big = n => n > 9; if (big(x)) { 1 } else { 0 }", "env": "{x: any}", "vars": {"x": 3}, "expect": {"value": 0, "steps": 3, "allocated": 0}},
  {"name": "if: an else-if chain of five tests takes the last branch", "source": "if (x == 1) { 1 } else if (x == 2) { 2 } else if (x == 3) { 3 } else if (x == 4) { 4 } else if (x == 5) { 5 } else { 0 }", "env": "{x: any}", "vars": {"x": 5}, "expect": {"value": 5, "steps": 5, "allocated": 0}}
]
