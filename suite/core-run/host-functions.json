[
  {"name": "a host function's result is the value of its call", "source": "f()", "functions": {"f": {"type": "() => int", "calls": [{"result": 7}]}}, "expect": {"value": 7, "steps": 1, "allocated": 0}},
  {"name": "rows are tried in order and the first that matches answers", "source": "[f(2), f(1), f(5)]", "functions": {"f": {"type": "(n: int) => string", "calls": [{"args": [1], "result": "one"}, {"args": [2], "result": "two"}, {"result": "many"}]}}, "expect": {"value": ["two", "one", "many"], "steps": 3, "allocated": 4}},
  {"name": "a row's arguments match by ==, so 2.0 matches 2", "source": "f(2)", "functions": {"f": {"type": "(n: int) => string", "calls": [{"args": [2.0], "result": "two"}]}}, "expect": {"value": "two", "steps": 1, "allocated": 0}},
  {"name": "a row matches a map argument by ==", "source": "f({a: 1})", "functions": {"f": {"type": "(m: {a: int}) => int", "calls": [{"args": [{"a": 1}], "result": 1}]}}, "expect": {"value": 1, "steps": 1, "allocated": 3}},
  {"name": "a row with more arguments than the call does not match", "source": "f(1)", "functions": {"f": {"type": "(a: int, b?: int) => int", "calls": [{"args": [1, 2], "result": 12}, {"args": [1], "result": 1}]}}, "expect": {"value": 1, "steps": 1, "allocated": 0}},
  {"name": "an optional parameter given and left out", "source": "[f(1), f(1, 2)]", "functions": {"f": {"type": "(a: int, b?: int) => int", "calls": [{"args": [1, 2], "result": 12}, {"args": [1], "result": 1}]}}, "expect": {"value": [1, 12], "steps": 2, "allocated": 3}},
  {"name": "a rest parameter takes no argument or several", "source": "[f(), f(1, 2, 3)]", "functions": {"f": {"type": "(...xs: int[]) => int", "calls": [{"args": [], "result": 0}, {"args": [1, 2, 3], "result": 6}]}}, "expect": {"value": [0, 6], "steps": 2, "allocated": 3}},
  {"name": "a call is never cached: each call charges", "source": "[f(), f()]", "functions": {"f": {"type": "() => int", "calls": [{"result": 1, "charge": 2}]}}, "expect": {"value": [1, 1], "steps": 6, "allocated": 3}},
  {"name": "charge adds steps and allocate adds units", "source": "h(x) + 1", "env": "{x: int}", "vars": {"x": 1}, "functions": {"h": {"type": "(n: int) => int", "calls": [{"result": 10, "charge": 3, "allocate": 2}]}}, "expect": {"value": 11, "steps": 5, "allocated": 2}},
  {"name": "a charge and an allocate of zero add nothing", "source": "f()", "functions": {"f": {"type": "() => int", "calls": [{"result": 1, "charge": 0, "allocate": 0}]}}, "expect": {"value": 1, "steps": 1, "allocated": 0}},
  {"name": "a list result is a host value and is not charged units", "source": "f()", "functions": {"f": {"type": "() => int[]", "calls": [{"result": [1, 2, 3]}]}}, "expect": {"value": [1, 2, 3], "steps": 1, "allocated": 0}},
  {"name": "an index into a host function's result", "source": "f()[1]", "functions": {"f": {"type": "() => int[]", "calls": [{"result": [1, 2, 3]}]}}, "expect": {"value": 2, "steps": 2, "allocated": 0}},
  {"name": "a field of a host function's result", "source": "f().a", "functions": {"f": {"type": "() => {a: string}", "calls": [{"result": {"a": "x"}}]}}, "expect": {"value": "x", "steps": 2, "allocated": 0}},
  {"name": "a null result from a function that may return null", "source": "f() ?? 0", "functions": {"f": {"type": "() => int | null", "calls": [{"result": null}]}}, "expect": {"value": 0, "steps": 1, "allocated": 0}},
  {"name": "a host function's bool result as a test", "source": "if (f()) { 1 } else { 2 }", "functions": {"f": {"type": "() => bool", "calls": [{"result": false}]}}, "expect": {"value": 2, "steps": 1, "allocated": 0}},
  {"name": "a host function in a match subject is called once", "source": "match f() { 1 => \"a\", _ => \"b\" }", "functions": {"f": {"type": "() => int", "calls": [{"result": 1}]}}, "expect": {"value": "a", "steps": 2, "allocated": 0}},
  {"name": "arguments are evaluated before the call", "source": "f(1 + 1)", "functions": {"f": {"type": "(n: int) => string", "calls": [{"args": [2], "result": "two"}]}}, "expect": {"value": "two", "steps": 2, "allocated": 0}},
  {"name": "a host error is function-error at the span of the call", "source": "1 + rate(\"x\")", "functions": {"rate": {"type": "(code: string) => float !", "calls": [{"error": "unknown coupon"}]}}, "expect": {"phase": "run", "diagnostics": [{"code": "function-error", "span": [1, 5, 1, 14], "class": "host", "message": "unknown coupon"}], "steps": 1, "allocated": 0}},
  {"name": "a host error keeps what the stub charged", "source": "rate(\"x\")", "functions": {"rate": {"type": "(code: string) => float !", "calls": [{"error": "unknown coupon", "charge": 4, "allocate": 3}]}}, "expect": {"phase": "run", "diagnostics": [{"code": "function-error"}], "steps": 5, "allocated": 3}},
  {"name": "try catches a host error", "source": "try { rate(\"x\") } catch (err) { err.code }", "functions": {"rate": {"type": "(code: string) => float !", "calls": [{"error": "unknown coupon"}]}}, "expect": {"value": "function-error", "steps": 2, "allocated": 9}},
  {"name": "the message of a caught host error is the host's text", "source": "try { rate(\"x\") } catch (err) { err.message }", "functions": {"rate": {"type": "(code: string) => float !", "calls": [{"error": "unknown coupon"}]}}, "expect": {"value": "unknown coupon", "steps": 2, "allocated": 9}},
  {"name": "a caught host error has null data", "source": "try { rate(\"x\") } catch (err) { err.data }", "functions": {"rate": {"type": "(code: string) => float !", "calls": [{"error": "unknown coupon"}]}}, "expect": {"value": null, "steps": 2, "allocated": 9}},
  {"name": "a host error caught by catch with no name costs nothing more", "source": "try { rate(\"x\") } catch { 0.5 }", "functions": {"rate": {"type": "(code: string) => float !", "calls": [{"error": "unknown coupon"}]}}, "expect": {"value": 0.5, "steps": 1, "allocated": 0}},
  {"name": "the error value is charged though the handler does not read it", "source": "try { rate(\"x\") } catch (err) { 0 }", "functions": {"rate": {"type": "(code: string) => float !", "calls": [{"error": "unknown coupon"}]}}, "expect": {"value": 0, "steps": 1, "allocated": 9}},
  {"name": "a host error's long text is the message, whole, and is not charged", "source": "try { f() } catch (err) { err.message }", "functions": {"f": {"type": "() => int !", "calls": [{"error": "the coupon service refused the code because the account that owns it is locked for review"}]}}, "expect": {"value": "the coupon service refused the code because the account that owns it is locked for review", "steps": 2, "allocated": 9}},
  {"name": "an uncaught host error's message is its text, whole", "source": "f()", "functions": {"f": {"type": "() => int !", "calls": [{"error": "the coupon service refused the code because the account that owns it is locked for review"}]}}, "expect": {"phase": "run", "diagnostics": [{"code": "function-error", "message": "the coupon service refused the code because the account that owns it is locked for review"}], "steps": 1, "allocated": 0}},
  {"name": "a host error in a const line whose name is not used fails the run", "source": "const r = rate(\"x\"); 1", "functions": {"rate": {"type": "(code: string) => float !", "calls": [{"error": "unknown coupon"}]}}, "expect": {"phase": "run", "diagnostics": [{"code": "function-error", "span": [1, 11, 1, 20]}], "steps": 1, "allocated": 0}},
  {"name": "a host function on a branch not taken is not called", "source": "ok ? rate(\"x\") : 0", "env": "{ok: bool}", "vars": {"ok": false}, "functions": {"rate": "(code: string) => float !"}, "expect": {"value": 0, "steps": 0, "allocated": 0}},
  {"name": "a host function whose argument fails is not called", "source": "rate(s.code)", "env": "{s: map<any>}", "vars": {"s": {}}, "functions": {"rate": "(code: string) => float !"}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 6, 1, 12], "message": "the map has no field code"}], "steps": 1, "allocated": 0}},
  {"name": "a charge past the step limit is steps-exceeded", "source": "f()", "limits": {"steps": 5}, "functions": {"f": {"type": "() => int", "calls": [{"result": 1, "charge": 10}]}}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded"}]}},
  {"name": "a charge that meets the step limit exactly passes", "source": "f()", "limits": {"steps": 5}, "functions": {"f": {"type": "() => int", "calls": [{"result": 1, "charge": 4}]}}, "expect": {"value": 1, "steps": 5, "allocated": 0}},
  {"name": "an allocate past the allocation limit is allocation-exceeded", "source": "f()", "limits": {"allocation": 5}, "functions": {"f": {"type": "() => int", "calls": [{"result": 1, "allocate": 10}]}}, "expect": {"phase": "run", "diagnostics": [{"code": "allocation-exceeded"}]}},
  {"name": "an allocate that meets the allocation limit exactly passes", "source": "f()", "limits": {"allocation": 5}, "functions": {"f": {"type": "() => int", "calls": [{"result": 1, "allocate": 5}]}}, "expect": {"value": 1, "steps": 1, "allocated": 5}},
  {"name": "a stub charges steps before units, so both past their limits is steps-exceeded", "source": "f()", "limits": {"steps": 5, "allocation": 5}, "functions": {"f": {"type": "() => int", "calls": [{"result": 1, "charge": 10, "allocate": 10}]}}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded"}]}},
  {"name": "a limit failure from a host charge is not caught", "source": "try { f() } catch { 0 }", "limits": {"steps": 5}, "functions": {"f": {"type": "() => int", "calls": [{"result": 1, "charge": 10}]}}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded"}]}},
  {"name": "the call's own step can pass the step limit", "source": "f()", "limits": {"steps": 0}, "functions": {"f": {"type": "() => int", "calls": [{"result": 1}]}}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded"}]}},
  {"name": "a result outside its declared type fails where it is read", "source": "f() + 1", "precondition": false, "functions": {"f": {"type": "() => int", "calls": [{"result": "x"}]}}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 8], "class": "environment", "message": "cannot apply + to string and number"}], "steps": 1, "allocated": 0}},
  {"name": "a result outside its declared type is returned as it is when nothing reads it", "source": "f()", "precondition": false, "functions": {"f": {"type": "() => int", "calls": [{"result": "x"}]}}, "expect": {"value": "x", "steps": 1, "allocated": 0}},
  {"name": "a null result where the declared type has none is null-operand where it is read", "source": "f().a", "precondition": false, "functions": {"f": {"type": "() => {a: int}", "calls": [{"result": null}]}}, "expect": {"phase": "run", "diagnostics": [{"code": "null-operand", "span": [1, 1, 1, 6], "class": "environment", "message": "cannot read field a of null"}], "steps": 1, "allocated": 0}},
  {"name": "a host function named like a library method is called (AG1)", "source": "trim(\"a b\")", "functions": {"trim": {"type": "(s: string) => string", "calls": [{"result": "ab"}]}}, "expect": {"value": "ab", "steps": 1, "allocated": 0}}
