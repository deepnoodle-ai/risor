   "vars": {
    "x": 5
   },
   "expect": {
    "value": 0
   }
  },
  {
   "name": "try: the catch name",
   "source": "try { [1][x] } catch (e) { e.code }",
   "env": "{x: int}",
   "vars": {
    "x": 5
   },
   "expect": {
    "value": "index-range"
   }
  },
  {
   "name": "try: a body with a const line",
   "source": "try { const a = [1][x]; a } catch { 0 }",
   "env": "{x: int}",
   "vars": {
    "x": 5
   },
   "expect": {
    "value": 0
   }
  },
  {
   "name": "try: a handler with a const line",
   "source": "try { 1 / x } catch (e) { const c = e.code; c }",
   "env": "{x: int}",
   "vars": {
    "x": 0
   },
   "expect": {
    "value": "divide-by-zero"
   }
  },
  {
   "name": "a parenthesized try is an operand",
   "source": "(try { 1 } catch { 2 }) + 1",
   "expect": {
    "value": 2
   }
  },
  {
   "name": "a try as a list item",
   "source": "[try { 1 } catch { 2 }]",
   "expect": {
    "value": [
     1
    ]
   }
  },
  {
   "name": "match: the first arm",
   "source": "match x { 1 => \"one\", 2 | 3 => \"few\", _ => \"many\" }",
   "env": "{x: int}",
   "vars": {
    "x": 1
   },
   "expect": {
    "value": "one"
   }
  },
  {
   "name": "match: a second literal joined by |",
   "source": "match x { 1 => \"one\", 2 | 3 => \"few\", _ => \"many\" }",
   "env": "{x: int}",
   "vars": {
    "x": 3
   },
   "expect": {
    "value": "few"
   }
  },
  {
   "name": "match: the default arm",
   "source": "match x { 1 => \"one\", 2 | 3 => \"few\", _ => \"many\" }",
   "env": "{x: int}",
   "vars": {
    "x": 9
   },
   "expect": {
    "value": "many"
   }
  },
  {
   "name": "match: a negative literal",
   "source": "match x { -1 => \"neg\", _ => \"other\" }",
   "env": "{x: int}",
   "vars": {
    "x": -1
   },
   "expect": {
    "value": "neg"
   }
  },
  {
   "name": "match: a hex literal",
   "source": "match x { 0x10 => 1, _ => 0 }",
   "env": "{x: int}",
   "vars": {
    "x": 16
   },
   "expect": {
    "value": 1
   }
  },
  {
   "name": "match: a fraction literal",
   "source": "match f { 1.5 => 1, _ => 0 }",
   "env": "{f: float}",
   "vars": {
    "f": 1.5
   },
   "expect": {
    "value": 1
   }
  },
  {
   "name": "match: a trailing comma",
   "source": "match x { 1 => 10, _ => 20, }",
   "env": "{x: int}",
   "vars": {
    "x": 1
   },
   "expect": {
    "value": 10
   }
  },
  {
   "name": "match: string literals in both quotes",
   "source": "match s { \"a\" => 1, 'b' => 2, _ => 0 }",
   "env": "{s: string}",
   "vars": {
    "s": "b"
   },
   "expect": {
    "value": 2
   }
  },
  {
   "name": "match: bool literals",
   "source": "match b { true => 1, false => 0 }",
   "env": "{b: bool}",
   "vars": {
    "b": false
   },
   "expect": {
    "value": 0
   }
  },
  {
   "name": "match: a null literal",
   "source": "match v { null => 0, _ => 1 }",
   "env": "{v: int | null}",
   "vars": {
    "v": null
   },
   "expect": {
    "value": 0
   }
  },
  {
   "name": "match: the subject is a binary expression",
   "source": "match x + 1 { 2 => \"two\", _ => \"x\" }",
   "env": "{x: int}",
   "vars": {
    "x": 1
   },
   "expect": {
    "value": "two"
   }
  },
  {
   "name": "match: a parenthesized subject",
   "source": "match (x) { _ => 1 }",
   "env": "{x: int}",
   "vars": {
    "x": 1
   },
   "expect": {
    "value": 1
   }
  },
  {
   "name": "match: a parenthesized map read as subject",
   "source": "match ({a: x}.a) { 3 => 1, _ => 0 }",
   "env": "{x: int}",
   "vars": {
    "x": 3
   },
   "expect": {
    "value": 1
   }
  },
  {
   "name": "match: only the default arm",
   "source": "match x { _ => 0 }",
   "env": "{x: int}",
   "vars": {
    "x": 1
   },
   "expect": {
    "value": 0
   }
  },
  {
   "name": "match: arms on several lines",
   "source": "match x {\n  1 => 2,\n  _ => 3\n}",
   "env": "{x: int}",
   "vars": {
    "x": 1
   },
   "expect": {
    "value": 2
   }
  },
  {
   "name": "match: an if as an arm's result",
   "source": "match x { 1 => if (x) { 2 } else { 3 }, _ => 4 }",
   "env": "{x: int}",
   "vars": {
    "x": 1
   },
   "expect": {
    "value": 2
   }
  },
  {
   "name": "match is an operand",
   "source": "match x { 1 => 2, _ => 3 } + 1",
   "env": "{x: int}",
   "vars": {
    "x": 1
   },
   "expect": {
    "value": 3
   }
  },
  {
   "name": "match is an operand on the right",
   "source": "1 + match x { _ => 2 }",
   "env": "{x: int}",
   "vars": {
    "x": 1
   },
   "expect": {
    "value": 3
   }
  }
 ]
}
