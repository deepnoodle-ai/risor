[
  {"name": "a namespaced host function is called", "source": "geo.distance(\"a\", \"b\")", "functions": {"geo.distance": {"type": "(a: string, b: string) => float", "calls": [{"result": 3.5}]}}, "expect": {"value": 3.5, "steps": 1, "allocated": 0}},
  {"name": "two functions in one namespace", "source": "[geo.distance(\"a\", \"b\"), geo.area(\"a\")]", "functions": {"geo.distance": {"type": "(a: string, b: string) => float", "calls": [{"result": 3.5}]}, "geo.area": {"type": "(a: string) => int", "calls": [{"result": 2}]}}, "expect": {"value": [3.5, 2], "steps": 2, "allocated": 3}},
  {"name": "a namespaced host function and a library function with one name", "source": "[geo.len(\"ab\"), len(\"ab\")]", "functions": {"geo.len": {"type": "(s: string) => int", "calls": [{"result": 99}]}}, "expect": {"value": [99, 2], "steps": 2, "allocated": 3}},
  {"name": "a const may be named like a namespaced function's name", "source": "const distance = 1; geo.distance(\"a\", \"b\") + distance", "functions": {"geo.distance": {"type": "(a: string, b: string) => float", "calls": [{"result": 3.5}]}}, "expect": {"value": 4.5, "steps": 2, "allocated": 0}},
  {"name": "a namespaced host error spans the call from its namespace", "source": "geo.distance(\"a\", \"b\")", "functions": {"geo.distance": {"type": "(a: string, b: string) => float !", "calls": [{"error": "no route"}]}}, "expect": {"phase": "run", "diagnostics": [{"code": "function-error", "span": [1, 1, 1, 23], "class": "host", "message": "no route"}], "steps": 1, "allocated": 0}},
  {"name": "a namespaced call in a callback charges for each call", "source": "xs.map(x => geo.f(x))", "env": "{xs: int[]}", "vars": {"xs": [1, 2]}, "functions": {"geo.f": {"type": "(n: int) => int", "calls": [{"args": [1], "result": 10, "charge": 1}, {"args": [2], "result": 20, "charge": 1}]}}, "expect": {"value": [10, 20], "steps": 10, "allocated": 3}},
  {"name": "a namespaced function on a branch not taken is not called", "source": "ok ? geo.distance(\"a\", \"b\") : 0.0", "env": "{ok: bool}", "vars": {"ok": false}, "functions": {"geo.distance": "(a: string, b: string) => float"}, "expect": {"value": 0, "steps": 0, "allocated": 0}}
]
