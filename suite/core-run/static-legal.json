{
 "env": "{n: int, s: string, ok: bool, xs: int[], m: {a: int, b: string}, blob: any}",
 "functions": {"rate": "(code: string) => float !", "opt": "(s: string, n?: int) => string", "many": "(a: int, ...rest: int[]) => int", "geo.distance": "(a: string, b: string) => float"},
 "cases": [
  {"name": "a method name with no call is a field read", "source": "m.keys", "env": "{m: {keys: int}}", "vars": {"m": {"keys": 3}}, "expect": {"value": 3, "steps": 1, "allocated": 0}},
  {"name": "a method call calls the method though the map has a key of its name", "source": "m.keys()", "env": "{m: {keys: int}}", "vars": {"m": {"keys": 3}}, "expect": {"value": ["keys"], "steps": 2, "allocated": 2}},
  {"name": "a const may shadow a library function", "source": "const len = 3; len + 1", "expect": {"value": 4, "steps": 1, "allocated": 0}},
  {"name": "a parameter may shadow a variable of the environment", "source": "xs.map(n => n * 2)", "vars": {"xs": [1, 2]}, "expect": {"value": [2, 4], "steps": 8, "allocated": 3}},
  {"name": "a catch name may shadow a variable of the environment", "source": "try { fail(\"x\") } catch (e) { e.message }", "env": "{e: int}", "expect": {"value": "x", "steps": 2, "allocated": 9}},
  {"name": "a const may shadow a variable, which is then not asked for", "source": "const n = 5; n", "expect": {"value": 5, "steps": 0, "allocated": 0}},
  {"name": "a const's value reads the variable of the same name", "source": "const n = n + 1; n", "vars": {"n": 1}, "expect": {"value": 2, "steps": 1, "allocated": 0}},
  {"name": "a block may shadow a const of the program", "source": "const x = 1; { const x = 2; x }", "expect": {"value": 2, "steps": 0, "allocated": 0}},
  {"name": "two branches may bind one name", "source": "if (ok) { const v = 1; v } else { const v = 2; v }", "vars": {"ok": true}, "expect": {"value": 1, "steps": 0, "allocated": 0}},
  {"name": "a block in a lambda's body may rebind the parameter's name", "source": "xs.map(x => { const x = 1; x })", "vars": {"xs": [5, 6]}, "expect": {"value": [1, 1], "steps": 6, "allocated": 3}},
  {"name": "_ => e is a lambda with one parameter", "source": "xs.map(_ => 0)", "vars": {"xs": [1, 2]}, "expect": {"value": [0, 0], "steps": 6, "allocated": 3}},
  {"name": "_ may be written for two parameters", "source": "xs.map((_, _) => 0)", "vars": {"xs": [1, 2]}, "expect": {"value": [0, 0], "steps": 6, "allocated": 3}},
  {"name": "_ may be written twice in a list pattern", "source": "const [_, _, c] = xs; c", "vars": {"xs": [1, 2, 3]}, "expect": {"value": 3, "steps": 3, "allocated": 0}},
  {"name": "a reserved word as a map key and a field name", "source": "{if: 1}.if", "expect": {"value": 1, "steps": 1, "allocated": 3}},
  {"name": "a const-bound lambda's name passed to a method", "source": "const inc = n => n + 1; xs.map(inc)", "vars": {"xs": [1, 2]}, "expect": {"value": [2, 3], "steps": 8, "allocated": 3}},
  {"name": "a parameter may shadow a const-bound lambda and is then a value", "source": "const f = x => x; xs.map(f => f)", "vars": {"xs": [1]}, "expect": {"value": [1], "steps": 5, "allocated": 2}},
  {"name": "a variable named like a library function is a value", "source": "len + 1", "env": "{len: int}", "vars": {"len": 2}, "expect": {"value": 3, "steps": 1, "allocated": 0}},
  {"name": "a variable named like an opaque type does not clash", "source": "Time + 1", "env": "{Time: int}", "opaque": ["Time"], "vars": {"Time": 1}, "expect": {"value": 2, "steps": 1, "allocated": 0}},
  {"name": "a field of a variable's type named with a reserved word", "source": "m.if", "env": "{m: {if: int}}", "vars": {"m": {"if": 4}}, "expect": {"value": 4, "steps": 1, "allocated": 0}},
  {"name": "a parameter named like a host function is a value", "source": "xs.map(rate => rate)", "vars": {"xs": [7]}, "expect": {"value": [7], "steps": 4, "allocated": 2}},
  {"name": "a match with _ last", "source": "match n { 1 => \"one\", _ => \"other\" }", "vars": {"n": 2}, "expect": {"value": "other", "steps": 2, "allocated": 0}},
  {"name": "one literal in two different matches", "source": "[match n { 1 => 1, _ => 0 }, match n { 1 => 2, _ => 0 }]", "vars": {"n": 1}, "expect": {"value": [1, 2], "steps": 2, "allocated": 3}},
  {"name": "a name that only starts like a namespace is not one", "source": "const geo2 = 1; geo2", "expect": {"value": 1, "steps": 0, "allocated": 0}},
  {"name": "a variable named type is read as a value (AC15)", "source": "type + 1", "env": "{type: int}", "vars": {"type": 2}, "expect": {"value": 3, "steps": 1, "allocated": 0}},
  {"name": "a variable named max is read as a value (AC15)", "source": "max", "env": "{max: int}", "vars": {"max": 9}, "expect": {"value": 9, "steps": 0, "allocated": 0}}
 ]
}
