[
  {"name": "??: an absent field gives the default", "source": "m.f ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {}}, "expect": {"value": 0, "steps": 1, "allocated": 0}},
  {"name": "??: a present field gives its value", "source": "m.f ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {"f": 2}}, "expect": {"value": 2, "steps": 1, "allocated": 0}},
  {"name": "??: a present field that is null gives the default", "source": "m.f ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {"f": null}}, "expect": {"value": 0, "steps": 1, "allocated": 0}},
  {"name": "??: a present field that is false gives false", "source": "m.f ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {"f": false}}, "expect": {"value": false, "steps": 1, "allocated": 0}},
  {"name": "??: an absent key read with a string literal gives the default", "source": "m[\"f\"] ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {}}, "expect": {"value": 0, "steps": 1, "allocated": 0}},
  {"name": "??: a template with no interpolation is a String node", "source": "m[`f`] ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {}}, "expect": {"value": 0, "steps": 1, "allocated": 0}},
  {"name": "??: parentheses have no node", "source": "(m.f) ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {}}, "expect": {"value": 0, "steps": 1, "allocated": 0}},
  {"name": "??: a chain of three operands, the first two absent", "source": "m.f ?? n.g ?? 3", "env": "{m: any, n: any, k: any}", "vars": {"m": {}, "n": {}}, "expect": {"value": 3, "steps": 2, "allocated": 0}},
  {"name": "??: a chain of three operands, the second present", "source": "m.f ?? n.g ?? 3", "env": "{m: any, n: any, k: any}", "vars": {"m": {}, "n": {"g": 2}}, "expect": {"value": 2, "steps": 2, "allocated": 0}},
  {"name": "??: a chain of three operands, the first present, the second not evaluated", "source": "m.f ?? n.g ?? 3", "env": "{m: any, n: any, k: any}", "vars": {"m": {"f": 1}, "n": null}, "expect": {"value": 1, "steps": 1, "allocated": 0}},
  {"name": "??: a chain with parentheses on the right", "source": "m.f ?? (n.g ?? 3)", "env": "{m: any, n: any, k: any}", "vars": {"m": {}, "n": {}}, "expect": {"value": 3, "steps": 2, "allocated": 0}},
  {"name": "??: a chain of four operands", "source": "m.a ?? m.b ?? m[\"c\"] ?? 4", "env": "{m: any, n: any, k: any}", "vars": {"m": {}}, "expect": {"value": 4, "steps": 3, "allocated": 0}},
  {"name": "??: the last operand is not a coalesced read", "source": "m.f ?? n.g", "env": "{m: any, n: any, k: any}", "vars": {"m": {}, "n": {}}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 8, 1, 11], "class": "dynamic", "message": "the map has no field g"}], "steps": 2, "allocated": 0}},
  {"name": "??: the last operand after null is not a coalesced read", "source": "k ?? m.f", "env": "{m: any, n: any, k: any}", "vars": {"m": {}, "k": null}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 6, 1, 9], "class": "dynamic", "message": "the map has no field f"}], "steps": 1, "allocated": 0}},
  {"name": "??: the last operand of a chain with parentheses on the right", "source": "m.f ?? (n.g ?? n.h)", "env": "{m: any, n: any, k: any}", "vars": {"m": {}, "n": {}}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 16, 1, 19], "class": "dynamic", "message": "the map has no field h"}], "steps": 3, "allocated": 0}},
  {"name": "??: only the last step is coalesced", "source": "m.b.c ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {}}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 1, 4], "class": "dynamic", "message": "the map has no field b"}], "steps": 1, "allocated": 0}},
  {"name": "??: a step after ?. that finds a map without the key gives the default", "source": "m?.b.c ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {"b": {}}}, "expect": {"value": 0, "steps": 2, "allocated": 0}},
  {"name": "??: a step after ?. that gives null fails on null", "source": "m?.b.c ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {"b": null}}, "expect": {"phase": "run", "diagnostics": [{"code": "null-operand", "span": [1, 1, 1, 7], "class": "dynamic", "message": "cannot read field c of null"}], "steps": 1, "allocated": 0}},
  {"name": "??: a step after ?. on an absent key fails on null", "source": "m?.b.c ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {}}, "expect": {"phase": "run", "diagnostics": [{"code": "null-operand", "span": [1, 1, 1, 7], "class": "dynamic", "message": "cannot read field c of null"}], "steps": 1, "allocated": 0}},
  {"name": "??: a null receiver of ?. gives the default", "source": "m?.b.c ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": null}, "expect": {"value": 0, "steps": 0, "allocated": 0}},
  {"name": "??: a null receiver of the last step still fails", "source": "m.f ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": null}, "expect": {"phase": "run", "diagnostics": [{"code": "null-operand", "span": [1, 1, 1, 4], "class": "dynamic", "message": "cannot read field f of null"}], "steps": 0, "allocated": 0}},
  {"name": "??: a receiver of another kind still fails", "source": "m.f ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": 5}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 4], "class": "dynamic", "message": "cannot read field f of a value of kind number"}], "steps": 0, "allocated": 0}},
  {"name": "??: a string literal key on a list still fails", "source": "m[\"f\"] ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": [1]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 7], "class": "dynamic", "message": "expected a whole number, found \"f\""}], "steps": 0, "allocated": 0}},
  {"name": "??: a computed key is not a coalesced read", "source": "m[k] ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {}, "k": "f"}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 1, 5], "class": "dynamic", "message": "the map has no key \"f\""}], "steps": 1, "allocated": 0}},
  {"name": "??: a template with an interpolation is not a String node", "source": "m[`${k}`] ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {}, "k": "f"}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 1, 10], "class": "dynamic", "message": "the map has no key \"f\""}], "steps": 2, "allocated": 1}},
  {"name": "??: a number index out of range still fails", "source": "m[0] ?? 1", "env": "{m: any, n: any, k: any}", "vars": {"m": []}, "expect": {"phase": "run", "diagnostics": [{"code": "index-range", "span": [1, 1, 1, 5], "class": "index", "message": "index 0 is outside the list of length 0"}], "steps": 1, "allocated": 0}},
  {"name": "||: an absent field still fails", "source": "m.f || 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {}}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 1, 4], "class": "dynamic", "message": "the map has no field f"}], "steps": 1, "allocated": 0}},
  {"name": "??: a read bound by const is not an operand of ??", "source": "const v = m.f; v ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {}}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 11, 1, 14], "class": "dynamic", "message": "the map has no field f"}], "steps": 1, "allocated": 0}},
  {"name": "??: a coalesced read in the body of a lambda", "source": "n.map(x => x.f ?? 0)", "env": "{m: any, n: any, k: any}", "vars": {"n": [{}, {"f": 1}]}, "expect": {"value": [0, 1], "steps": 8, "allocated": 3}},
  {"name": "??: a coalesced read in a tested position", "source": "if (m.f ?? false) { 1 } else { 2 }", "env": "{m: any, n: any, k: any}", "vars": {"m": {}}, "expect": {"value": 2, "steps": 1, "allocated": 0}},
  {"name": "??: a step after a method call is a coalesced read", "source": "m.values()[0].f ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {"a": {}}}, "expect": {"value": 0, "steps": 4, "allocated": 2}},
  {"name": "??: an absent long key charges its size, as when it is present", "source": "m.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {}}, "expect": {"value": 0, "steps": 3, "allocated": 0}},
  {"name": "??: a present long key charges the same", "source": "m.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa ?? 0", "env": "{m: any, n: any, k: any}", "vars": {"m": {"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": 1}}, "expect": {"value": 1, "steps": 3, "allocated": 0}},
  {"name": "??: a typed record that lacks a required field gives the default (03-host.md 3.4.8 item 2)", "source": "x.id ?? 0", "env": "{x: {id: int}}", "vars": {"x": {}}, "precondition": false, "expect": {"value": 0, "steps": 1, "allocated": 0}},
  {"name": "??: the same record read without ?? fails", "source": "x.id", "env": "{x: {id: int}}", "vars": {"x": {}}, "precondition": false, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 1, 5], "class": "environment", "message": "the map has no field id"}], "steps": 1, "allocated": 0}},
  {"name": "??: a key that the type does not allow, compiled without the type rules, gives the default", "source": "x.nmae ?? 0", "env": "{x: {id: int}}", "vars": {"x": {"id": 1}}, "check": false, "expect": {"value": 0, "steps": 1, "allocated": 0}},
  {"name": "??: an optional field, typed", "source": "x.note ?? \"\"", "env": "{x: {id: int, note?: string}}", "vars": {"x": {"id": 1}}, "expect": {"value": "", "steps": 1, "allocated": 0}},
  {"name": "??: a field of map<int>, typed", "source": "x.a ?? x.b ?? 0", "env": "{x: map<int>}", "vars": {"x": {"b": 2}}, "expect": {"value": 2, "steps": 2, "allocated": 0}}
