[
  {"name": "steps: a call by name, exactly at the limit", "source": "const f = x => x * 2; f(3)", "limits": {"steps": 3}, "expect": {"value": 6, "steps": 3, "allocated": 0}},
  {"name": "steps: a call by name, one below the limit", "source": "const f = x => x * 2; f(3)", "limits": {"steps": 2}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded", "message": "the run needed more than its limit of 2 steps"}]}},
  {"name": "steps: a map over three elements, exactly at the limit", "source": "xs.map(x => x * 2)", "env": "{xs: any}", "limits": {"steps": 11}, "vars": {"xs": [1, 2, 3]}, "expect": {"value": [2, 4, 6], "steps": 11, "allocated": 4}},
  {"name": "steps: a map over three elements, one below the limit", "source": "xs.map(x => x * 2)", "env": "{xs: any}", "limits": {"steps": 10}, "vars": {"xs": [1, 2, 3]}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded", "message": "the run needed more than its limit of 10 steps"}]}},
  {"name": "steps: a caught failure charges its message, exactly at the limit", "source": "try { 1 / d } catch (e) { 0 }", "env": "{d: any}", "limits": {"steps": 2}, "vars": {"d": 0}, "expect": {"value": 0, "steps": 2, "allocated": 10}},
  {"name": "steps: a caught failure charges its message, one below the limit", "source": "try { 1 / d } catch (e) { 0 }", "env": "{d: any}", "limits": {"steps": 1}, "vars": {"d": 0}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded", "message": "the run needed more than its limit of 1 steps"}]}},
  {"name": "steps: catch without a name, exactly at the limit", "source": "try { 1 / d } catch { 0 }", "env": "{d: any}", "limits": {"steps": 1}, "vars": {"d": 0}, "expect": {"value": 0, "steps": 1, "allocated": 0}},
  {"name": "steps: catch without a name, one below the limit", "source": "try { 1 / d } catch { 0 }", "env": "{d: any}", "limits": {"steps": 0}, "vars": {"d": 0}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded", "message": "the run needed more than its limit of 0 steps"}]}},
  {"name": "steps: a no-match that is caught, exactly at the limit", "source": "try { match x { \"a\" => 1, \"b\" => 2 } } catch { 0 }", "env": "{x: \"a\" | \"b\"}", "limits": {"steps": 2}, "precondition": false, "vars": {"x": "c"}, "expect": {"value": 0, "steps": 2, "allocated": 0}},
  {"name": "steps: a no-match that is caught, one below the limit", "source": "try { match x { \"a\" => 1, \"b\" => 2 } } catch { 0 }", "env": "{x: \"a\" | \"b\"}", "limits": {"steps": 1}, "precondition": false, "vars": {"x": "c"}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded", "message": "the run needed more than its limit of 1 steps"}]}},
  {"name": "steps: a pattern with a default, exactly at the limit", "source": "const {a, b = a + 1} = m; b", "env": "{m: any}", "limits": {"steps": 3}, "vars": {"m": {"a": 1}}, "expect": {"value": 2, "steps": 3, "allocated": 0}},
  {"name": "steps: a pattern with a default, one below the limit", "source": "const {a, b = a + 1} = m; b", "env": "{m: any}", "limits": {"steps": 2}, "vars": {"m": {"a": 1}}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded", "message": "the run needed more than its limit of 2 steps"}]}},
  {"name": "allocation: a list literal, exactly at the limit", "source": "[1, 2, 3]", "limits": {"allocation": 4}, "expect": {"value": [1, 2, 3], "steps": 0, "allocated": 4}},
  {"name": "allocation: a list literal, one below the limit", "source": "[1, 2, 3]", "limits": {"allocation": 3}, "expect": {"phase": "run", "diagnostics": [{"code": "allocation-exceeded", "message": "the run needed more than its limit of 3 allocation units"}]}},
  {"name": "allocation: a map literal, exactly at the limit", "source": "{a: 1, b: 2}", "limits": {"allocation": 5}, "expect": {"value": {"a": 1, "b": 2}, "steps": 0, "allocated": 5}},
  {"name": "allocation: a map literal, one below the limit", "source": "{a: 1, b: 2}", "limits": {"allocation": 4}, "expect": {"phase": "run", "diagnostics": [{"code": "allocation-exceeded", "message": "the run needed more than its limit of 4 allocation units"}]}},
  {"name": "allocation: the rest of a list pattern, exactly at the limit", "source": "const [a, ...r] = xs; r", "env": "{xs: any}", "limits": {"allocation": 3}, "vars": {"xs": [1, 2, 3]}, "expect": {"value": [2, 3], "steps": 3, "allocated": 3}},
  {"name": "allocation: the rest of a list pattern, one below the limit", "source": "const [a, ...r] = xs; r", "env": "{xs: any}", "limits": {"allocation": 2}, "vars": {"xs": [1, 2, 3]}, "expect": {"phase": "run", "diagnostics": [{"code": "allocation-exceeded", "message": "the run needed more than its limit of 2 allocation units"}]}},
  {"name": "allocation: the error value, exactly at the limit", "source": "try { 1 / d } catch (e) { 0 }", "env": "{d: any}", "limits": {"allocation": 10}, "vars": {"d": 0}, "expect": {"value": 0, "steps": 2, "allocated": 10}},
  {"name": "allocation: the error value, one below the limit", "source": "try { 1 / d } catch (e) { 0 }", "env": "{d: any}", "limits": {"allocation": 9}, "vars": {"d": 0}, "expect": {"phase": "run", "diagnostics": [{"code": "allocation-exceeded", "message": "the run needed more than its limit of 9 allocation units"}]}},
  {"name": "allocation: a try around a list, exactly at the limit", "source": "try { [1, 2, 3] } catch { 0 }", "limits": {"allocation": 4}, "expect": {"value": [1, 2, 3], "steps": 0, "allocated": 4}},
  {"name": "allocation: a try around a list, one below the limit", "source": "try { [1, 2, 3] } catch { 0 }", "limits": {"allocation": 3}, "expect": {"phase": "run", "diagnostics": [{"code": "allocation-exceeded", "message": "the run needed more than its limit of 3 allocation units"}]}},
  {"name": "allocation: map's result, exactly at the limit", "source": "xs.map(x => x)", "env": "{xs: any}", "limits": {"allocation": 3}, "vars": {"xs": [1, 2]}, "expect": {"value": [1, 2], "steps": 6, "allocated": 3}},
  {"name": "allocation: map's result, one below the limit", "source": "xs.map(x => x)", "env": "{xs: any}", "limits": {"allocation": 2}, "vars": {"xs": [1, 2]}, "expect": {"phase": "run", "diagnostics": [{"code": "allocation-exceeded", "message": "the run needed more than its limit of 2 allocation units"}]}},
  {"name": "steps: a program of one step fails under a limit of zero", "source": "[a, b][0]", "env": "{a: any, b: any}", "limits": {"steps": 0}, "vars": {"a": 1, "b": 2}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded", "message": "the run needed more than its limit of 0 steps"}]}},
  {"name": "steps: a program that charges no step passes a limit of zero", "source": "const a = 1; a", "limits": {"steps": 0}, "expect": {"value": 1, "steps": 0, "allocated": 0}},
  {"name": "allocation: a program that creates nothing passes a limit of zero", "source": "1 + 2 * 3", "limits": {"allocation": 0}, "expect": {"value": 7, "steps": 2, "allocated": 0}},
  {"name": "steps: a branch not taken is not charged against the limit", "source": "if (c) { 1 } else { xs.map(x => x) }", "env": "{c: any, xs: any}", "limits": {"steps": 0}, "vars": {"c": true, "xs": [1, 2]}, "expect": {"value": 1, "steps": 0, "allocated": 0}},
  {"name": "steps: an operand skipped by || is not charged against the limit", "source": "c || xs.map(x => x)", "env": "{c: any, xs: any}", "limits": {"steps": 0}, "vars": {"c": 1, "xs": [1, 2]}, "expect": {"value": 1, "steps": 0, "allocated": 0}},
  {"name": "steps: a result of match not chosen is not charged against the limit", "source": "match x { \"a\" => 1, _ => xs.map(y => y) }", "env": "{x: any, xs: any}", "limits": {"steps": 1}, "vars": {"x": "a", "xs": [1, 2]}, "expect": {"value": 1, "steps": 1, "allocated": 0}},
  {"name": "steps: steps are charged before units, so a charge of both fails on steps", "source": "s + t", "env": "{s: any, t: any}", "limits": {"steps": 0, "allocation": 0}, "vars": {"s": "a", "t": "b"}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded", "message": "the run needed more than its limit of 0 steps"}]}},
  {"name": "allocation: the steps pass and then the units fail", "source": "s + t", "env": "{s: any, t: any}", "limits": {"steps": 1, "allocation": 0}, "vars": {"s": "a", "t": "b"}, "expect": {"phase": "run", "diagnostics": [{"code": "allocation-exceeded", "message": "the run needed more than its limit of 0 allocation units"}]}},
  {"name": "allocation: steps and units both exactly at their limits", "source": "s + t", "env": "{s: any, t: any}", "limits": {"steps": 1, "allocation": 1}, "vars": {"s": "a", "t": "b"}, "expect": {"value": "ab", "steps": 1, "allocated": 1}},
  {"name": "allocation: a failed run exactly at the limit keeps its own code", "source": "fail(\"x\", [1])", "limits": {"allocation": 2}, "expect": {"phase": "run", "diagnostics": [{"code": "failed", "span": [1, 1, 1, 15], "message": "x", "data": [1]}], "steps": 1, "allocated": 2}},
  {"name": "allocation: a failed run whose argument passes the limit", "source": "fail(\"x\", [1])", "limits": {"allocation": 1}, "expect": {"phase": "run", "diagnostics": [{"code": "allocation-exceeded", "message": "the run needed more than its limit of 1 allocation units"}]}},
