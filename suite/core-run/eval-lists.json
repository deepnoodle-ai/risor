{
 "cases": [
  {
   "name": "the empty list",
   "source": "[]",
   "expect": {
    "value": [],
    "steps": 0,
    "allocated": 1
   }
  },
  {
   "name": "a list of three numbers",
   "source": "[1, 2, 3]",
   "expect": {
    "value": [
     1,
     2,
     3
    ],
    "steps": 0,
    "allocated": 4
   }
  },
  {
   "name": "a trailing comma",
   "source": "[1, 2, 3,]",
   "expect": {
    "value": [
     1,
     2,
     3
    ],
    "steps": 0,
    "allocated": 4
   }
  },
  {
   "name": "a list holding null",
   "source": "[null]",
   "expect": {
    "value": [
     null
    ],
    "steps": 0,
    "allocated": 2
   }
  },
  {
   "name": "nested lists are charged each",
   "source": "[[1], []]",
   "expect": {
    "value": [
     [
      1
     ],
     []
    ],
    "steps": 0,
    "allocated": 6
   }
  },
  {
   "name": "a list of every kind",
   "source": "[1, \"a\", true, null, [], {}]",
   "expect": {
    "value": [
     1,
     "a",
     true,
     null,
     [],
     {}
    ],
    "steps": 0,
    "allocated": 9
   }
  },
  {
   "name": "host values in a list are not charged",
   "source": "[x, y]",
   "env": "{x: any, y: any}",
   "vars": {
    "x": [
     1,
     2
    ],
    "y": {
     "a": 1
    }
   },
   "expect": {
    "value": [
     [
      1,
      2
     ],
     {
      "a": 1
     }
    ],
    "steps": 0,
    "allocated": 3
   }
  },
  {
   "name": "a spread of a host list",
   "source": "[...xs]",
   "env": "{xs: any}",
   "vars": {
    "xs": [
     1,
     2
    ]
   },
   "expect": {
    "value": [
     1,
     2
    ],
    "steps": 2,
    "allocated": 3
   }
  },
  {
   "name": "a spread of an empty list",
   "source": "[...[], 1]",
   "expect": {
    "value": [
     1
    ],
    "steps": 0,
    "allocated": 3
   }
  },
  {
   "name": "two spreads",
   "source": "[...[1, 2], ...[3]]",
   "expect": {
    "value": [
     1,
     2,
     3
    ],
    "steps": 3,
    "allocated": 9
   }
  },
  {
   "name": "a spread between items",
   "source": "[0, ...xs, 3]",
   "env": "{xs: any}",
   "vars": {
    "xs": [
     1,
     2
    ]
   },
   "expect": {
    "value": [
     0,
     1,
     2,
     3
    ],
    "steps": 2,
    "allocated": 5
   }
  },
  {
   "name": "one list spread twice",
   "source": "[...xs, ...xs]",
   "env": "{xs: any}",
   "vars": {
    "xs": [
     1,
     2
    ]
   },
   "expect": {
    "value": [
     1,
     2,
     1,
     2
    ],
    "steps": 4,
    "allocated": 5
   }
  },
  {
   "name": "a spread copies elements, not their contents",
