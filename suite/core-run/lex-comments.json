       2,
       1
      ]
     }
    ]
   }
  },
  {
   "name": "a token two lines down",
   "source": "1 +\n\n)",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       3,
