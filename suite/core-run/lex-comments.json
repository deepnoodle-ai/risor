      "code": "unexpected-character",
      "span": [
       1,
       2,
       1,
       3
      ]
     }
    ]
   }
  },
  {
   "name": "U+2028 is not white space",
   "source": "1 \u2028",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-character",
      "span": [
       1,
