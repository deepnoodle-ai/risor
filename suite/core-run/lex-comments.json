{
 "cases": [
  {
   "name": "a line comment after an expression",
   "source": "1 // c",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "a line comment before an expression",
   "source": "// c\n1",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "a line comment at the end of input with no text",
   "source": "1 //",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "a line comment ends at a carriage return",
   "source": "1 // c\r+ 2",
   "expect": {
    "value": 3
   }
  },
  {
   "name": "a line comment ends at a carriage return and line feed",
   "source": "1 // c\r\n+ 2",
   "expect": {
    "value": 3
   }
  },
  {
   "name": "a block comment mark inside a line comment is text",
   "source": "1 // /* \n + 2",
   "expect": {
    "value": 3
   }
  },
  {
   "name": "a block comment before an expression",
   "source": "/* c */ 1",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "a block comment after an expression",
   "source": "1 /* c */",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "an empty block comment",
   "source": "1 /**/",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "block comments do not nest",
   "source": "1 /* a /* b */ + 2",
   "expect": {
    "value": 3
   }
  },
  {
   "name": "a block comment across lines",
   "source": "/*\n\n*/ 1",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "block comments separate tokens",
   "source": "1/**/+/**/2",
   "expect": {
    "value": 3
   }
  },
  {
   "name": "a block comment of stars",
   "source": "1 /***/ + 2",
   "expect": {
    "value": 3
   }
  },
  {
   "name": "a star and a slash apart do not end a block comment",
   "source": "/* * / */ 1",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "a line comment mark inside a block comment is text",
   "source": "/* // */ 1",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "white space: tabs",
   "source": "1\t+\t2",
   "expect": {
    "value": 3
   }
  },
  {
   "name": "white space: line feeds",
   "source": "1\n+\n2",
   "expect": {
    "value": 3
   }
  },
  {
   "name": "white space: carriage returns",
   "source": "1\r+\r2",
   "expect": {
    "value": 3
   }
  },
  {
   "name": "white space: carriage return and line feed pairs",
   "source": "1\r\n+\r\n2",
   "expect": {
    "value": 3
   }
  },
  {
   "name": "white space around a program",
   "source": " \t\n 1 \n",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "a U+FEFF at the start is ignored",
   "source": "\ufeff1",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "a U+FEFF at the start then white space",
   "source": "\ufeff 1",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "an unterminated block comment",
   "source": "/* a",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unterminated-comment",
      "span": [
       1,
       1,
       1,
       3
      ]
     }
    ]
   }
  },
  {
   "name": "an unterminated block comment after an expression",
   "source": "1 /* /* a",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unterminated-comment",
      "span": [
       1,
       3,
       1,
       5
      ]
     }
    ]
   }
  },
  {
   "name": "an unterminated block comment across lines",
   "source": "1\n/*\n\n",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unterminated-comment",
      "span": [
       2,
       1,
       2,
       3
      ]
     }
    ]
   }
  },
  {
   "name": "after a block comment the rest is text again",
   "source": "/* a /* b */ c */",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       17,
       1,
       18
      ]
     }
    ]
   }
  },
  {
   "name": "the empty text",
   "source": "",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       1,
       1,
       1
      ]
     }
    ]
   }
  },
  {
   "name": "only a line comment",
   "source": "// c",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       5,
       1,
       5
      ]
     }
    ]
   }
  },
  {
   "name": "only a block comment",
   "source": "/* c */",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       8,
       1,
       8
      ]
     }
    ]
   }
  },
  {
   "name": "only spaces",
   "source": "   ",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       4,
       1,
       4
      ]
     }
    ]
   }
  },
  {
   "name": "only a line feed",
   "source": "\n",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       2,
       1,
       2,
       1
      ]
     }
    ]
   }
  },
  {
   "name": "only a carriage return: positions count lines at line feeds only",
   "source": "\r",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       2,
       1,
       2
      ]
     }
    ]
   }
  },
  {
   "name": "only a carriage return and line feed",
   "source": "\r\n",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       2,
       1,
       2,
       1
      ]
     }
    ]
   }
  },
  {
   "name": "the end of input after a line feed",
   "source": "1 +\n",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       2,
       1,
       2,
       1
      ]
     }
    ]
   }
  },
  {
   "name": "the end of input after a carriage return",
   "source": "1 +\r",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       5,
       1,
       5
      ]
     }
    ]
   }
  },
  {
   "name": "the end of input after a carriage return and line feed",
   "source": "1 +\r\n",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       2,
