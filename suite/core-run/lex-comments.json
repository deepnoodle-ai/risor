       3,
       2
      ]
     }
    ]
   }
  },
  {
   "name": "the token after a line comment ended by a carriage return is on the same line",
   "source": "1 // c\r2",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       8,
       1,
       9
      ]
     }
    ]
   }
  },
  {
   "name": "the token after a line comment ended by a line feed is on the next line",
   "source": "1 // c\n2",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       2,
       1,
       2,
       2
      ]
     }
    ]
   }
  },
  {
   "name": "the token after a line comment ended by a carriage return and line feed is on the next line",
   "source": "1 // c\r\n2",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       2,
       1,
       2,
       2
      ]
     }
    ]
   }
  },
  {
   "name": "a tab is one column",
