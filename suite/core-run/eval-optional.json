   "env": "{x: any}",
   "vars": {
    "x": 5
   },
   "expect": {
    "phase": "run",
    "diagnostics": [
     {
      "code": "wrong-kind",
      "span": [
       1,
       1,
       1,
       5
      ],
      "message": "cannot read field a of a value of kind number"
     }
    ],
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "?. on a string is wrong-kind",
   "source": "x?.a",
   "env": "{x: any}",
   "vars": {
    "x": "s"
   },
   "expect": {
    "phase": "run",
    "diagnostics": [
     {
      "code": "wrong-kind",
      "span": [
       1,
       1,
       1,
       5
      ],
      "message": "cannot read field a of a value of kind string"
     }
    ],
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "?.[ ] on a bool is wrong-kind",
   "source": "x?.[0]",
   "env": "{x: any}",
   "vars": {
    "x": true
   },
   "expect": {
    "phase": "run",
    "diagnostics": [
     {
      "code": "wrong-kind",
      "span": [
       1,
       1,
       1,
       7
      ],
      "message": "cannot index a value of kind bool"
     }
    ],
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "?.[ ] with a null index is null-operand",
   "source": "xs?.[i]",
   "env": "{xs: any, i: any}",
   "vars": {
    "xs": [
     1
    ],
    "i": null
   },
   "expect": {
    "phase": "run",
    "diagnostics": [
     {
      "code": "null-operand",
      "span": [
       1,
       1,
       1,
       8
      ],
      "message": "a key or an index is null"
     }
    ],
    "steps": 0,
    "allocated": 0
   }
  },
  {
   "name": "?.[ ] past the end of a long string",
   "source": "s?.[200]",
   "env": "{s: any}",
   "vars": {
    "s": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
   },
   "expect": {
    "value": null,
    "steps": 3,
    "allocated": 0
   }
  },
  {
   "name": "?.[ ] with a long missing key",
   "source": "m?.[k]",
   "env": "{m: any, k: any}",
   "vars": {
    "m": {},
    "k": "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"
   },
   "expect": {
    "value": null,
    "steps": 3,
    "allocated": 0
   }
  }
 ]
}
