{
 "env": "{n: int, s: string, ok: bool, xs: int[], m: {a: int, b: string}, blob: any}",
 "functions": {"rate": "(code: string) => float !", "opt": "(s: string, n?: int) => string", "many": "(a: int, ...rest: int[]) => int", "geo.distance": "(a: string, b: string) => float"},
 "cases": [
  {"name": "a word key written twice", "source": "{x: 1, y: 2, x: 3}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-key", "span": [1, 14, 1, 15]}]}},
  {"name": "a string key equal to an earlier word key", "source": "{a: 1, \"a\": 2}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-key", "span": [1, 8, 1, 11]}]}},
  {"name": "a word key equal to an earlier string key", "source": "{\"a\": 1, a: 2}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-key", "span": [1, 10, 1, 11]}]}},
  {"name": "string keys are compared by their value after escapes", "source": "{\"a\": 1, \"\\u0061\": 2}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-key", "span": [1, 10, 1, 18]}]}},
  {"name": "a single-quoted and a double-quoted key", "source": "{'a': 1, \"a\": 2}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-key", "span": [1, 10, 1, 13]}]}},
  {"name": "a word key equal to an earlier shorthand entry", "source": "{n, n: 2}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-key", "span": [1, 5, 1, 6]}]}},
  {"name": "a shorthand entry equal to an earlier word key", "source": "{n: 1, n}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-key", "span": [1, 8, 1, 9]}]}},
  {"name": "a reserved word as a key written twice", "source": "{if: 1, if: 2}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-key", "span": [1, 9, 1, 11]}]}},
  {"name": "a key written three times gives two diagnostics", "source": "{a: 1, a: 2, a: 3}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-key", "span": [1, 8, 1, 9]}, {"code": "duplicate-key", "span": [1, 14, 1, 15]}]}},
  {"name": "the value of a duplicate entry is walked", "source": "{a: 1, a: nope}", "expect": {"phase": "check", "diagnostics": [{"code": "duplicate-key", "span": [1, 8, 1, 9]}, {"code": "undefined-name", "span": [1, 11, 1, 15]}]}},
  {"name": "a computed key is not compared", "source": "{[\"a\"]: 1, a: 2}", "expect": {"value": {"a": 2}, "steps": 0, "allocated": 3}},
  {"name": "a spread is not compared", "source": "{...m, a: 1}", "vars": {"m": {"a": 0, "b": "x"}}, "expect": {"value": {"a": 1, "b": "x"}, "steps": 2, "allocated": 5}},
  {"name": "the keys of two map literals are not compared", "source": "[{a: 1}, {a: 2}]", "expect": {"value": [{"a": 1}, {"a": 2}], "steps": 0, "allocated": 9}},
  {"name": "a nested map's key is not compared with the outer key", "source": "{a: {a: 1}}", "expect": {"value": {"a": {"a": 1}}, "steps": 0, "allocated": 6}},
  {"name": "keys that differ in case are different", "source": "{a: 1, A: 2}", "expect": {"value": {"a": 1, "A": 2}, "steps": 0, "allocated": 5}}
 ]
}
