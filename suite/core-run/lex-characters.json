  {
   "name": "two minus signs are two tokens",
   "source": "--1",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "two minus signs between operands",
   "source": "1--1",
   "expect": {
    "value": 2
   }
  },
  {
   "name": "three minus signs",
   "source": "---1",
   "expect": {
    "value": -1
   }
  },
  {
   "name": "a minus and a negative operand",
   "source": "1 - -1",
   "expect": {
    "value": 2
   }
  },
  {
   "name": "?. then a word",
   "source": "null?.a",
   "expect": {
    "value": null
   }
  },
  {
   "name": "?.[ is one token",
   "source": "[1]?.[0]",
   "expect": {
    "value": 1
   }
  },
  {
   "name": "?. then a space then [ is two tokens",
   "source": "[1]?. [0]",
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       7,
       1,
       8
      ]
     }
    ]
   }
  },
  {
   "name": "? directly before . is the token ?.",
