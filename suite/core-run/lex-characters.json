   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       5,
       1,
       6
      ]
     }
    ]
   }
  },
  {
   "name": "? then a space then a dot and a digit is a bad number",
