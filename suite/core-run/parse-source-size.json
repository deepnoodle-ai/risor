{
 "cases": [
  {
   "name": "a text of exactly the source limit parses",
   "source": "1 + 2",
   "limits": {
    "source": 5
   },
   "expect": {
    "value": 3
   }
  },
  {
   "name": "a text one code point over the source limit",
   "source": "1 + 23",
   "limits": {
    "source": 5
   },
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "source-too-large"
     }
    ]
   }
  },
  {
   "name": "the size is counted in code points, not in UTF-8 bytes or UTF-16 units",
   "source": "\"é😀\"",
   "limits": {
    "source": 4
   },
   "expect": {
    "value": "é😀"
   }
  },
  {
   "name": "a code point above U+FFFF counts once",
   "source": "\"é😀\"",
   "limits": {
    "source": 3
   },
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "source-too-large"
     }
    ]
   }
  },
  {
   "name": "the size is found before the text is lexed",
   "source": "@@@@@@",
   "limits": {
    "source": 5
   },
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "source-too-large"
     }
    ]
   }
  },
  {
   "name": "an unterminated string over the limit is source-too-large",
   "source": "\"abcdef",
   "limits": {
    "source": 5
   },
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "source-too-large"
     }
    ]
   }
  },
  {
   "name": "a U+FEFF at the start counts",
   "source": "﻿12",
   "limits": {
    "source": 2
   },
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "source-too-large"
     }
    ]
   }
  },
  {
   "name": "a U+FEFF at the start counts, within the limit",
   "source": "﻿12",
   "limits": {
    "source": 3
   },
   "expect": {
    "value": 12
   }
  },
  {
   "name": "each code point of a line end counts",
   "source": "1\r\n+ 2",
   "limits": {
    "source": 6
   },
   "expect": {
    "value": 3
   }
  },
  {
   "name": "each code point of a line end counts, over the limit",
   "source": "1\r\n+ 2",
   "limits": {
    "source": 5
   },
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "source-too-large"
     }
    ]
   }
  },
  {
   "name": "comments count",
   "source": "1 // one",
   "limits": {
    "source": 7
   },
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "source-too-large"
     }
    ]
   }
  },
  {
   "name": "a source limit of 0 refuses every text that is not empty",
   "source": "1",
   "limits": {
    "source": 0
   },
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "source-too-large"
     }
    ]
   }
  },
  {
   "name": "an empty text within a source limit of 0 is unexpected-token",
   "source": "",
   "limits": {
    "source": 0
   },
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "unexpected-token",
      "span": [
       1,
       1,
       1,
       1
      ]
     }
    ]
   }
  },
  {
   "name": "the default source limit admits an ordinary program",
   "source": "const x = 1;\nx + 1",
   "expect": {
    "value": 2
   }
  },
  {
   "name": "the source limit sits beside the other limits",
   "source": "[1, 2, 3].map(x => x * 2)",
   "limits": {
    "source": 25,
    "steps": 3
   },
   "expect": {
    "phase": "run",
    "diagnostics": [
     {
      "code": "steps-exceeded"
     }
    ]
   }
  },
  {
   "name": "the source limit is applied before the static rules",
   "source": "nope + 1",
   "limits": {
    "source": 7
   },
   "expect": {
    "phase": "parse",
    "diagnostics": [
     {
      "code": "source-too-large"
     }
    ]
   }
  }
 ]
}
