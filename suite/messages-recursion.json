          {"name": "S8", "type": "{a: S9, b: S9}"},
          {"name": "S9", "type": "{a: S10, b: S10}"},
          {"name": "S10", "type": "{a: S11, b: S11}"},
          {"name": "S11", "type": "{a: S12, b: S12}"},
          {"name": "S12", "type": "{a: S1, b: S1}"},
          {"name": "T1", "type": "{a: T2, b: T2}"},
