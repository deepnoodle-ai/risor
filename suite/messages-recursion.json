[
  {
    "code": "circular-type",
    "phase": "check",
    "since": "3.0",
    "params": {
      "name": "word"
    },
    "templates": {
      "direct": "{name} refers to itself outside any list, map or record",
      "union": "{name} shares a kind with another type of its union; give the union a type line of its own"
    },
    "when": {
      "direct": "f17-recursion.md 12.2 item 3: a type line on a cycle of names at top places. name is the line's name",
      "union": "f17-recursion.md 12.2 item 6: a reference of the line's component beside another alternative of one of its kinds. name is the reference"
    },
    "cases": [
      {
        "name": "circular-type: direct",
        "source": "type Loop = Loop | null; 1",
        "expect": {
          "phase": "check",
          "diagnostics": [
            {
              "code": "circular-type",
              "span": [
                1,
                6,
                1,
                10
              ],
              "message": "Loop refers to itself outside any list, map or record"
            }
          ]
        }
      },
      {
        "name": "circular-type: union",
        "source": "type Node = {next: Node | {end: bool}}; 1",
        "expect": {
          "phase": "check",
          "diagnostics": [
            {
              "code": "circular-type",
              "span": [
                1,
                6,
                1,
                10
              ],
              "message": "Node shares a kind with another type of its union; give the union a type line of its own"
            }
          ]
        }
      }
    ]
  },
  {
    "code": "check-limit",
    "phase": "check",
    "since": "3.0",
    "params": {
      "name": "word"
    },
    "templates": {
      "pairs": "comparing the types here takes more than 4096 pairs of types"
    },
    "when": {
      "pairs": "f17-recursion.md 12.5: one computation of a fit, a join, an equality or a disjointness enters more than 4096 pairs. The check ends there"
    },
    "cases": [
      {
        "name": "check-limit: pairs",
        "types": [
          {"name": "S1", "type": "{a: S2, b: S2}"},
          {"name": "S2", "type": "{a: S3, b: S3}"},
          {"name": "S3", "type": "{a: S4, b: S4}"},
