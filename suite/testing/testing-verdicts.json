[
{"name": "every field present and equal is a pass", "runner": {"env": "{n: int}", "cases": [{"name": "a", "source": "n * 2", "vars": {"n": 3}, "expect": {"type": "int", "sites": [], "value": 6, "truthy": true, "steps": 1, "allocated": 0}}]}, "expect": {"verdicts": [{"name": "a", "status": "pass"}]}},
{"name": "outcome: a failure where a result is expected", "runner": {"env": "{n: int}", "cases": [{"name": "a", "source": "10 / n", "vars": {"n": 0}, "expect": {"value": 1, "steps": 5}}]}, "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["outcome"]}], "report": "  FAIL a\n    outcome: expected {\"steps\":5,\"value\":1}, found {\"diagnostics\":[{\"class\":\"divide\",\"code\":\"divide-by-zero\",\"message\":\"the divisor of / is zero\",\"span\":[1,1,1,7]}],\"phase\":\"run\"}\n"}},
{"name": "outcome: a result where a failure is expected", "runner": [{"name": "a", "source": "1", "expect": {"phase": "run", "diagnostics": [{"code": "failed"}]}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["outcome"]}], "report": "  FAIL a\n    outcome: expected {\"diagnostics\":[{\"code\":\"failed\"}],\"phase\":\"run\"}, found {\"allocated\":0,\"steps\":0,\"type\":\"int\",\"value\":1}\n"}},
{"name": "outcome: a failure of another phase", "runner": [{"name": "a", "source": "q", "expect": {"phase": "run", "diagnostics": [{"code": "failed"}]}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["outcome"]}], "report": "  FAIL a\n    outcome: expected {\"diagnostics\":[{\"code\":\"failed\"}],\"phase\":\"run\"}, found {\"diagnostics\":[{\"code\":\"undefined-name\",\"message\":\"q is not defined\",\"span\":[1,1,1,2]}],\"phase\":\"check\"}\n"}},
{"name": "type", "runner": [{"name": "a", "source": "1", "expect": {"type": "string"}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["type"]}], "report": "  FAIL a\n    type: expected \"string\", found \"int\"\n"}},
{"name": "sites", "runner": {"env": "{n: int}", "cases": [{"name": "a", "source": "1 / n", "expect": {"sites": []}}]}, "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["sites"]}], "report": "  FAIL a\n    sites: expected [], found [{\"class\":\"divide\",\"span\":[1,1,1,6]}]\n"}},
{"name": "value", "runner": [{"name": "a", "source": "1 + 2", "expect": {"value": 4}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["value"]}], "report": "  FAIL a\n    value: expected 4, found 3\n"}},
{"name": "truthy", "runner": [{"name": "a", "source": "0", "expect": {"truthy": true}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["truthy"]}], "report": "  FAIL a\n    truthy: expected true, found false\n"}},
{"name": "diagnostics", "runner": [{"name": "a", "env": "{d: int}", "vars": {"d": 0}, "source": "1 / d", "expect": {"phase": "run", "diagnostics": [{"code": "divide-by-zero", "span": [1, 1, 1, 5]}]}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["diagnostics"]}], "report": "  FAIL a\n    diagnostics: expected [{\"code\":\"divide-by-zero\",\"span\":[1,1,1,5]}], found [{\"code\":\"divide-by-zero\",\"span\":[1,1,1,6]}]\n"}},
{"name": "steps and allocated, in that order", "runner": [{"name": "a", "source": "[1, 2]", "expect": {"allocated": 9, "steps": 9}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["steps", "allocated"]}], "report": "  FAIL a\n    steps: expected 9, found 0\n    allocated: expected 9, found 3\n"}},
{"name": "several differences in the order of 3.10.8", "runner": [{"name": "a", "source": "[1 + 1]", "expect": {"allocated": 0, "value": [3], "steps": 0, "type": "string[]"}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["type", "value", "steps", "allocated"]}], "report": "  FAIL a\n    type: expected \"string[]\", found \"int[]\"\n    value: expected [3], found [2]\n    steps: expected 0, found 1\n    allocated: expected 0, found 2\n"}},
{"name": "functions: no row matches, whatever expect says", "runner": {"functions": {"rate": {"type": "(code: string) => float !", "calls": [{"args": ["A"], "result": 0.5}]}}, "cases": [{"name": "a", "source": "rate(\"B\")", "expect": {"phase": "run", "diagnostics": [{"code": "function-error"}]}}]}, "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["functions"]}], "report": "  FAIL a\n    functions: no row of rate matches [\"B\"]\n"}},
{"name": "functions: a try does not hide an unmatched call", "runner": {"functions": {"rate": {"type": "(code: string) => float !", "calls": [{"args": ["A"], "result": 0.5}]}}, "cases": [{"name": "a", "source": "try { rate(\"B\") } catch { 0 }", "expect": {"value": 0}}]}, "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["functions"]}], "report": "  FAIL a\n    functions: no row of rate matches [\"B\"]\n"}},
{"name": "functions comes last", "runner": {"functions": {"rate": {"type": "(code: string) => float !", "calls": [{"args": ["A"], "result": 0.5}]}}, "cases": [{"name": "a", "source": "try { rate(\"B\") } catch { 0 }", "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["value", "functions"]}], "report": "  FAIL a\n    value: expected 1, found 0\n    functions: no row of rate matches [\"B\"]\n"}},
{"name": "a matched stub passes", "runner": {"functions": {"rate": {"type": "(code: string) => float !", "calls": [{"args": ["A"], "result": 0.5}]}}, "cases": [{"name": "a", "source": "rate(\"A\") * 2", "expect": {"value": 1, "steps": 2}}]}, "expect": {"verdicts": [{"name": "a", "status": "pass"}]}},
{"name": "class: a checked and an unchecked run; the unchecked class is not compared for six codes", "runner": {"env": "{n: int}", "precondition": false, "cases": [{"name": "a", "source": "n + 1", "vars": {"n": "x"}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "class": "environment"}]}}]}, "expect": {"verdicts": [{"name": "a", "status": "pass"}]}},
{"name": "class: check false states the class of the unchecked run", "runner": {"env": "{n: int}", "precondition": false, "cases": [{"name": "dynamic", "source": "n + 1", "vars": {"n": "x"}, "check": false, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "class": "dynamic"}]}}, {"name": "environment", "source": "n + 1", "vars": {"n": "x"}, "check": false, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "class": "environment"}]}}]}, "expect": {"verdicts": [{"name": "dynamic", "status": "pass"}, {"name": "environment", "status": "fail", "differs": ["diagnostics"]}]}},
{"name": "a case run both ways fails when the checked run fails its check", "runner": [{"name": "both", "source": "\"a\" - 1", "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind"}]}}, {"name": "unchecked", "source": "\"a\" - 1", "check": false, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind"}]}}], "expect": {"verdicts": [{"name": "both", "status": "fail", "differs": ["outcome"]}, {"name": "unchecked", "status": "pass"}]}},
{"name": "skip wins over a wrong expect", "runner": [{"name": "a", "source": "1", "expect": {"value": 2}, "skip": "waits"}], "expect": {"verdicts": [{"name": "a", "status": "skip"}], "report": "  SKIP a: waits\n"}},
{"name": "nothing is merged: a case's vars replace the header's whole", "runner": {"env": "{a: int, b: int}", "vars": {"a": 4, "b": 2}, "cases": [{"name": "replaced", "source": "a", "vars": {"b": 1}, "expect": {"phase": "run", "diagnostics": [{"code": "missing-variable"}]}}, {"name": "inherited", "source": "a / b", "expect": {"value": 2}}, {"name": "wrong", "source": "a / b", "expect": {"value": 3}}]}, "expect": {"verdicts": [{"name": "replaced", "status": "pass"}, {"name": "inherited", "status": "pass"}, {"name": "wrong", "status": "fail", "differs": ["value"]}]}},
{"name": "an empty expect: the program checks and nothing runs", "runner": {"env": "{n: int}", "cases": [{"name": "checked only", "source": "n", "expect": {}}, {"name": "with vars it runs", "source": "n", "vars": {}, "expect": {}}]}, "expect": {"verdicts": [{"name": "checked only", "status": "pass"}, {"name": "with vars it runs", "status": "fail", "differs": ["outcome"]}]}},
{"name": "a field that is absent is not compared", "runner": [{"name": "a", "source": "[1, 2]", "expect": {"value": [1, 2]}}], "expect": {"verdicts": [{"name": "a", "status": "pass"}]}},
{"name": "numbers compare by value and keys in any order", "runner": [{"name": "a", "source": "{b: 2, a: [1.5]}", "expect": {"value": {"a": [1.5], "b": 2.0}}}], "expect": {"verdicts": [{"name": "a", "status": "pass"}]}},
{"name": "a parse failure compares the first diagnostic only", "runner": [{"name": "a", "source": "1 + )", "expect": {"phase": "parse", "diagnostics": [{"code": "unexpected-token", "span": [1, 5, 1, 6]}]}}], "expect": {"verdicts": [{"name": "a", "status": "pass"}]}},
{"name": "a limit failure: the span is not compared", "runner": [{"name": "a", "source": "[1, 2, 3].map(x => x)", "limits": {"steps": 1}, "expect": {"phase": "run", "diagnostics": [{"code": "steps-exceeded", "class": "limit", "span": [9, 9, 9, 9]}]}}], "expect": {"verdicts": [{"name": "a", "status": "pass"}]}},
{"name": "an opaque value compares by identity", "runner": {"opaque": ["Token"], "env": "{t: Token}", "vars": {"t": {"$opaque": {"type": "Token", "id": 1}}}, "cases": [{"name": "same", "source": "t", "expect": {"value": {"$opaque": {"type": "Token", "id": 1}}}}, {"name": "other", "source": "t", "expect": {"value": {"$opaque": {"type": "Token", "id": 2}}}}]}, "expect": {"verdicts": [{"name": "same", "status": "pass"}, {"name": "other", "status": "fail", "differs": ["value"]}]}},
{"name": "a file of each verdict", "runner": {"env": "{n: int}", "cases": [{"name": "pass", "source": "1", "expect": {"value": 1}}, {"name": "fail", "source": "1", "expect": {"value": 2}}, {"name": "skip", "source": "1", "skip": "not yet", "expect": {"value": 1}}, {"name": "invalid", "source": "n", "vars": {"n": "a"}, "expect": {"value": "a"}}]}, "expect": {"verdicts": [{"name": "pass", "status": "pass"}, {"name": "fail", "status": "fail", "differs": ["value"]}, {"name": "skip", "status": "skip"}, {"name": "invalid", "status": "invalid", "fixture": ["vars", "n"], "message": "expected int, found \"a\""}], "report": "  FAIL fail\n    value: expected 2, found 1\n  SKIP skip: not yet\n  INVALID invalid\n    fixture .vars.n: expected int, found \"a\"\n"}},
{"name": "a case with file", "runner": [{"name": "a", "file": "programs/answer.risor", "expect": {"value": 42, "steps": 1}}], "expect": {"verdicts": [{"name": "a", "status": "pass"}]}},
{"name": "spans of a case with file are in that file", "runner": [{"name": "a", "file": "programs/divide.risor", "expect": {"phase": "run", "diagnostics": [{"code": "divide-by-zero", "span": [2, 1, 2, 7]}]}}], "expect": {"verdicts": [{"name": "a", "status": "pass"}]}}
