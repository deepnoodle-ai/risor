[
{"name": "a file whose cases all pass has an empty report", "runner": [{"name": "a", "source": "1", "expect": {"value": 1}}], "expect": {"verdicts": [{"name": "a", "status": "pass"}], "report": ""}},
{"name": "a name is written as visible text", "runner": [{"name": "tab\there", "source": "1", "expect": {"value": 2}}], "expect": {"verdicts": [{"name": "tab\there", "status": "fail", "differs": ["value"]}], "report": "  FAIL tab\\there\n    value: expected 2, found 1\n"}},
{"name": "a skip reason", "runner": [{"name": "a", "source": "1", "expect": {"value": 1}, "skip": "waits for\nthe new table"}], "expect": {"verdicts": [{"name": "a", "status": "skip"}], "report": "  SKIP a: waits for\\nthe new table\n"}},
{"name": "the found diagnostics have the fields the expected ones state", "runner": [{"name": "a", "env": "{d: int}", "vars": {"d": 0}, "source": "1 / d", "expect": {"phase": "run", "diagnostics": [{"code": "divide-by-zero", "class": "value"}]}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["diagnostics"]}], "report": "  FAIL a\n    diagnostics: expected [{\"class\":\"value\",\"code\":\"divide-by-zero\"}], found [{\"class\":\"divide\",\"code\":\"divide-by-zero\"}]\n"}},
{"name": "outcome: found is the whole outcome", "runner": [{"name": "a", "env": "{d: int}", "vars": {"d": 0}, "source": "1 / d", "expect": {"value": 1}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["outcome"]}], "report": "  FAIL a\n    outcome: expected {\"value\":1}, found {\"diagnostics\":[{\"class\":\"divide\",\"code\":\"divide-by-zero\",\"message\":\"the divisor of / is zero\",\"span\":[1,1,1,6]}],\"phase\":\"run\"}\n"}},
{"name": "outcome: a check failure found", "runner": [{"name": "a", "source": "q + 1", "expect": {"value": 1}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["outcome"]}], "report": "  FAIL a\n    outcome: expected {\"value\":1}, found {\"diagnostics\":[{\"code\":\"undefined-name\",\"message\":\"q is not defined\",\"span\":[1,1,1,2]}],\"phase\":\"check\"}\n"}},
{"name": "type is written as a JSON string", "runner": {"env": "{b: bool}", "cases": [{"name": "a", "source": "if (b) { 1 } else { \"x\" }", "expect": {"type": "int"}}]}, "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["type"]}], "report": "  FAIL a\n    type: expected \"int\", found \"int | \\\"x\\\"\"\n"}},
{"name": "a fixture that does not conform", "runner": {"env": "{m: {a: int}}", "cases": [{"name": "a", "source": "m.a", "vars": {"m": {"a": [1]}}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "a", "status": "invalid", "fixture": ["vars", "m", "a"], "message": "expected int, found list"}], "report": "  INVALID a\n    fixture .vars.m.a: expected int, found list\n"}},
{"name": "a stub that may not return an error", "runner": {"functions": {"geo.distance": {"type": "() => float", "calls": [{"error": "far"}]}}, "cases": [{"name": "a", "source": "1", "vars": {}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "a", "status": "invalid", "fixture": ["functions", "geo.distance", "calls", 0, "error"], "message": "the signature has no !, so the stub may not return an error"}], "report": "  INVALID a\n    fixture .functions[\"geo.distance\"].calls[0].error: the signature has no !, so the stub may not return an error\n"}},
{"name": "a value with text", "runner": [{"name": "a", "source": "\"say \\\"hi\\\"\\n\"", "expect": {"value": "x"}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["value"]}], "report": "  FAIL a\n    value: expected \"x\", found \"say \\\"hi\\\"\\n\"\n"}},
{"name": "numbers are written in the rendering of 6.3", "runner": [{"name": "a", "source": "[0.1 + 0.2, 1e21, 2.5e-7]", "expect": {"value": [0.3, 1e+21, 2.5e-07], "steps": 5.0}}], "expect": {"verdicts": [{"name": "a", "status": "fail", "differs": ["value", "steps"]}], "report": "  FAIL a\n    value: expected [0.3,1e+21,2.5e-7], found [0.30000000000000004,1e+21,2.5e-7]\n    steps: expected 5, found 1\n"}},
{"name": "a passing case is not listed, the others are, in file order", "runner": [{"name": "z", "source": "1", "expect": {"value": 0}}, {"name": "a", "source": "1", "expect": {"value": 1}}, {"name": "b", "source": "1", "skip": "later", "expect": {}}], "expect": {"verdicts": [{"name": "z", "status": "fail", "differs": ["value"]}, {"name": "a", "status": "pass"}, {"name": "b", "status": "skip"}], "report": "  FAIL z\n    value: expected 0, found 1\n  SKIP b: later\n"}}
]
