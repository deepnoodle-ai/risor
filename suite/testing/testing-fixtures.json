{"name": "a type variable in the result is read as any", "runner": {"functions": {"f": {"type": "(x: T) => T", "calls": [{"result": "s"}]}}, "cases": [{"name": "c", "source": "f(1)", "expect": {"value": "s"}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "a type variable inside the result is read as any", "runner": {"functions": {"f": {"type": "(x: T) => T[]", "calls": [{"result": 1}]}}, "cases": [{"name": "c", "source": "f(1)", "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["functions", "f", "calls", 0, "result"], "message": "expected any[], found 1"}]}},
{"name": "a stub with error, marked !", "runner": {"functions": {"f": {"type": "() => int !", "calls": [{"error": "no"}]}}, "cases": [{"name": "c", "source": "f()", "expect": {"phase": "run", "diagnostics": [{"code": "function-error", "class": "host", "message": "no"}]}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
