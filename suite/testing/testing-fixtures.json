{"name": "a method's stub result", "runner": {"env": "{t: Token}", "opaque": ["Token"], "methods": {"Token.owner": {"type": "() => string", "calls": [{"args": [{"$opaque": {"type": "Token", "id": 1}}], "result": 5}]}}, "cases": [{"name": "c", "source": "t.owner()", "vars": {"t": {"$opaque": {"type": "Token", "id": 1}}}, "expect": {"value": 5}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["methods", "Token.owner", "calls", 0, "result"], "message": "expected string, found 5"}]}},
