{"name": "a namespaced function's place", "runner": {"functions": {"geo.distance": {"type": "() => float", "calls": [{"result": "far"}]}}, "cases": [{"name": "c", "source": "1", "vars": {}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["functions", "geo.distance", "calls", 0, "result"], "message": "expected float, found \"far\""}]}},
