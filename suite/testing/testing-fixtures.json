{"name": "int: a string is invalid, at the variable", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "n + 1", "vars": {"n": "a"}, "expect": {"value": 2}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "n"], "message": "expected int, found \"a\""}]}},
{"name": "int: a number that is not whole is invalid", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "n + 1", "vars": {"n": 1.5}, "expect": {"value": 2.5}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "n"], "message": "expected int, found 1.5"}]}},
{"name": "int: 3.0 conforms", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "n + 1", "vars": {"n": 3.0}, "expect": {"value": 4}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "int: 2^53 - 1 conforms", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "n", "vars": {"n": 9007199254740991}, "expect": {"value": 9007199254740991}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "int: 2^53 does not conform", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "n", "vars": {"n": 9007199254740992}, "expect": {"value": 9007199254740992}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "n"], "message": "expected int, found 9007199254740992"}]}},
{"name": "int: 1e20 does not conform", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "n", "vars": {"n": 1e+20}, "expect": {"value": 1e+20}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "n"], "message": "expected int, found 100000000000000000000"}]}},
{"name": "float: a whole number conforms", "runner": {"env": "{x: float}", "cases": [{"name": "c", "source": "x / 2", "vars": {"x": 1}, "expect": {"value": 0.5}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "a required field the value lacks", "runner": {"env": "{m: {a: int, b: string}}", "cases": [{"name": "c", "source": "m.b", "vars": {"m": {"b": "x"}}, "expect": {"value": "x"}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "m", "a"], "message": "required field \"a\" is missing"}]}},
{"name": "an exact record refuses another key, the least one", "runner": {"env": "{m: {a: int}}", "cases": [{"name": "c", "source": "m.a", "vars": {"m": {"a": 1, "d": 1, "c": 2}}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "m", "c"], "message": "the type does not allow key \"c\""}]}},
{"name": "absent is not null: an optional field that holds null", "runner": {"env": "{m: {a?: int}}", "cases": [{"name": "c", "source": "m?.a ?? 0", "vars": {"m": {"a": null}}, "expect": {"value": 0}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "m", "a"], "message": "expected int, found null"}]}},
{"name": "an open record accepts another key", "runner": {"env": "{m: {a: int, ...}}", "cases": [{"name": "c", "source": "m.a", "vars": {"m": {"a": 1, "z": [1]}}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "a list stops at its first element that fails", "runner": {"env": "{xs: int[]}", "cases": [{"name": "c", "source": "len(xs)", "vars": {"xs": [1, "x", 2.5]}, "expect": {"value": 3}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "xs", 1], "message": "expected int, found \"x\""}]}},
{"name": "a literal set", "runner": {"env": "{k: \"a\" | \"b\"}", "cases": [{"name": "c", "source": "k", "vars": {"k": "c"}, "expect": {"value": "c"}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "k"], "message": "expected \"a\" | \"b\", found \"c\""}]}},
{"name": "null where the type has null conforms", "runner": {"env": "{m: {a: int} | null}", "cases": [{"name": "c", "source": "m?.a ?? 0", "vars": {"m": null}, "expect": {"value": 0}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "null where the type has no null", "runner": {"env": "{m: {a: int}}", "cases": [{"name": "c", "source": "m", "vars": {"m": null}, "expect": {"value": null}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "m"], "message": "expected {a: int}, found null"}]}},
{"name": "int or null: null conforms", "runner": {"env": "{n: int | null}", "cases": [{"name": "c", "source": "n ?? 1", "vars": {"n": null}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "nothing under any is looked at", "runner": {"env": "{x: any, m: {meta: any}}", "cases": [{"name": "c", "source": "1", "vars": {"x": {"deep": [1, "a", null]}, "m": {"meta": [[{}]]}}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "an opaque value of its declared type conforms", "runner": {"env": "{t: Token}", "opaque": ["Token"], "cases": [{"name": "c", "source": "t == t", "vars": {"t": {"$opaque": {"type": "Token", "id": 1}}}, "expect": {"value": true}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "an opaque value where a string is declared", "runner": {"env": "{s: string}", "opaque": ["Token"], "cases": [{"name": "c", "source": "1", "vars": {"s": {"$opaque": {"type": "Token", "id": 1}}}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "s"], "message": "expected string, found opaque"}]}},
{"name": "variables are tested in code point order of their names", "runner": {"env": "{b: int, a: int, _c: int}", "cases": [{"name": "c", "source": "1", "vars": {"b": "x", "a": "y", "_c": "z"}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "_c"], "message": "expected int, found \"z\""}]}},
{"name": "a declared variable the case does not supply is not tested", "runner": {"env": "{n: int, m: int}", "cases": [{"name": "c", "source": "n", "vars": {"n": 1}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "a named type", "runner": {"env": "{l: Line[]}", "types": [{"name": "Line", "type": "{sku: string, qty: int}"}], "cases": [{"name": "c", "source": "len(l)", "vars": {"l": [{"sku": "a", "qty": "2"}]}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "l", 0, "qty"], "message": "expected int, found \"2\""}]}},
{"name": "a tagged union", "runner": {"env": "{s: Shape}", "types": [{"name": "Shape", "type": "{kind: \"circle\", r: float} | {kind: \"rect\", w: float, h: float}"}], "cases": [{"name": "c", "source": "s.kind", "vars": {"s": {"kind": "oval"}}, "expect": {"value": "oval"}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "s", "kind"], "message": "expected \"circle\" | \"rect\", found \"oval\""}]}},
{"name": "a variable declared by schema", "runner": {"schemas": {"o": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}}, "required": ["id"]}}}, "cases": [{"name": "c", "source": "o.id", "vars": {"o": {"id": 1.5}}, "expect": {"value": 1.5}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "o", "id"], "message": "expected int, found 1.5"}]}},
{"name": "a variable declared by schema with the option closed", "runner": {"schemas": {"o": {"schema": {"type": "object", "properties": {"id": {"type": "integer"}}}, "options": ["closed"]}}, "cases": [{"name": "c", "source": "o?.id ?? 0", "vars": {"o": {"id": 1, "x": 2}}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "o", "x"], "message": "the type does not allow key \"x\""}]}},
{"name": "precondition false turns the test off", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "n + 1", "vars": {"n": "a"}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "class": "environment"}]}, "precondition": false}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "precondition false in the header", "runner": {"env": "{n: int}", "precondition": false, "cases": [{"name": "c", "source": "n + 1", "vars": {"n": "a"}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "class": "environment"}]}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "precondition true is the default", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "n + 1", "vars": {"n": "a"}, "expect": {"value": 2}, "precondition": true}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "n"], "message": "expected int, found \"a\""}]}},
{"name": "a case's precondition true replaces the header's false", "runner": {"env": "{n: int}", "precondition": false, "cases": [{"name": "c", "source": "n", "vars": {"n": "a"}, "precondition": true, "expect": {"value": "a"}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "n"], "message": "expected int, found \"a\""}]}},
{"name": "a check false case is tested too", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "n + 1", "vars": {"n": "a"}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "class": "dynamic"}]}, "check": false}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["vars", "n"], "message": "expected int, found \"a\""}]}},
{"name": "a case that expects a parse failure never runs, and is not tested", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "1 +", "vars": {"n": "a"}, "expect": {"phase": "parse", "diagnostics": [{"code": "unexpected-token", "span": [1, 4, 1, 4]}]}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "a case that fails its check never runs, and is not tested", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "q", "vars": {"n": "a"}, "expect": {"phase": "check", "diagnostics": [{"code": "undefined-name", "span": [1, 1, 1, 2]}]}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "a case that fails its check against what it expects is not tested", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "q", "vars": {"n": "a"}, "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "fail", "differs": ["outcome"]}]}},
{"name": "a skipped case is not tested", "runner": {"env": "{n: int}", "cases": [{"name": "c", "source": "n", "vars": {"n": "a"}, "skip": "later", "expect": {"value": "a"}}]}, "expect": {"verdicts": [{"name": "c", "status": "skip"}]}},
{"name": "a case that is only checked is not tested", "runner": {"functions": {"f": {"type": "() => int", "calls": [{"result": "x"}]}}, "cases": [{"name": "c", "source": "f() + 1", "expect": {"type": "int"}}]}, "expect": {"verdicts": [{"name": "c", "status": "pass"}]}},
{"name": "a stub's result", "runner": {"functions": {"f": {"type": "() => int", "calls": [{"result": "x"}]}}, "cases": [{"name": "c", "source": "f()", "expect": {"value": 1}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["functions", "f", "calls", 0, "result"], "message": "expected int, found \"x\""}]}},
{"name": "every row is tested, also one the run never reaches", "runner": {"functions": {"f": {"type": "(n: int) => int", "calls": [{"args": [1], "result": 10}, {"args": [2], "result": "twenty"}]}}, "cases": [{"name": "c", "source": "f(1)", "expect": {"value": 10}}]}, "expect": {"verdicts": [{"name": "c", "status": "invalid", "fixture": ["functions", "f", "calls", 1, "result"], "message": "expected int, found \"twenty\""}]}},
