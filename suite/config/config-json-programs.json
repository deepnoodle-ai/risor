 {
  "name": "a JSON document checked against a closed schema: the quoted key",
  "source": "{\"listen\": \":8080\", \"backends\": [], \"max_bod\": 1}",
  "returnsSchema": {
   "schema": {
    "type": "object",
    "properties": {
     "listen": {
      "type": "string"
     },
     "max_body": {
      "type": "integer",
      "minimum": 0
     },
     "log": {
      "enum": [
       "debug",
       "info",
       "warn"
      ]
     },
     "backends": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/backend"
      }
     },
     "tls": {
      "type": "object",
      "properties": {
       "cert": {
        "type": "string"
       },
       "key": {
        "type": "string"
       }
      },
      "required": [
       "cert",
       "key"
      ]
     }
    },
    "required": [
     "listen",
     "backends"
    ],
    "$defs": {
     "backend": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "format": "uri"
       }
      },
      "required": [
       "name",
       "url"
      ]
     }
    }
   },
   "options": [
    "closed"
   ]
  },
  "expect": {
   "phase": "check",
   "diagnostics": [
    {
     "code": "result-mismatch",
     "span": [
      1,
      37,
      1,
      46
     ]
    }
   ]
  }
