[
 {
  "name": "a JSON document is a program",
  "source": "{\n  \"name\": \"api\",\n  \"ports\": [80, 443],\n  \"tls\": null,\n  \"debug\": false,\n  \"ratio\": 0.5,\n  \"big\": 1E3,\n  \"neg\": -1,\n  \"esc\": \"\\u00e9\\/\\\"\",\n  \"nested\": {\"a\": [], \"b\": {}}\n}\n",
  "expect": {
   "value": {
    "name": "api",
    "ports": [
     80,
     443
    ],
    "tls": null,
    "debug": false,
    "ratio": 0.5,
    "big": 1000,
    "neg": -1,
    "esc": "é/\"",
    "nested": {
     "a": [],
     "b": {}
    }
   },
   "steps": 1,
   "allocated": 29
  }
 },
 {
  "name": "a key written twice in JSON is duplicate-key",
  "source": "{\"a\": 1, \"a\": 2}",
  "expect": {
   "phase": "check",
   "diagnostics": [
    {
     "code": "duplicate-key",
     "span": [
      1,
      10,
      1,
      13
     ],
     "message": "key \"a\" is written twice in this map"
    }
   ]
  }
 },
 {
  "name": "an integer outside the safe range is literal-range",
  "source": "{\"id\": 12345678901234567890}",
  "expect": {
   "phase": "parse",
   "diagnostics": [
    {
     "code": "literal-range",
     "span": [
      1,
      8,
      1,
      28
     ]
    }
   ]
  }
 },
 {
  "name": "a number that is not finite is literal-range",
  "source": "{\"x\": 1e400}",
  "expect": {
   "phase": "parse",
   "diagnostics": [
    {
     "code": "literal-range",
     "span": [
      1,
      7,
      1,
      12
     ]
    }
   ]
  }
 },
 {
  "name": "an escape of a lone surrogate is bad-escape",
  "source": "{\"s\": \"\\ud800\"}",
  "expect": {
   "phase": "parse",
   "diagnostics": [
    {
     "code": "bad-escape",
     "span": [
      1,
      8,
      1,
      14
     ]
    }
   ]
  }
 },
 {
  "name": "an escaped surrogate pair is one code point",
  "source": "{\"s\": \"\\ud83d\\ude00\"}",
  "expect": {
   "value": {
    "s": "😀"
   }
  }
 },
