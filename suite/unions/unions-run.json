{
  "env": "{s: Shape, ps: Shape | null, shapes: Shape[], blob: any}",
  "types": [{"name": "Shape", "type": "{kind: \"circle\", r: float} | {kind: \"rect\", h: float, w: float}"}],
  "cases": [
    {"name": "a test of the tag, the else branch", "source": "s.kind == \"circle\" ? s.r * 2 : s.w * s.h", "vars": {"s": {"kind": "rect", "w": 2, "h": 3}}, "expect": {"value": 6, "steps": 5, "allocated": 0}},
    {"name": "a test of the tag, the then branch", "source": "s.kind == \"circle\" ? s.r * 2 : s.w * s.h", "vars": {"s": {"kind": "circle", "r": 1.5}}, "expect": {"value": 3, "steps": 4, "allocated": 0}},
    {"name": "match on the tag, the second arm", "source": "match s.kind { \"circle\" => s.r, \"rect\" => s.w * s.h }", "vars": {"s": {"kind": "rect", "w": 2, "h": 3}}, "expect": {"value": 6, "steps": 6, "allocated": 0}},
    {"name": "match on the tag, the first arm", "source": "match s.kind { \"circle\" => s.r, \"rect\" => s.w * s.h }", "vars": {"s": {"kind": "circle", "r": 2}}, "expect": {"value": 2, "steps": 3, "allocated": 0}},
    {"name": "match on the tag with _", "source": "match s.kind { \"circle\" => s.r, _ => s.h }", "vars": {"s": {"kind": "rect", "w": 2, "h": 3}}, "expect": {"value": 3, "steps": 4, "allocated": 0}},
    {"name": "if with !=", "source": "if (s.kind != \"rect\") { s.r } else { s.h }", "vars": {"s": {"kind": "rect", "w": 2, "h": 3}}, "expect": {"value": 3, "steps": 3, "allocated": 0}},
    {"name": "?. on null beside a union", "source": "ps?.kind == \"rect\" ? ps.w : 0", "vars": {"ps": null}, "expect": {"value": 0, "steps": 1, "allocated": 0}},
    {"name": "?. on a union", "source": "ps?.kind == \"rect\" ? ps.w : 0", "vars": {"ps": {"kind": "rect", "w": 2, "h": 3}}, "expect": {"value": 2, "steps": 3, "allocated": 0}},
    {"name": "filter by the tag, then read the variant's field", "source": "shapes.filter(x => x.kind == \"circle\").map(c => c.r)", "vars": {"shapes": [{"kind": "circle", "r": 1}, {"kind": "rect", "w": 1, "h": 1}, {"kind": "circle", "r": 2}]}, "expect": {"value": [1, 2], "steps": 22, "allocated": 6}},
    {"name": "map with a test of the tag", "source": "shapes.map(x => x.kind == \"circle\" ? x.r : x.w)", "vars": {"shapes": [{"kind": "circle", "r": 1}, {"kind": "rect", "w": 1, "h": 1}, {"kind": "circle", "r": 2}]}, "expect": {"value": [1, 1, 2], "steps": 17, "allocated": 4}},
    {"name": "a spread of a union", "source": "{...s, id: 1}", "vars": {"s": {"kind": "circle", "r": 1}}, "expect": {"value": {"kind": "circle", "r": 1, "id": 1}, "steps": 2, "allocated": 7}},
    {"name": "a pattern with a default", "source": "const {kind, r = 0} = s; r", "vars": {"s": {"kind": "rect", "w": 2, "h": 3}}, "expect": {"value": 0, "steps": 2, "allocated": 0}},
    {"name": "?. and ?? on a field of one variant", "source": "s?.r ?? -1", "vars": {"s": {"kind": "rect", "w": 2, "h": 3}}, "expect": {"value": -1, "steps": 2, "allocated": 0}},
    {"name": "&& after a test of the tag", "source": "s.kind == \"circle\" && s.r > 1", "vars": {"s": {"kind": "circle", "r": 2}}, "expect": {"value": true, "steps": 4, "allocated": 0}},
    {"name": "as: a value that conforms", "source": "blob as Shape", "vars": {"blob": {"kind": "rect", "w": 2, "h": 3}}, "expect": {"value": {"kind": "rect", "w": 2, "h": 3}, "steps": 4, "allocated": 0}},
    {"name": "as: a value that fails in its variant", "source": "blob as Shape", "vars": {"blob": {"kind": "rect", "w": 2}}, "expect": {"phase": "run", "diagnostics": [{"code": "not-conforming", "span": [1, 1, 1, 14], "path": ["h"], "message": "required field \"h\" is missing", "class": "value"}], "steps": 3, "allocated": 0}},
    {"name": "as: a tag in no tag set", "source": "blob as Shape", "vars": {"blob": {"kind": "oval"}}, "expect": {"phase": "run", "diagnostics": [{"code": "not-conforming", "span": [1, 1, 1, 14], "path": ["kind"], "message": "expected \"circle\" | \"rect\", found \"oval\"", "class": "value"}], "steps": 2, "allocated": 0}},
    {"name": "as: a value that is not a map", "source": "blob as Shape", "vars": {"blob": "circle"}, "expect": {"phase": "run", "diagnostics": [{"code": "not-conforming", "span": [1, 1, 1, 14], "path": [], "message": "expected {kind: \"circle\", r: float} | {h: float, kind: \"rect\", w: float}, found \"circle\"", "class": "value"}], "steps": 1, "allocated": 0}},
    {"name": "is: a tag in no tag set", "source": "blob is Shape", "vars": {"blob": {"kind": "oval"}}, "expect": {"value": false, "steps": 2, "allocated": 0}},
    {"name": "is: a circle", "source": "blob is Shape", "vars": {"blob": {"kind": "circle", "r": 0}}, "expect": {"value": true, "steps": 3, "allocated": 0}},
    {"name": "is: null beside a union", "source": "blob is Shape | null", "vars": {"blob": null}, "expect": {"value": true, "steps": 1, "allocated": 0}},
    {"name": "try: the path of the failure", "source": "try { blob as Shape } catch (err) { err.path }", "vars": {"blob": {"kind": "oval"}}, "expect": {"value": ["kind"], "steps": 4, "allocated": 12}},
    {"name": "try: the message of the failure", "source": "try { blob as Shape } catch (err) { err.message }", "vars": {"blob": {"kind": "oval"}}, "expect": {"value": "expected \"circle\" | \"rect\", found \"oval\"", "steps": 4, "allocated": 12}},
    {"name": "as, then a read", "source": "(blob as Shape).kind", "vars": {"blob": {"kind": "rect", "w": 2, "h": 3}}, "expect": {"value": "rect", "steps": 5, "allocated": 0}},
    {"name": "as: a list of a union", "source": "blob as Shape[]", "vars": {"blob": [{"kind": "circle", "r": 1}, {"kind": "rect", "w": 2, "h": 3}]}, "expect": {"value": [{"kind": "circle", "r": 1}, {"kind": "rect", "w": 2, "h": 3}], "steps": 8, "allocated": 0}},
    {"name": "as: a list of a union passes the depth limit", "source": "blob as Shape[]", "vars": {"blob": [{"kind": "circle", "r": 1}]}, "limits": {"depth": 1}, "expect": {"phase": "run", "diagnostics": [{"code": "depth-exceeded", "class": "limit"}]}},
    {"name": "as: a list of a union within the depth limit", "source": "blob as Shape[]", "vars": {"blob": [{"kind": "circle", "r": 1}]}, "limits": {"depth": 2}, "expect": {"value": [{"kind": "circle", "r": 1}], "steps": 4, "allocated": 0}},
    {"name": "as: an open variant does not visit other keys", "source": "blob as {kind: \"a\", ...} | {kind: \"b\", x: int}", "vars": {"blob": {"kind": "a", "z": [1, 2]}}, "expect": {"value": {"kind": "a", "z": [1, 2]}, "steps": 2, "allocated": 0}},
    {"name": "as: a subject that surely fits, and a value that breaks its type", "source": "s as Shape", "vars": {"s": {"kind": "oval"}}, "precondition": false, "expect": {"phase": "run", "diagnostics": [{"code": "not-conforming", "span": [1, 1, 1, 11], "path": ["kind"], "message": "expected \"circle\" | \"rect\", found \"oval\"", "class": "environment"}], "steps": 2, "allocated": 0}},
    {"name": "a narrowed read of a value that breaks its type", "source": "s.kind == \"circle\" ? s.r : 0", "vars": {"s": {"kind": "circle"}}, "precondition": false, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 22, 1, 25], "class": "environment"}], "steps": 3, "allocated": 0}},
    {"name": "unchecked: a field of one variant read with .", "source": "s.r", "vars": {"s": {"kind": "rect", "w": 2, "h": 3}}, "check": false, "expect": {"phase": "run", "diagnostics": [{"code": "missing-field", "span": [1, 1, 1, 4], "class": "dynamic"}], "steps": 1, "allocated": 0}}
  ]
}
