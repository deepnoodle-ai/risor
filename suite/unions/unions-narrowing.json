    {"name": "!= on a field typed string in one variant", "source": "w.note != \"x\" ? w : null", "expect": {"type": "{kind: \"a\", note: string} | null", "sites": []}},
    {"name": "an open variant: the other variant", "source": "o.kind == \"b\" ? o.x : 0", "expect": {"type": "int", "sites": []}},
    {"name": "an open variant: its unlisted key", "source": "o.kind == \"a\" ? o.zz : 0", "expect": {"type": "any", "sites": [{"class": "dynamic", "span": [1, 17, 1, 18]}]}},
    {"name": "a path through a field", "source": "cfg.shape.kind == \"circle\" ? cfg.shape.r : 0", "expect": {"type": "float", "sites": []}},
    {"name": "a fact about a path does not change the record it is read from", "source": "if (cfg.shape.kind == \"circle\") { const {shape} = cfg; shape.r } else { 0 }", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 62, 1, 63]}]}},
    {"name": "?. beside null: the then branch", "source": "ps?.kind == \"circle\" ? ps.r : 0", "expect": {"type": "float", "sites": []}},
