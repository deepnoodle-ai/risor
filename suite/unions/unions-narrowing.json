    {"name": "a never-equal test gives no fact", "source": "s.kind == \"tri\" ? s.r : 0", "expect": {"phase": "check", "diagnostics": [{"code": "never-equal", "span": [1, 1, 1, 16]}, {"code": "maybe-absent", "span": [1, 21, 1, 22]}]}},
    {"name": "the then branch has the circle variant only", "source": "s.kind == \"circle\" ? s.w : 0", "expect": {"phase": "check", "diagnostics": [{"code": "no-field", "span": [1, 24, 1, 25]}]}},
    {"name": "the then branch of != has the rect variant only", "source": "s.kind != \"circle\" ? s.r : 0", "expect": {"phase": "check", "diagnostics": [{"code": "no-field", "span": [1, 24, 1, 25]}]}},
    {"name": "the narrowed type of the path", "source": "s.kind == \"circle\" ? s : null", "expect": {"type": "{kind: \"circle\", r: float} | null", "sites": []}},
