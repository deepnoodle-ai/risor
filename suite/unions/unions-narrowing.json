    {"name": "match: _ after one string of a tag set", "source": "match t.kind { \"a\" => 0, _ => t.x }", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 33, 1, 34]}]}},
    {"name": "match on three variants", "source": "match u.kind { \"a\" => u.x, \"b\" => u.y, \"c\" => 0 }", "expect": {"type": "int", "sites": []}},
    {"name": "match on the tag of three variants", "source": "match m3.k { \"1\" => 1, \"2\" => 2, \"3\" => 3 }", "expect": {"type": "int", "sites": []}},
    {"name": "||: the two variants form a union", "source": "u.kind == \"a\" || u.kind == \"b\" ? u : null", "expect": {"type": "{kind: \"a\", x: int} | {kind: \"b\", y: int} | null", "sites": []}},
    {"name": "||: the failing side", "source": "u.kind == \"a\" || u.kind == \"b\" ? 0 : u", "expect": {"type": "int | {kind: \"c\"}", "sites": []}},
    {"name": "&& of two !=", "source": "u.kind != \"a\" && u.kind != \"b\" ? u : null", "expect": {"type": "{kind: \"c\"} | null", "sites": []}},
    {"name": "!", "source": "!(u.kind == \"c\") ? u : null", "expect": {"type": "{kind: \"a\", x: int} | {kind: \"b\", y: int} | null", "sites": []}},
    {"name": "||: the right side has the other variants", "source": "u.kind == \"a\" || u.x > 0", "expect": {"phase": "check", "diagnostics": [{"code": "no-field", "span": [1, 20, 1, 21]}]}},
    {"name": "an if chain", "source": "if (u.kind == \"a\") { u.x } else if (u.kind == \"b\") { u.y } else { 0 }", "expect": {"type": "int", "sites": []}},
