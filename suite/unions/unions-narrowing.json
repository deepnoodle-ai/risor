    {"name": "match: a later arm has the other variant only", "source": "match s.kind { \"circle\" => s.r, \"rect\" => s.r }", "expect": {"phase": "check", "diagnostics": [{"code": "no-field", "span": [1, 45, 1, 46]}]}},
    {"name": "match: an arm of every string narrows nothing", "source": "match s.kind { \"circle\" | \"rect\" => s.r }", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 39, 1, 40]}]}},
