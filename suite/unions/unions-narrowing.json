    {"name": "no fact: the tag copied to a name", "source": "const kk = s.kind; kk == \"circle\" ? s.r : 0", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 39, 1, 40]}]}},
    {"name": "no fact: a name in place of the literal", "source": "s.kind == k ? s.r : 0", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 17, 1, 18]}]}},
    {"name": "no fact: a key tested with in", "source": "\"r\" in s ? s.r : 0", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 14, 1, 15]}]}},
