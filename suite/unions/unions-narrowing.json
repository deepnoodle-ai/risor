    {"name": "before a test: a computed key", "source": "s[ks]", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 3, 1, 5]}]}},
    {"name": "before a test: ?.[] with a computed key", "source": "s?.[ks]", "expect": {"type": "float | \"circle\" | \"rect\" | null", "sites": []}},
    {"name": "== narrows both ways", "source": "s.kind == \"circle\" ? s.r : s.w * s.h", "expect": {"type": "float", "sites": []}},
