    {"name": "if branches that are narrowed join flat", "source": "if (s.kind == \"circle\") { s } else { s }", "expect": {"type": "{h?: float, kind: \"circle\" | \"rect\", r?: float, w?: float}", "sites": []}},
    {"name": "a narrowed path inside a lambda", "source": "s.kind == \"circle\" ? [1, 2].map(x => x * s.r) : []", "expect": {"type": "float[]", "sites": []}},
    {"name": "&& after a test", "source": "s.kind == \"circle\" && s.r > 1", "expect": {"type": "bool", "sites": []}},
