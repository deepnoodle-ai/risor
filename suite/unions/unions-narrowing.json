{
  "env": "{s: Shape, ps: Shape | null, shapes: Shape[], t: {kind: \"a\" | \"b\", x: int} | {kind: \"c\"}, u: {kind: \"a\", x: int} | {kind: \"b\", y: int} | {kind: \"c\"}, cfg: {name: string, shape: Shape}, o: {kind: \"a\", ...} | {kind: \"b\", x: int}, n: {kind: \"a\", unit: \"m\" | \"s\"} | {kind: \"b\", unit: \"kg\"}, w: {kind: \"a\", note: string} | {kind: \"b\", note: \"x\"}, m3: {a: \"x\", k: \"1\"} | {a: \"x\", k: \"2\"} | {a: \"y\", k: \"3\"}, r: {kind: \"a\", x: int} | null, k: \"circle\", ks: string, blob: any}",
  "types": [{"name": "Shape", "type": "{kind: \"circle\", r: float} | {kind: \"rect\", h: float, w: float}"}],
  "cases": [
    {"name": "before a test: the tag reads as the union of the tag sets", "source": "s.kind", "expect": {"type": "\"circle\" | \"rect\"", "sites": []}},
    {"name": "before a test: a field of one variant is maybe-absent", "source": "s.r", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 3, 1, 4]}]}},
    {"name": "before a test: ?. on a field of one variant", "source": "s?.r", "expect": {"type": "float | null", "sites": []}},
    {"name": "before a test: a field of no variant is no-field", "source": "s.color", "expect": {"phase": "check", "diagnostics": [{"code": "no-field", "span": [1, 3, 1, 8]}]}},
    {"name": "before a test: an unlisted key with an open variant", "source": "o.zz", "expect": {"type": "any", "sites": [{"class": "dynamic", "span": [1, 1, 1, 2]}]}},
