{
  "env": "{u: {kind: \"a\", x: int} | {kind: \"b\", y: int} | {kind: \"c\"}, us: ({kind: \"a\", x: int} | {kind: \"b\", y: int} | {kind: \"c\"})[], t: {kind: \"a\" | \"b\", x: int} | {kind: \"c\"}, s: Shape, ps: Shape | null, ks: (\"a\" | \"b\")[], more: string[], k1: \"a\"}",
  "types": [{"name": "Shape", "type": "{kind: \"circle\", r: float} | {kind: \"rect\", h: float, w: float}"}],
  "cases": [
    {"name": "in: one literal", "source": "u.kind in [\"a\"] ? u.x : 0", "expect": {"type": "int", "sites": []}},
    {"name": "in: two literals, the passing side", "source": "u.kind in [\"a\", \"b\"] ? u : null", "expect": {"type": "{kind: \"a\", x: int} | {kind: \"b\", y: int} | null", "sites": []}},
    {"name": "in: two literals, the failing side", "source": "u.kind in [\"a\", \"b\"] ? 0 : u", "expect": {"type": "int | {kind: \"c\"}", "sites": []}},
    {"name": "in and || of == give one type", "source": "u.kind == \"a\" || u.kind == \"b\" ? u : null", "expect": {"type": "{kind: \"a\", x: int} | {kind: \"b\", y: int} | null", "sites": []}},
    {"name": "in: every literal, the passing side", "source": "u.kind in [\"a\", \"b\", \"c\"] ? u : null", "expect": {"type": "{kind: \"a\", x: int} | {kind: \"b\", y: int} | {kind: \"c\"} | null", "sites": []}},
    {"name": "in: every literal, the failing side is never", "source": "u.kind in [\"a\", \"b\", \"c\"] ? 0 : u", "expect": {"type": "int", "sites": []}},
    {"name": "not in: two literals", "source": "u.kind not in [\"a\", \"b\"] ? u : null", "expect": {"type": "{kind: \"c\"} | null", "sites": []}},
    {"name": "not in: the failing side", "source": "u.kind not in [\"a\"] ? 0 : u.x", "expect": {"type": "int", "sites": []}},
    {"name": "not in: every literal", "source": "u.kind not in [\"a\", \"b\", \"c\"] ? u : null", "expect": {"type": "null", "sites": []}},
    {"name": "in: a literal no variant has is never-equal", "source": "u.kind in [\"d\"]", "expect": {"phase": "check", "diagnostics": [{"code": "never-equal", "span": [1, 1, 1, 16]}]}},
    {"name": "in: a literal no variant has gives no fact", "source": "u.kind in [\"d\"] ? u.x : 0", "expect": {"phase": "check", "diagnostics": [{"code": "never-equal", "span": [1, 1, 1, 16]}, {"code": "maybe-absent", "span": [1, 21, 1, 22]}]}},
    {"name": "in: one literal no variant has beside one it has", "source": "u.kind in [\"a\", \"d\"] ? u.x : 0", "expect": {"type": "int", "sites": []}},
    {"name": "in: a right side that is not a list literal gives no fact", "source": "u.kind in ks ? u.x : 0", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 18, 1, 19]}]}},
    {"name": "in: a list with a spread gives no fact", "source": "u.kind in [\"a\", ...more] ? u.x : 0", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 30, 1, 31]}]}},
    {"name": "in: an item that is not a string literal gives no fact", "source": "u.kind in [\"a\", k1] ? u.x : 0", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 25, 1, 26]}]}},
    {"name": "in: the empty list gives no fact", "source": "u.kind in [] ? u.x : 0", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 18, 1, 19]}]}},
    {"name": "in under &&", "source": "u.kind in [\"a\", \"b\"] && u.kind != \"a\" ? u : null", "expect": {"type": "{kind: \"b\", y: int} | null", "sites": []}},
    {"name": "in under ||", "source": "u.kind in [\"a\"] || u.kind in [\"b\"] ? u : null", "expect": {"type": "{kind: \"a\", x: int} | {kind: \"b\", y: int} | null", "sites": []}},
    {"name": "not in under ||: the right side sees the left side's failing facts", "source": "u.kind not in [\"a\"] || u.kind not in [\"b\"] ? 0 : u", "expect": {"phase": "check", "diagnostics": [{"code": "never-equal", "span": [1, 24, 1, 43]}]}},
    {"name": "not in under ||: the failing side", "source": "u.kind not in [\"a\", \"b\"] || u.kind not in [\"a\"] ? 0 : u", "expect": {"type": "int | {kind: \"a\", x: int}", "sites": []}},
    {"name": "in: a tag set of two strings, one of them", "source": "t.kind in [\"a\"] ? t.x : 0", "expect": {"type": "int", "sites": []}},
    {"name": "in: a tag set of two strings, no false fact for one", "source": "t.kind in [\"a\"] ? 0 : t.x", "expect": {"phase": "check", "diagnostics": [{"code": "maybe-absent", "span": [1, 25, 1, 26]}]}},
    {"name": "in: a whole tag set of two strings, the failing side", "source": "t.kind in [\"a\", \"b\"] ? 0 : t", "expect": {"type": "int | {kind: \"c\"}", "sites": []}},
    {"name": "in on Shape", "source": "s.kind in [\"circle\"] ? s.r : s.w", "expect": {"type": "float", "sites": []}},
    {"name": "in with ?. beside null", "source": "ps?.kind in [\"circle\"] ? ps.r : 0", "expect": {"type": "float", "sites": []}},
    {"name": "not in with ?. beside null: the failing side", "source": "ps?.kind not in [\"circle\"] ? 0 : ps.r", "expect": {"type": "float", "sites": []}},
    {"name": "in in filter", "source": "us.filter(x => x.kind in [\"a\", \"c\"])", "expect": {"type": "({kind: \"a\", x: int} | {kind: \"c\"})[]", "sites": []}},
    {"name": "not in in find", "source": "us.find(x => x.kind not in [\"a\", \"b\"])", "expect": {"type": "{kind: \"c\"} | null", "sites": []}},
    {"name": "in: a run", "source": "u.kind in [\"a\", \"b\"] ? 1 : 2", "vars": {"u": {"kind": "b", "y": 1}}, "expect": {"value": 1, "steps": 3, "allocated": 3}},
    {"name": "not in: a run", "source": "u.kind not in [\"a\", \"b\"] ? 1 : 2", "vars": {"u": {"kind": "c"}}, "expect": {"value": 1, "steps": 3, "allocated": 3}}
  ]
}
