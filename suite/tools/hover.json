{
 "env": "{user: {name: string, age: int, tags: string[]}, items: {id: string, qty: int}[]}",
 "cases": [
  {
   "name": "a variable",
   "hover": "us‸er.name",
   "expect": {
    "hover": {
     "kind": "variable",
     "span": [
      1,
      1,
      1,
      5
     ],
     "type": "{age: int, name: string, tags: string[]}",
     "signature": null,
     "doc": null,
     "declaration": null
    }
   }
  },
  {
   "name": "a field",
   "hover": "user.‸name",
   "expect": {
    "hover": {
     "kind": "field",
     "span": [
      1,
      6,
      1,
      10
     ],
     "type": "string",
     "signature": null,
     "doc": null,
     "declaration": null
    }
   }
  },
  {
   "name": "a library function",
   "hover": "‸len(user.tags)",
   "expect": {
    "hover": {
     "kind": "function",
     "span": [
      1,
      1,
      1,
      4
     ],
     "type": "int",
     "signature": "(x: string | any[] | map<any>) => int",
     "doc": "The number of code points of a string, elements of a list or entries of a map.",
     "declaration": null
    }
   }
  },
  {
   "name": "a library method",
   "hover": "user.name.‸toUpperCase()",
