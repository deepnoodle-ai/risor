     "signature": "() => string",
     "doc": "Each code point replaced by its upper-case mapping in the case table.",
     "declaration": null
    }
   }
  },
  {
   "name": "a method whose call is not closed",
   "hover": "user.tags.‸first(",
   "expect": {
    "hover": {
     "kind": "method",
     "span": [
      1,
      11,
      1,
      16
     ],
