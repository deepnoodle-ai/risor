   }
  },
  {
   "name": "a const name and its declaration",
   "hover": "const n = 1;\n‸n + 1",
   "expect": {
    "hover": {
     "kind": "name",
     "span": [
      2,
      1,
      2,
      2
     ],
     "type": "int",
     "signature": null,
     "doc": null,
     "declaration": [
      1,
      7,
      1,
      8
     ]
    }
   }
  },
  {
   "name": "the place a name is bound",
   "hover": "const ‸total = 1;\ntotal",
   "expect": {
    "hover": {
     "kind": "name",
     "span": [
      1,
      7,
      1,
      12
     ],
     "type": "int",
     "signature": null,
     "doc": null,
     "declaration": [
      1,
      7,
      1,
      12
     ]
    }
   }
  },
  {
   "name": "a parameter",
   "hover": "items.map(i => ‸i.qty)",
   "expect": {
    "hover": {
     "kind": "name",
     "span": [
      1,
      16,
      1,
      17
     ],
     "type": "{id: string, qty: int}",
     "signature": null,
     "doc": null,
     "declaration": [
      1,
      11,
      1,
      12
     ]
    }
   }
  },
  {
   "name": "a name of a pattern of a parameter",
   "hover": "items.map(({qty}) => ‸qty)",
   "expect": {
    "hover": {
     "kind": "name",
     "span": [
      1,
      22,
      1,
      25
     ],
     "type": "int",
     "signature": null,
     "doc": null,
     "declaration": [
      1,
      13,
      1,
      16
     ]
    }
   }
  },
  {
   "name": "a const-bound lambda",
   "hover": "const double = x => x * 2;\n‸double(2)",
   "expect": {
    "hover": {
     "kind": "lambda",
     "span": [
      2,
      1,
      2,
      7
     ],
     "signature": null,
     "doc": null,
     "declaration": [
      1,
      7,
      1,
      13
     ]
    }
   }
  },
  {
   "name": "a text that does not parse is cut after the word",
