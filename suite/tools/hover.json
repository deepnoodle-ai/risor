   "expect": {
    "hover": {
     "kind": "field",
     "span": [
      1,
      6,
      1,
      10
     ],
     "type": "string",
     "signature": null,
     "doc": null,
     "declaration": null
    }
   }
  },
  {
   "name": "a keyword has no hover",
   "hover": "‸if (true) { 1 } else { 2 }",
   "expect": {
    "hover": null
   }
  },
  {
   "name": "a literal has no hover",
   "hover": "‸1 + 2",
   "expect": {
    "hover": null
   }
  },
  {
   "name": "white space has no hover",
   "hover": "user ‸ == null",
   "expect": {
    "hover": null
   }
  },
  {
   "name": "a comment has no hover",
   "hover": "user // ‸note",
   "expect": {
    "hover": null
   }
  }
 ]
}