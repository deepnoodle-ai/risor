 {
  "name": "a pair for the reader is written when the text inside it stays within 100 levels",
  "format": "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!(a * b / c)",
  "expect": {
   "formatted": "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!((a *\n  b) /\n  c)\n"
  }
 },
 {
  "name": "a pair for the reader is not written when a token inside it would open level 101",
  "format": "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!(a * b / c)",
  "expect": {
   "formatted": "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!(a *\n  b /\n  c)\n"
  }
 },
 {
  "name": "a chained comparison does not parse",
  "format": "a == b == c",
  "expect": {
   "phase": "parse",
   "diagnostics": [
    {
     "code": "chained-comparison",
     "span": [
      1,
      8,
      1,
      10
     ]
    }
   ]
  }
 },
 {
  "name": "a comparison on the right of a comparison keeps its parentheses",
  "format": "a == (b < c)",
  "expect": {
   "formatted": "a == (b < c)\n"
  }
 },
 {
  "name": "a comparison as the left operand of as needs none: as is not a comparison",
  "format": "a < b as bool",
  "expect": {
   "formatted": "a < b as bool\n"
  }
 },
 {
  "name": "is binds tighter than ==: a == b is bool is a == (b is bool), and needs no pair",
  "format": "a == b is bool",
  "expect": {
   "formatted": "a == b is bool\n"
  }
 },
 {
  "name": "an as on the right of a comparison, over a comparison, keeps its pair",
  "format": "x == (a < b as bool)",
  "expect": {
   "formatted": "x == (a < b as bool)\n"
  }
 },
 {
  "name": "an as on the left of a comparison, over a comparison, needs no pair: the as ends the comparison",
  "format": "(a < b as bool) == x",
  "expect": {
   "formatted": "a < b as bool == x\n"
  }
 },
 {
  "name": "a comparison on the right of ==, holding an is, keeps its pair: x == (a == (b is bool))",
  "format": "x == (a == b is bool)",
  "expect": {
   "formatted": "x == (a == b is bool)\n"
  }
 },
 {
  "name": "an is over a comparison of level 5 on the right of ==: the pair goes around the ==",
  "format": "x == ((a == b) is bool)",
  "expect": {
   "formatted": "x == (a == b) is bool\n"
  }
 }
]
