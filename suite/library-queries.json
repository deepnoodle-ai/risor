      {"name": "maxBy with mixed keys on any data", "source": "xs.maxBy(x => x)", "env": "{xs: any}", "vars": {"xs": [1, "a"]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 17], "class": "dynamic", "message": "maxBy needs all numbers or all strings, found string"}], "steps": 6, "allocated": 0}}
    ]
