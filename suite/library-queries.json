[
  {
    "name": "sortBy",
    "extends": "list.sortBy",
    "receiver": "T[]",
    "signature": "(f: (item: T, index: int) => K, order?: \"asc\" | \"desc\") => T[] where K: ordered",
    "group": "core",
    "since": "3.0",
    "exact": true,
    "doc": "The elements in order of their keys, by a stable sort, ascending or in the direction order gives.",
    "calls": [
      "f"
    ],
    "steps": "2*n + L*(n + sz(keys))",
    "units": "1 + n",
    "null": null,
    "fails": [
      {
        "when": "the keys are not all numbers or all strings",
        "kind": "kind",
        "code": "wrong-kind",
        "template": "unordered"
      },
      {
        "when": "order is not \"asc\" or \"desc\"",
        "kind": "kind",
        "code": "wrong-kind",
        "template": "order"
      }
    ],
    "wrong": [
      "sort_by",
      "orderBy",
      "toSorted",
      "sortOn",
      "sortByDescending"
    ],
    "cases": [
      {"name": "sortBy with \"desc\" keeps the order of equal keys", "source": "xs.sortBy(s => len(s), \"desc\")", "env": "{xs: string[]}", "vars": {"xs": ["bb", "a", "cc", "d"]}, "expect": {"value": ["bb", "cc", "a", "d"], "steps": 22, "allocated": 5}},
      {"name": "sortBy with \"asc\" is the Core sort", "source": "xs.sortBy(s => len(s), \"asc\")", "env": "{xs: string[]}", "vars": {"xs": ["bb", "a", "cc", "d"]}, "expect": {"value": ["a", "d", "bb", "cc"], "steps": 22, "allocated": 5}},
      {"name": "sortBy \"desc\" is not sortBy then reverse", "source": "[{n: \"a\", k: 1}, {n: \"b\", k: 2}, {n: \"c\", k: 1}].sortBy(p => p.k, \"desc\").map(p => p.n)", "expect": {"value": ["b", "a", "c"]}},
      {"name": "sortBy \"desc\" orders strings by code point", "source": "[\"\\u{ffff}\", \"😀\"].sortBy(s => s, \"desc\")", "expect": {"value": ["😀", "￿"]}},
      {"name": "sortBy \"desc\" of an empty list", "source": "xs.sortBy(x => x, \"desc\")", "env": "{xs: int[]}", "vars": {"xs": []}, "expect": {"value": [], "steps": 2, "allocated": 1}},
      {"name": "sortBy \"desc\" with a null key on any data", "source": "xs.sortBy(x => x, \"desc\")", "env": "{xs: any}", "vars": {"xs": [1, null]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 26], "class": "dynamic", "message": "sortBy needs all numbers or all strings, found null"}], "steps": 6, "allocated": 0}},
      {"name": "sortBy with a direction that is not asc or desc", "source": "xs.sortBy(x => x, d)", "env": "{xs: int[], d: any}", "vars": {"xs": [2, 1], "d": "up"}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 21], "class": "dynamic", "message": "sortBy takes \"asc\" or \"desc\", found \"up\""}], "steps": 1, "allocated": 0}},
      {"name": "sortBy \"desc\" stops at a callback that fails", "source": "[1, 0].sortBy(x => 10 / x, \"desc\")", "expect": {"phase": "run", "diagnostics": [{"code": "divide-by-zero", "span": [1, 20, 1, 26], "class": "divide"}]}}
    ]
  },
  {
    "name": "minBy",
    "receiver": "T[]",
    "signature": "(f: (item: T, index: int) => K) => T | null where K: ordered",
    "group": "core",
    "since": "3.0",
    "exact": true,
    "doc": "The element whose key is the least; of equal keys, the first.",
    "calls": [
      "f"
    ],
    "steps": "2*n + sz(keys)",
    "units": "0",
    "null": "the list is empty",
    "fails": [
      {
        "when": "the keys are not all numbers or all strings",
        "kind": "kind",
        "code": "wrong-kind",
        "template": "unordered"
      }
    ],
    "wrong": [
      "min_by",
      "minOf",
      "minimumBy",
      "minByOrNull"
    ],
    "cases": [
      {"name": "minBy a field", "source": "xs.minBy(p => p.a)", "env": "{xs: {a: int, n: string}[]}", "vars": {"xs": [{"n": "b", "a": 2}, {"n": "a", "a": 1}, {"n": "c", "a": 1}]}, "expect": {"value": {"a": 1, "n": "a"}, "steps": 11, "allocated": 0}},
      {"name": "minBy of an empty list", "source": "xs.minBy(x => x)", "env": "{xs: int[]}", "vars": {"xs": []}, "expect": {"value": null, "steps": 2, "allocated": 0}},
      {"name": "minBy with a null key on any data", "source": "xs.minBy(x => x)", "env": "{xs: any}", "vars": {"xs": [1, null]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 17], "class": "dynamic", "message": "minBy needs all numbers or all strings, found null"}], "steps": 6, "allocated": 0}},
      {"name": "minBy takes the first of equal keys", "source": "[{n: \"x\", a: 1}, {n: \"y\", a: 1.0}].minBy(p => p.a).n", "expect": {"value": "x"}}
    ]
  },
  {
