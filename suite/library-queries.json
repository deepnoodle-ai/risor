  {
    "name": "uniqueBy",
    "receiver": "T[]",
    "signature": "(f: (item: T, index: int) => K) => T[] where K: ordered",
    "group": "core",
    "since": "3.0",
    "exact": true,
    "doc": "The first element with each key, in order.",
    "calls": [
      "f"
    ],
    "steps": "2*n + sz(keys)",
    "units": "1 + k",
    "null": null,
    "fails": [
      {
        "when": "the keys are not all numbers or all strings",
        "kind": "kind",
        "code": "wrong-kind",
        "template": "unordered"
      }
    ],
    "wrong": [
      "unique_by",
      "distinctBy",
      "uniqBy"
    ],
    "cases": [
      {"name": "uniqueBy keeps the first element of each key", "source": "xs.uniqueBy(s => len(s))", "env": "{xs: string[]}", "vars": {"xs": ["bb", "a", "cc", "d"]}, "expect": {"value": ["bb", "a"], "steps": 14, "allocated": 3}},
      {"name": "uniqueBy with mixed keys on any data", "source": "xs.uniqueBy(x => x)", "env": "{xs: any}", "vars": {"xs": [1, "1"]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 20], "class": "dynamic", "message": "uniqueBy needs all numbers or all strings, found string"}], "steps": 6, "allocated": 0}},
      {"name": "uniqueBy: 1 and 1.0 are one key", "source": "[1, 1.0, 2].uniqueBy(x => x)", "expect": {"value": [1, 2]}},
      {"name": "uniqueBy of an empty list", "source": "xs.uniqueBy(x => x)", "env": "{xs: int[]}", "vars": {"xs": []}, "expect": {"value": [], "steps": 2, "allocated": 1}}
    ]
  },
  {
    "name": "indexBy",
    "receiver": "T[]",
    "signature": "(f: (item: T, index: int) => string) => map<T>",
    "group": "core",
    "since": "3.0",
    "exact": true,
    "doc": "Each element under its key; a later element replaces an earlier one.",
    "calls": [
      "f"
    ],
    "steps": "2*n + sz(keys)",
    "units": "1 + 2*n",
    "null": null,
    "fails": [
      {
        "when": "a result of f is not a string",
        "kind": "kind",
        "code": "wrong-kind",
        "template": "result"
      }
    ],
    "wrong": [
      "keyBy",
      "associateBy",
      "index_by"
    ],
    "cases": [
      {"name": "indexBy keeps the last element of each key", "source": "xs.indexBy(u => u.id)", "env": "{xs: {id: string, v: int}[]}", "vars": {"xs": [{"id": "a", "v": 1}, {"id": "b", "v": 2}, {"id": "a", "v": 3}]}, "expect": {"value": {"a": {"id": "a", "v": 3}, "b": {"id": "b", "v": 2}}, "steps": 11, "allocated": 7}},
      {"name": "indexBy with a key that is not a string", "source": "xs.indexBy(x => x)", "env": "{xs: any}", "vars": {"xs": [1]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 19], "class": "dynamic", "message": "the callback of indexBy gave a value of kind number, which it cannot take"}], "steps": 4, "allocated": 0}},
      {"name": "indexBy of an empty list", "source": "xs.indexBy(x => x)", "env": "{xs: string[]}", "vars": {"xs": []}, "expect": {"value": {}, "steps": 2, "allocated": 1}}
    ]
  },
  {
    "name": "countBy",
    "receiver": "T[]",
    "signature": "(f: (item: T, index: int) => string) => map<int>",
    "group": "core",
    "since": "3.0",
    "exact": true,
    "doc": "For each distinct key, how many elements have it.",
    "calls": [
      "f"
    ],
    "steps": "2*n + sz(keys)",
    "units": "1 + 2*g",
    "null": null,
    "fails": [
      {
        "when": "a result of f is not a string",
        "kind": "kind",
        "code": "wrong-kind",
        "template": "result"
      }
    ],
    "wrong": [
      "count_by",
      "groupingBy",
      "tally"
    ],
    "cases": [
      {"name": "countBy counts each key", "source": "xs.countBy(x => x)", "env": "{xs: string[]}", "vars": {"xs": ["b", "a", "b"]}, "expect": {"value": {"a": 1, "b": 2}, "steps": 8, "allocated": 5}},
      {"name": "countBy of an empty list", "source": "xs.countBy(x => x)", "env": "{xs: string[]}", "vars": {"xs": []}, "expect": {"value": {}, "steps": 2, "allocated": 1}},
      {"name": "countBy with a null key on any data", "source": "xs.countBy(x => x)", "env": "{xs: any}", "vars": {"xs": ["a", null]}, "expect": {"phase": "run", "diagnostics": [{"code": "wrong-kind", "span": [1, 1, 1, 19], "class": "dynamic", "message": "the callback of countBy gave a value of kind null, which it cannot take"}], "steps": 6, "allocated": 0}}
    ]
  },
  {
    "name": "mapValues",
    "receiver": "map<T>",
    "signature": "(f: (value: T, key: string) => U) => map<U>",
    "group": "core",
    "since": "3.0",
    "exact": true,
    "doc": "The map with the same keys and f of each value, called in key order.",
    "calls": [
      "f"
    ],
    "steps": "2*n + L*(n + sz(keys))",
    "units": "1 + 2*n",
    "null": null,
    "fails": [],
    "wrong": [
      "map_values",
      "mapObject",
      "transformValues",
      "with_entries"
    ],
    "cases": [
      {"name": "mapValues of each value, in key order", "source": "m.mapValues(v => v * 2)", "env": "{m: map<int>}", "vars": {"m": {"b": 1, "a": 2, "c": 3}}, "expect": {"value": {"a": 4, "b": 2, "c": 6}, "steps": 17, "allocated": 7}},
      {"name": "mapValues passes the key second", "source": "{b: 1, a: 2}.mapValues((v, k) => k + string(v))", "expect": {"value": {"a": "a2", "b": "b1"}, "steps": 12, "allocated": 14}},
      {"name": "mapValues of an empty map", "source": "m.mapValues(v => v)", "env": "{m: map<int>}", "vars": {"m": {}}, "expect": {"value": {}, "steps": 2, "allocated": 1}}
    ]
  }
]
