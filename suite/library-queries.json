    "exact": true,
    "doc": "The element whose key is the greatest; of equal keys, the first.",
    "calls": [
      "f"
    ],
    "steps": "2*n + sz(keys)",
    "units": "0",
    "null": "the list is empty",
    "fails": [
      {
        "when": "the keys are not all numbers or all strings",
        "kind": "kind",
        "code": "wrong-kind",
        "template": "unordered"
      }
    ],
    "wrong": [
      "max_by",
      "maxOf",
      "maximumBy",
      "maxByOrNull"
    ],
    "cases": [
      {"name": "maxBy a field", "source": "xs.maxBy(p => p.a)", "env": "{xs: {a: int, n: string}[]}", "vars": {"xs": [{"n": "b", "a": 2}, {"n": "a", "a": 1}, {"n": "c", "a": 1}]}, "expect": {"value": {"a": 2, "n": "b"}, "steps": 11, "allocated": 0}},
      {"name": "maxBy takes the first of equal keys", "source": "[{n: \"x\", a: 2}, {n: \"y\", a: 2}].maxBy(p => p.a).n", "expect": {"value": "x"}},
