{
  "name": "risor-web",
  "private": true,
  "description": "The npm packages for Risor in the browser. See docs/design/web-packages.md.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "../ts",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @deepnoodle/risor -w @deepnoodle/risor-service -w @deepnoodle/risor-codemirror -w @deepnoodle/risor-react -w @deepnoodle/risor-mantine --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @deepnoodle/risor-service -w @deepnoodle/risor-codemirror -w @deepnoodle/risor-react -w @deepnoodle/risor-mantine --if-present",
    "e2e": "playwright test -c examples/react-vite/playwright.config.ts",
    "size": "node scripts/size.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3"
  }
}
