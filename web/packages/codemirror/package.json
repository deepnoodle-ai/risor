{
  "name": "@deepnoodle/risor-codemirror",
  "version": "3.0.0-alpha.1",
  "description": "Risor for CodeMirror 6: colours, errors as you type, completion, hover and format",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepnoodle-ai/risor.git",
    "directory": "web/packages/codemirror"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "risor-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=risor-source --test --test-reporter=spec \"test/**/*.test.ts\"",
    "prepack": "cp ../../../LICENSE LICENSE"
  },
  "dependencies": {
    "@deepnoodle/risor-service": "3.0.0-alpha.1",
    "@deepnoodle/risor": "3.0.0-alpha.1"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  }
}
