{
  "name": "@deepnoodle/risor-mantine",
  "version": "0.0.0",
  "description": "Mantine components for Risor: a checked expression input and a result preview",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepnoodle-ai/risor.git",
    "directory": "web/packages/mantine"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "risor-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "TSX_TSCONFIG_PATH=../../tsconfig.base.json node --conditions=risor-source --import tsx --test --test-reporter=spec \"test/**/*.test.tsx\"",
    "prepack": "cp ../../../LICENSE LICENSE"
  },
  "dependencies": {
    "@deepnoodle/risor-codemirror": "0.0.0",
    "@deepnoodle/risor-react": "0.0.0"
  },
  "peerDependencies": {
    "@mantine/core": ">=7.17",
    "react": ">=18"
  },
  "devDependencies": {
    "@mantine/core": "7.17.8",
    "@mantine/hooks": "7.17.8",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  }
}
